# 复制到 VPS 的 /etc/ymllblog-admin.env，权限必须为 600。
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH='scrypt$N=32768,r=8,p=1$替换为脚本生成的盐$替换为脚本生成的摘要'
SESSION_SECRET=替换为至少32字节的随机字符串
SESSION_TTL_SECONDS=43200
GITHUB_REPOSITORY=yanmengli123/ymllblog
GITHUB_BRANCH=main
GITHUB_TOKEN=替换为仅有该仓库Contents读写权限的fine-grained-token
