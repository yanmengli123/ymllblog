---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section id="profile-card" class="sidebar-glass sidebar-widget overflow-hidden text-center">
  <div class="relative mx-auto mb-4 h-24 w-24">
    <img
      id="avatar-img"
      src="https://api.dicebear.com/7.x/adventurer/svg?seed=YMLL"
      alt="YMLL avatar"
      class="h-24 w-24 rounded-full border-4 border-white object-cover shadow-xl"
    />
    <span class="absolute bottom-1 right-1 h-4 w-4 rounded-full border-2 border-white bg-emerald-500"></span>
  </div>

  <h2 id="avatar-name" class="mb-1 text-lg font-bold text-stone-900">YMLL</h2>
  <p id="avatar-bio" class="mb-4 text-sm leading-relaxed text-stone-500">都是风景，幸会</p>

  <div class="mb-4 grid grid-cols-3 gap-2 rounded-xl bg-white/70 p-2 text-center">
    <a href={`${base}/blog`} class="rounded-lg p-2 transition hover:bg-indigo-50">
      <span class="block text-base font-bold text-indigo-600">文</span>
      <span class="text-[11px] text-stone-500">文章</span>
    </a>
    <a href={`${base}/tags`} class="rounded-lg p-2 transition hover:bg-cyan-50">
      <span class="block text-base font-bold text-cyan-600">签</span>
      <span class="text-[11px] text-stone-500">标签</span>
    </a>
    <a href={`${base}/about`} class="rounded-lg p-2 transition hover:bg-emerald-50">
      <span class="block text-base font-bold text-emerald-600">我</span>
      <span class="text-[11px] text-stone-500">关于</span>
    </a>
  </div>

  <div class="flex justify-center gap-3">
    <a href="https://github.com/yanmengli123" target="_blank" rel="noreferrer" class="profile-link">GitHub</a>
    <a href={`${base}/rss.xml`} class="profile-link">RSS</a>
  </div>
</section>

<script>
  (function() {
    const card = document.getElementById('profile-card');
    if (!card) return;

    try {
      const settings = JSON.parse(localStorage.getItem('ymll_user_settings') || '{}');
      if (settings.showAvatar === false) {
        card.style.display = 'none';
      }
      if (settings.customAvatar) {
        const img = document.getElementById('avatar-img') as HTMLImageElement | null;
        if (img) img.src = settings.customAvatar;
      }
      if (settings.customGreeting) {
        const bio = document.getElementById('avatar-bio');
        if (bio) bio.textContent = settings.customGreeting;
      }
    } catch {}

    (window as any).avatarWidget = {
      show() { card.style.display = ''; },
      hide() { card.style.display = 'none'; },
      setAvatar(url: string) {
        const img = document.getElementById('avatar-img') as HTMLImageElement | null;
        if (img) img.src = url;
      },
      setName(name: string) {
        const el = document.getElementById('avatar-name');
        if (el) el.textContent = name;
      },
      setBio(bio: string) {
        const el = document.getElementById('avatar-bio');
        if (el) el.textContent = bio;
      },
    };
  })();
</script>

<style>
  .profile-link {
    border-radius: 999px;
    border: 1px solid rgba(99, 102, 241, 0.18);
    color: #4f46e5;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.35rem 0.7rem;
    transition: all 0.2s ease;
  }

  .profile-link:hover {
    background: rgba(99, 102, 241, 0.08);
    transform: translateY(-1px);
  }
</style>
