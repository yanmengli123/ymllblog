---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const navItems = [
  { label: '首页', href: `${base}/`, icon: 'home' },
  { label: '归档', href: `${base}/archive`, icon: 'archive' },
  { label: '标签', href: `${base}/tags`, icon: 'tag' },
  { label: '关于', href: `${base}/about`, icon: 'user' },
];

const currentPath = Astro.url.pathname;
---

<header id="header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-500">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href={`${base}/`} class="flex items-center gap-3 group shrink-0">
        <div class="w-10 h-10 rounded-xl flex items-center justify-center shadow-lg group-hover:scale-110 transition-all"
             style="background: linear-gradient(135deg, var(--gradient-start), var(--gradient-end));">
          <span class="text-white font-bold text-lg">Y</span>
        </div>
        <span id="header-title" class="hidden sm:block text-lg font-semibold text-white group-hover:text-white/80 transition-colors">
          YMLL<span style="color: var(--primary)">.</span>blog
        </span>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center gap-1">
        {navItems.map(item => (
          <a
            href={item.href}
            class:list={[
              'px-4 py-2 text-sm font-medium rounded-lg transition-all duration-200',
              (currentPath === item.href || (item.href !== `${base}/` && currentPath.startsWith(item.href)))
                ? 'text-white bg-white/20'
                : 'text-white/80 hover:text-white hover:bg-white/10'
            ]}
            id={`nav-${item.label}`}
          >
            {item.label}
          </a>
        ))}
      </div>

      <!-- 工具栏 -->
      <div class="flex items-center gap-1">
        <button id="search-btn" class="p-2.5 rounded-lg text-white/80 hover:bg-white/10 transition-all" aria-label="搜索">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </button>

        <button id="theme-toggle" class="p-2.5 rounded-lg text-white/80 hover:bg-white/10 transition-all" aria-label="主题">
          <svg class="w-5 h-5 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <svg class="w-5 h-5 block dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9.001 9.001 0 018.646 3.646 9.003 9.003 0 0012 21a9.001 9.001 0 008.354-5.646z" />
          </svg>
        </button>

        <button id="mobile-menu-toggle" class="md:hidden p-2.5 rounded-lg text-white/80 hover:bg-white/10 transition-all" aria-label="菜单">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile menu -->
    <div id="mobile-menu" class="hidden md:hidden pb-4">
      <div class="glass-card p-3 space-y-1">
        {navItems.map(item => (
          <a
            href={item.href}
            class="block px-4 py-3 rounded-lg text-sm font-medium text-stone-700 dark:text-stone-200 hover:bg-stone-100/80 dark:hover:bg-stone-800/80 transition-colors"
          >
            {item.label}
          </a>
        ))}
      </div>
    </div>
  </nav>
</header>

<script>
  // Header scroll effect - dlog.com.cn style (transparent -> solid)
  const header = document.getElementById('header');
  const headerTitle = document.getElementById('header-title');

  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      // 滚动后：白色背景 + 深色文字
      header?.classList.add('bg-white/95', 'backdrop-blur-md', 'shadow-lg');
      header?.classList.remove('bg-transparent');
      if (headerTitle) {
        headerTitle.classList.remove('text-white');
        headerTitle.classList.add('text-stone-800');
      }
      // 更新导航链接颜色
      document.querySelectorAll('[id^="nav-"]').forEach(el => {
        el.classList.remove('text-white/80', 'hover:text-white', 'hover:bg-white/10', 'text-white', 'bg-white/20');
        el.classList.add('text-stone-600', 'hover:text-stone-900', 'hover:bg-stone-100/80');
      });
      // 更新工具栏按钮颜色
      document.querySelectorAll('#search-btn, #theme-toggle, #mobile-menu-toggle').forEach(btn => {
        btn.classList.remove('text-white/80', 'hover:bg-white/10');
        btn.classList.add('text-stone-600', 'hover:bg-stone-100/80');
      });
    } else {
      // 顶部：透明背景 + 白色文字
      header?.classList.remove('bg-white/95', 'backdrop-blur-md', 'shadow-lg');
      header?.classList.add('bg-transparent');
      if (headerTitle) {
        headerTitle.classList.add('text-white');
        headerTitle.classList.remove('text-stone-800');
      }
      // 恢复导航链接颜色
      document.querySelectorAll('[id^="nav-"]').forEach(el => {
        el.classList.add('text-white/80', 'hover:text-white', 'hover:bg-white/10');
        el.classList.remove('text-stone-600', 'hover:text-stone-900', 'hover:bg-stone-100/80');
      });
      // 恢复工具栏按钮颜色
      document.querySelectorAll('#search-btn, #theme-toggle, #mobile-menu-toggle').forEach(btn => {
        btn.classList.add('text-white/80', 'hover:bg-white/10');
        btn.classList.remove('text-stone-600', 'hover:bg-stone-100/80');
      });
    }
  });

  // Mobile menu
  const mobileBtn = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  mobileBtn?.addEventListener('click', () => mobileMenu?.classList.toggle('hidden'));
</script>
