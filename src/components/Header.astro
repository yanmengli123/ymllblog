---
const base = import.meta.env.BASE_URL;

const navItems = [
  { label: '首页', href: base },
  { label: '博客', href: `${base}blog` },
  { label: '标签', href: `${base}tags` },
  { label: '归档', href: `${base}archive` },
  { label: '关于', href: `${base}about` },
];

const currentPath = Astro.url.pathname;

function isActive(href: string) {
  const cleanHref = href.replace(/\/$/, '') || '/';
  const cleanPath = currentPath.replace(/\/$/, '') || '/';
  if (cleanHref === base.replace(/\/$/, '') || cleanHref === '/') {
    return cleanPath === base.replace(/\/$/, '') || cleanPath === '/';
  }
  return cleanPath.startsWith(cleanHref);
}
---

<header id="header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-500">
  <nav class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      <!-- Logo -->
      <a href={base} class="flex items-center gap-3 group">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-emerald-500 to-teal-600 flex items-center justify-center shadow-lg shadow-emerald-500/25 group-hover:shadow-emerald-500/40 transition-all duration-300 group-hover:scale-105">
          <span class="text-white font-bold text-lg">Y</span>
        </div>
        <span class="text-xl font-semibold text-stone-800 group-hover:text-emerald-600 transition-colors">
          YMLL<span class="text-emerald-500">.</span>blog
        </span>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center gap-1">
        {navItems.map(item => (
          <a
            href={item.href}
            class:list={[
              'relative px-4 py-2 text-sm font-medium rounded-lg transition-all duration-200',
              isActive(item.href)
                ? 'text-emerald-600 bg-emerald-50'
                : 'text-stone-600 hover:text-stone-900 hover:bg-stone-100/80'
            ]}
          >
            {item.label}
            {isActive(item.href) && (
              <span class="absolute bottom-0 left-1/2 -translate-x-1/2 w-4 h-0.5 bg-emerald-500 rounded-full" />
            )}
          </a>
        ))}
      </div>

      <!-- Right actions -->
      <div class="flex items-center gap-2">
        <!-- Theme toggle -->
        <button
          id="theme-toggle"
          class="p-2.5 rounded-lg text-stone-500 hover:text-stone-700 hover:bg-stone-100 transition-all"
          aria-label="切换主题"
        >
          <svg class="w-5 h-5 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <svg class="w-5 h-5 block dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
        </button>

        <!-- RSS -->
        <a
          href={`${base}rss.xml`}
          class="p-2.5 rounded-lg text-stone-500 hover:text-stone-700 hover:bg-stone-100 transition-all"
          aria-label="RSS"
          target="_blank"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
            <path d="M5 3a2 2 0 00-2 2v2a2 2 0 002 2h2a2 2 0 002-2V5a2 2 0 00-2-2H5zM5 11a2 2 0 00-2 2v2a2 2 0 002 2h2a2 2 0 002-2v-2a2 2 0 00-2-2H5zM11 5a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V5zM14 11a1 1 0 011 1v1h1a1 1 0 110 2h-1v1a1 1 0 11-2 0v-1h-1a1 1 0 110-2h1v-1a1 1 0 011-1z" />
          </svg>
        </a>

        <!-- Mobile menu button -->
        <button
          id="mobile-menu-toggle"
          class="md:hidden p-2.5 rounded-lg text-stone-500 hover:text-stone-700 hover:bg-stone-100 transition-all"
          aria-label="菜单"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile menu -->
    <div id="mobile-menu" class="hidden md:hidden pb-4">
      <div class="glass rounded-2xl p-4 space-y-1">
        {navItems.map(item => (
          <a
            href={item.href}
            class:list={[
              'block px-4 py-3 rounded-xl text-sm font-medium transition-all',
              isActive(item.href)
                ? 'text-emerald-600 bg-emerald-50'
                : 'text-stone-600 hover:text-stone-900 hover:bg-stone-50'
            ]}
          >
            {item.label}
          </a>
        ))}
      </div>
    </div>
  </nav>
</header>

<script>
  // Header scroll effect
  const header = document.getElementById('header');
  let lastScroll = 0;

  window.addEventListener('scroll', () => {
    const currentScroll = window.scrollY;

    if (currentScroll > 50) {
      header?.classList.add('glass', 'shadow-sm');
    } else {
      header?.classList.remove('glass', 'shadow-sm');
    }

    lastScroll = currentScroll;
  });

  // Theme toggle
  const themeToggle = document.getElementById('theme-toggle');
  themeToggle?.addEventListener('click', () => {
    document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', document.documentElement.classList.contains('dark') ? 'dark' : 'light');
  });

  // Mobile menu
  const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  let menuOpen = false;

  mobileMenuToggle?.addEventListener('click', () => {
    menuOpen = !menuOpen;
    mobileMenu?.classList.toggle('hidden');
  });
</script>
