---
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const [posts, projects, research] = await Promise.all([
  getCollection('blog', ({ data }) => !data.draft),
  getCollection('projects'),
  getCollection('research'),
]);
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const navItems = [
  { label: '文章', href: `${base}/blog` },
  { label: '标签', href: `${base}/tags` },
  { label: '归档', href: `${base}/archive` },
  { label: '关于', href: `${base}/about` },
];
const isActive = (href: string) => currentPath === href || currentPath.startsWith(`${href}/`);
const searchIndex = posts.map((post) => ({
  title: post.data.title,
  description: post.data.description,
  tags: post.data.tags,
  url: `${base}/blog/${post.id}`,
  kind: '文章',
}));
const commandIndex = [
  { title: '浏览全部文章', description: '进入按时间排列的公开文章列表', tags: ['文章', 'blog'], url: `${base}/blog`, kind: '导航' },
  { title: '探索主题花园', description: '按主题标签浏览知识网络', tags: ['标签', '主题'], url: `${base}/tags`, kind: '导航' },
  { title: '查看年度归档', description: '沿着时间查看内容积累', tags: ['归档', 'timeline'], url: `${base}/archive`, kind: '导航' },
  { title: '随机漫游一篇笔记', description: '让花园选择一条意外的阅读路径', tags: ['随机', 'random'], url: searchIndex[0]?.url ?? `${base}/blog`, kind: '命令', action: 'random' },
  ...projects.map((project) => ({ title: project.data.title, description: project.data.summary, tags: project.data.technologies, url: project.data.relatedPost ? `${base}/blog/${project.data.relatedPost}` : project.data.repository || `${base}/`, kind: '项目' })),
  ...research.filter((entry) => entry.data.relatedPost).map((entry) => ({ title: entry.data.title, description: entry.data.topic, tags: [entry.data.topic, entry.data.status], url: `${base}/blog/${entry.data.relatedPost}`, kind: '研究' })),
];
---

<header id="site-header" data-site-header data-condensed="false" class="fixed inset-x-0 top-0 z-50 border-b backdrop-blur-xl" style="border-color: var(--line); background: color-mix(in srgb, var(--paper) 88%, transparent);">
  <nav class="site-nav site-shell flex items-center justify-between" aria-label="主导航">
    <a href={`${base}/`} class="group flex items-center gap-3" aria-label="YMLL Blog 首页">
      <span class="logo-mark grid h-10 w-10 place-items-center rounded-full border text-sm font-bold" style="border-color: var(--ink); color: var(--ink);">YL</span>
      <span class="hidden sm:block">
        <span class="block font-display text-base font-bold leading-none">YMLL</span>
        <span class="mt-1 block text-[10px] uppercase tracking-[0.24em]" style="color: var(--muted);">Digital Garden</span>
      </span>
    </a>

    <div class="hidden items-center gap-1 md:flex">
      {navItems.map((item) => (
        <a
          href={item.href}
          data-nav-link
          data-active={isActive(item.href) ? 'true' : 'false'}
          class="nav-link relative rounded-full px-4 py-2 text-sm font-medium"
          style={isActive(item.href) ? 'color: var(--brand-deep);' : 'color: var(--muted);'}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {isActive(item.href) && <span class="nav-active-indicator" aria-hidden="true"></span>}
          <span class="relative z-10">{item.label}</span>
        </a>
      ))}
    </div>

    <div class="flex items-center gap-1">
      <button id="search-btn" class="motion-control grid h-10 w-10 place-items-center rounded-full hover:bg-black/5 dark:hover:bg-white/10" aria-label="搜索，快捷键 Ctrl K">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="m21 21-4.35-4.35m2.35-5.65a8 8 0 1 1-16 0 8 8 0 0 1 16 0Z" /></svg>
      </button>
      <button id="theme-toggle" class="motion-control grid h-10 w-10 place-items-center rounded-full hover:bg-black/5 dark:hover:bg-white/10" aria-label="切换明暗主题">
        <span class="dark:hidden" aria-hidden="true">◐</span><span class="hidden dark:inline" aria-hidden="true">◑</span>
      </button>
      <button id="mobile-menu-toggle" class="grid h-10 w-10 place-items-center rounded-full md:hidden" aria-label="打开导航" aria-expanded="false" aria-controls="mobile-menu">☰</button>
    </div>
  </nav>
  <div id="mobile-menu" class="site-shell hidden pb-5 md:hidden">
    <div class="grid grid-cols-2 gap-2 rounded-2xl border p-2" style="border-color: var(--line); background: var(--surface);">
      {navItems.map((item) => <a href={item.href} data-mobile-nav-link class="rounded-xl px-4 py-3 text-center text-sm font-medium hover:bg-black/5 dark:hover:bg-white/10">{item.label}</a>)}
    </div>
  </div>
</header>

<div id="search-modal" class="fixed inset-0 z-[90] hidden items-start justify-center bg-black/45 px-4 pt-24 backdrop-blur-sm" role="dialog" aria-modal="true" aria-labelledby="search-modal-title">
  <div class="w-full max-w-2xl rounded-3xl border p-4 shadow-2xl" style="border-color: var(--line); background: var(--surface-strong);">
    <div class="flex items-center gap-3">
      <h2 id="search-modal-title" class="sr-only">站内搜索</h2>
      <span class="pl-2 text-lg" aria-hidden="true">⌘</span>
      <input id="site-search-input" type="search" autocomplete="off" placeholder="搜索文章、项目，或输入命令" class="min-w-0 flex-1 rounded-2xl border bg-transparent px-4 py-3 text-sm outline-none" style="border-color: var(--line);" />
      <button id="search-close" class="rounded-xl px-3 py-2 text-sm" style="color: var(--muted);" aria-label="关闭搜索">关闭</button>
    </div>
    <div id="search-results" class="mt-4 max-h-[60vh] space-y-2 overflow-y-auto" role="listbox" aria-label="命令与搜索结果"></div>
    <div class="command-hints mt-3 flex items-center gap-4 px-2 text-[10px]" style="color: var(--muted);"><span><kbd>↑↓</kbd> 选择</span><span><kbd>Enter</kbd> 打开</span><span><kbd>Esc</kbd> 关闭</span></div>
  </div>
</div>

<script is:inline define:vars={{ searchIndex, commandIndex }}>
  const mobileBtn = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  mobileBtn?.addEventListener('click', () => {
    const open = mobileMenu?.classList.contains('hidden');
    mobileMenu?.classList.toggle('hidden');
    mobileBtn.setAttribute('aria-expanded', String(Boolean(open)));
  });
  document.querySelectorAll('[data-mobile-nav-link]').forEach((link) => link.addEventListener('click', () => mobileMenu?.classList.add('hidden')));

  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const dark = !document.documentElement.classList.contains('dark');
    document.documentElement.classList.toggle('dark', dark);
    localStorage.setItem('theme', dark ? 'dark' : 'light');
  });

  const modal = document.getElementById('search-modal');
  const searchInput = document.getElementById('site-search-input');
  const results = document.getElementById('search-results');
  let activeResult = 0;
  function selectResult(index) {
    const links = [...(results?.querySelectorAll('[data-command-result]') || [])];
    if (!links.length) return;
    activeResult = (index + links.length) % links.length;
    links.forEach((link, current) => {
      link.dataset.selected = String(current === activeResult);
      link.setAttribute('aria-selected', String(current === activeResult));
    });
    links[activeResult]?.scrollIntoView({ block: 'nearest' });
  }
  function render(items) {
    if (!results) return;
    results.replaceChildren();
    if (!items.length) {
      const empty = document.createElement('p');
      empty.className = 'rounded-2xl p-4 text-sm';
      empty.textContent = '没有找到匹配内容';
      results.appendChild(empty);
      return;
    }
    items.slice(0, 9).forEach((post, index) => {
      const link = document.createElement('a');
      link.href = post.url;
      link.className = 'search-result-link flex items-start gap-4 rounded-2xl border border-black/10 p-4 hover:bg-black/5 dark:border-white/10 dark:hover:bg-white/5';
      link.dataset.commandResult = '';
      link.dataset.selected = String(index === 0);
      link.setAttribute('role', 'option');
      link.setAttribute('aria-selected', String(index === 0));
      if (post.action) link.dataset.action = post.action;
      const kind = document.createElement('span');
      kind.className = 'command-kind shrink-0 rounded-lg px-2 py-1 text-[10px] font-semibold';
      kind.textContent = post.kind || '文章';
      const copy = document.createElement('span');
      copy.className = 'min-w-0 flex-1';
      const title = document.createElement('strong');
      title.className = 'block font-display text-base';
      title.textContent = post.title;
      const desc = document.createElement('span');
      desc.className = 'mt-1 block text-sm opacity-60';
      desc.textContent = post.description || '暂无摘要';
      copy.append(title, desc);
      const arrow = document.createElement('span');
      arrow.className = 'motion-arrow opacity-50';
      arrow.textContent = '↗';
      link.append(kind, copy, arrow);
      link.addEventListener('click', (event) => {
        if (link.dataset.action !== 'random') return;
        event.preventDefault();
        const random = searchIndex[Math.floor(Math.random() * searchIndex.length)];
        if (random) location.assign(random.url);
      });
      results.appendChild(link);
    });
    activeResult = 0;
  }
  function renderSearchResults(query) {
    const q = query.trim().toLowerCase();
    const allItems = [...commandIndex, ...searchIndex];
    render(q ? allItems.filter((post) => [post.title, post.description, ...(post.tags || []), post.kind].join(' ').toLowerCase().includes(q)) : commandIndex.slice(0, 6));
  }
  async function handleSearch(query) {
    if (query.trim() && window.__ymll_pagefind) {
      const items = await window.__ymll_pagefind(query);
      if (items) { render(items); return; }
    }
    renderSearchResults(query);
  }
  function openSearch() { modal?.classList.remove('hidden'); modal?.classList.add('flex'); renderSearchResults(''); requestAnimationFrame(() => searchInput?.focus()); }
  function closeSearch() { modal?.classList.add('hidden'); modal?.classList.remove('flex'); }
  document.getElementById('search-btn')?.addEventListener('click', openSearch);
  document.addEventListener('click', (event) => {
    if (event.target instanceof Element && event.target.closest('[data-open-command]')) openSearch();
  });
  document.getElementById('search-close')?.addEventListener('click', closeSearch);
  modal?.addEventListener('click', (event) => { if (event.target === modal) closeSearch(); });
  searchInput?.addEventListener('input', (event) => handleSearch(event.target.value));
  searchInput?.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowDown') { event.preventDefault(); selectResult(activeResult + 1); }
    if (event.key === 'ArrowUp') { event.preventDefault(); selectResult(activeResult - 1); }
    if (event.key === 'Enter') {
      const selected = results?.querySelector('[data-command-result][data-selected="true"]');
      if (selected) { event.preventDefault(); selected.click(); }
    }
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeSearch();
    if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') { event.preventDefault(); openSearch(); }
  });

  const siteHeader = document.getElementById('site-header');
  let headerFrame = 0;
  const updateHeader = () => {
    headerFrame = 0;
    if (siteHeader) siteHeader.dataset.condensed = String(scrollY > 56);
  };
  addEventListener('scroll', () => {
    if (!headerFrame) headerFrame = requestAnimationFrame(updateHeader);
  }, { passive: true });
  updateHeader();
</script>
