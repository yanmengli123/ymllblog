---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const navItems = [
  { label: '首页', href: `${base}/`, icon: 'fa-home' },
  { label: '标签', href: `${base}/tags`, icon: 'fa-tags' },
  { label: '归档', href: `${base}/archive`, icon: 'fa-archive' },
  { label: '关于', href: `${base}/about`, icon: 'fa-user' },
];

const currentPath = Astro.url.pathname;

function isActive(href: string) {
  const cleanHref = href.replace(/\/$/, '') || '/';
  const cleanPath = currentPath.replace(/\/$/, '') || '/';
  if (cleanHref === base || cleanHref === '/') return cleanPath === base || cleanPath === '/' || cleanPath === `${base}/`;
  return cleanPath.startsWith(cleanHref);
}
---

<header id="header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-500">
  <nav class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href={`${base}/`} class="flex items-center gap-3 group">
        <div class="w-10 h-10 rounded-full bg-gradient-to-br from-purple-500 to-green-500 flex items-center justify-center shadow-lg group-hover:shadow-xl transition-all group-hover:scale-105">
          <span class="text-white font-bold text-lg">Y</span>
        </div>
        <span class="text-xl font-bold bg-gradient-to-r from-purple-500 to-green-500 bg-clip-text text-transparent">
          YMLL Blog
        </span>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center gap-1">
        {navItems.map(item => (
          <a
            href={item.href}
            class:list={[
              'relative px-4 py-2 text-sm font-medium rounded-lg transition-all duration-200',
              isActive(item.href)
                ? 'text-white bg-gradient-to-r from-purple-500 to-green-500 shadow-md'
                : 'text-stone-600 hover:text-stone-900 hover:bg-stone-100/80'
            ]}
          >
            {item.label}
          </a>
        ))}
      </div>

      <!-- Right actions -->
      <div class="flex items-center gap-2">
        <!-- RSS -->
        <a
          href={`${base}/rss.xml`}
          class="p-2.5 rounded-lg text-stone-500 hover:text-stone-700 hover:bg-stone-100 transition-all"
          aria-label="RSS"
          target="_blank"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
            <path d="M5 3a2 2 0 00-2 2v2a2 2 0 002 2h2a2 2 0 002-2V5a2 2 0 00-2-2H5zM5 11a2 2 0 00-2 2v2a2 2 0 002 2h2a2 2 0 002-2v-2a2 2 0 00-2-2H5zM11 5a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V5zM14 11a1 1 0 011 1v1h1a1 1 0 110 2h-1v1a1 1 0 11-2 0v-1h-1a1 1 0 110-2h1v-1a1 1 0 011-1z" />
          </svg>
        </a>

        <!-- Mobile menu button -->
        <button
          id="mobile-menu-toggle"
          class="md:hidden p-2.5 rounded-lg text-stone-500 hover:text-stone-700 hover:bg-stone-100 transition-all"
          aria-label="菜单"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile menu -->
    <div id="mobile-menu" class="hidden md:hidden pb-4">
      <div class="bg-white rounded-xl shadow-card p-4 space-y-1">
        {navItems.map(item => (
          <a
            href={item.href}
            class:list={[
              'block px-4 py-3 rounded-lg text-sm font-medium transition-all',
              isActive(item.href)
                ? 'text-white bg-gradient-to-r from-purple-500 to-green-500'
                : 'text-stone-600 hover:text-stone-900 hover:bg-stone-50'
            ]}
          >
            {item.label}
          </a>
        ))}
      </div>
    </div>
  </nav>
</header>

<script>
  // Header scroll effect - Matery 风格
  const header = document.getElementById('header');

  window.addEventListener('scroll', () => {
    const currentScroll = window.scrollY;

    if (currentScroll > 50) {
      header?.classList.add('bg-white/95', 'backdrop-blur-md', 'shadow-nav');
    } else {
      header?.classList.remove('bg-white/95', 'backdrop-blur-md', 'shadow-nav');
    }
  });

  // Mobile menu
  const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  mobileMenuToggle?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });
</script>

<style>
  .shadow-nav {
    box-shadow: 0 2px 5px 0 rgba(0,0,0,.16), 0 2px 10px 0 rgba(0,0,0,.12);
  }
</style>
