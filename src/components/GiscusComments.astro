---
interface Props { repo?: string; repoId?: string; category?: string; categoryId?: string; }
const { repo = 'yanmengli123/ymllblog', repoId = 'R_PLACEHOLDER_REPLACE_AFTER_GISCUS_SETUP', category = 'Announcements', categoryId = 'DIC_PLACEHOLDER_REPLACE_AFTER_GISCUS_SETUP' } = Astro.props;
const configured = !repoId.includes('PLACEHOLDER') && !categoryId.includes('PLACEHOLDER');
---

<section class="mt-16 border-t pt-10" style="border-color: var(--line);">
  <p class="eyebrow">Discussion</p><h2 class="font-display text-3xl font-bold">评论与交流</h2>
  {configured ? <div class="surface mt-7 rounded-2xl p-5"><script is:inline src="https://giscus.app/client.js" data-repo={repo} data-repo-id={repoId} data-category={category} data-category-id={categoryId} data-mapping="pathname" data-strict="1" data-reactions-enabled="1" data-emit-metadata="0" data-input-position="top" data-theme="preferred_color_scheme" data-lang="zh-CN" data-loading="lazy" crossorigin="anonymous" async></script></div> : <div class="mt-6 rounded-2xl border border-dashed p-6 text-sm leading-7" style="border-color: var(--line); color: var(--muted);">评论区将在完成 GitHub Discussions 绑定后开放。你也可以通过文章页的分享按钮继续讨论。</div>}
</section>
