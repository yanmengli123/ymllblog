---
import PostCard from './PostCard.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

interface Post {
  title: string;
  description: string;
  date: string;
  tags?: string[];
  slug: string;
  image?: string;
  readingTime?: string;
}

interface Props {
  posts: Post[];
  title?: string;
}

const { posts, title = '最新文章' } = Astro.props;
---

<section id="featured-posts" class="py-10" data-post-layout="grid">
  {/* Section header */}
  <div class="flex items-center justify-between mb-8">
    <div>
      <h2 class="text-2xl md:text-3xl font-bold mb-2" style="color: #4338ca;">{title}</h2>
      <p class="text-stone-500">探索技术与设计的最新见解</p>
    </div>
    <a
      href={`${base}/blog`}
      class="hidden sm:flex items-center gap-2 font-medium transition-colors group"
      style="color: #4f46e5;"
    >
      查看全部
      <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
      </svg>
    </a>
  </div>

  {/* Featured post */}
  {posts.length > 0 && (
    <div class="featured-post-primary mb-6 post-card-animate">
      <PostCard {...posts[0]} featured={true} />
    </div>
  )}

  {/* Post grid */}
  <div id="featured-post-list" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {posts.slice(1).map(post => (
      <div class="post-card-animate featured-post-item">
        <PostCard {...post} />
      </div>
    ))}
  </div>

  {/* Mobile view all */}
  <div class="sm:hidden mt-8 text-center">
    <a
      href={`${base}/blog`}
      class="inline-flex items-center gap-2 font-medium"
      style="color: var(--primary);"
    >
      查看全部文章
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
      </svg>
    </a>
  </div>
</section>

<script>
  (function() {
    const section = document.getElementById('featured-posts');
    const list = document.getElementById('featured-post-list');
    const items = Array.from(document.querySelectorAll('.featured-post-item'));
    const primary = document.querySelector('.featured-post-primary');

    const layoutClasses = {
      grid: 'grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6',
      list: 'grid grid-cols-1 gap-4',
      card: 'grid grid-cols-1 md:grid-cols-2 gap-6',
      masonry: 'columns-1 md:columns-2 xl:columns-3 gap-6 space-y-6',
    };

    function readSavedLayout() {
      try {
        const saved = JSON.parse(localStorage.getItem('ymll_user_settings') || '{}');
        return saved.postLayout || 'grid';
      } catch {
        return 'grid';
      }
    }

    function applyPostLayout(layout) {
      if (!section || !list) return;
      const nextLayout = layoutClasses[layout] ? layout : 'grid';
      section.dataset.postLayout = nextLayout;
      list.className = layoutClasses[nextLayout];

      items.forEach((item) => {
        item.classList.toggle('break-inside-avoid', nextLayout === 'masonry');
        item.classList.toggle('mb-6', nextLayout === 'masonry');
      });
      primary?.classList.toggle('hidden', nextLayout === 'list');
    }

    applyPostLayout(readSavedLayout());

    window.addEventListener('layout-change', (event) => {
      applyPostLayout(event.detail?.layout || readSavedLayout());
    });
  })();
</script>
