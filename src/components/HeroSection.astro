---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="hero-banner" parallax="true" id="hero-banner">
  <!-- 背景图片 -->
  <div class="absolute inset-0 bg-cover bg-center bg-no-repeat" style="background-image: url('/image/006.jpg');"></div>

  <!-- 渐变遮罩 - 蓝紫色调，深色确保文字可读 -->
  <div class="mask" style="background: linear-gradient(135deg, rgba(67, 56, 202, 0.85) 0%, rgba(124, 58, 237, 0.85) 50%, rgba(91, 33, 182, 0.85) 100%);"></div>

  <!-- Hero 内容 -->
  <div class="relative z-10 flex flex-col items-center justify-center h-full text-center px-4">
    <!-- 主标题 -->
    <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold text-white mb-4" style="text-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);">
      都是风景，幸会！
    </h1>

    <!-- 副标题 - 打字效果 -->
    <div class="h2">
      <span id="subtitle" class="text-xl sm:text-2xl md:text-3xl text-white/90" data-typed-text="吾生也有涯，而知也无涯"></span>
    </div>

    <!-- 装饰线 -->
    <div class="flex items-center justify-center gap-4 pt-6">
      <div class="h-px w-16 bg-gradient-to-r from-transparent to-white/60"></div>
      <div class="w-2 h-2 rounded-full bg-white/80 animate-float"></div>
      <div class="h-px w-16 bg-gradient-to-l from-transparent to-white/60"></div>
    </div>

    <!-- 简介 -->
    <p class="text-base sm:text-lg text-white/80 max-w-2xl mx-auto pt-6 leading-relaxed">
      探索技术与设计的交汇点，记录成长与思考
    </p>

    <!-- CTA 按钮 -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-8">
      <a
        href={`${base}/blog`}
        class="group relative px-8 py-4 bg-white text-indigo-600 font-semibold rounded-full shadow-2xl hover:shadow-3xl transition-all hover:-translate-y-1 overflow-hidden"
      >
        <span class="relative z-10">探索文章</span>
        <div class="absolute inset-0 bg-gradient-to-r from-indigo-500 to-purple-500 opacity-0 group-hover:opacity-100 transition-opacity"></div>
        <span class="absolute inset-0 z-10 flex items-center justify-center text-white opacity-0 group-hover:opacity-100 transition-opacity font-semibold">探索文章</span>
      </a>
      <a
        href={`${base}/about`}
        class="px-8 py-4 bg-white/10 backdrop-blur-md text-white font-semibold rounded-full border-2 border-white/40 hover:bg-white/20 transition-all hover:-translate-y-1"
      >
        了解更多
      </a>
    </div>
  </div>

  <!-- 水波纹动画 -->
  <div class="wave-container">
    <svg viewBox="0 0 1200 120" preserveAspectRatio="none">
      <path d="M0,0V46.29c47.79,22.2,103.59,32.17,158,28,70.36-5.37,136.33-33.31,206.8-37.5C438.64,32.43,512.34,53.67,583,72.05c69.27,18,138.3,24.88,209.4,13.08,36.15-6.01,68.49-19.64,103.66-26.4,49.84-9.66,98.42,4.5,150,19.83V0Z" class="wave-fill animate-wave-1" style="opacity: 0.5;"></path>
      <path d="M0,0V15.81C13,36.92,27.64,56.86,47.69,72.05,99.41,111.27,165,111,224.58,91.58c31.15-10.15,60.09-26.07,89.67-39.8,40.92-19,84.73-46,130.83-49.67,36.26-2.85,70.9,9.42,98.6,31.56,31.77,25.39,62.32,62,103.63,73,40.44,10.81,81.35-6.69,119.13-24.28s75.16-39,116.92-43.05c59.73-5.85,113.28,22.88,168.9,38.84,30.2,8.66,59,6.17,87.09-7.5,22.43-10.89,48-26.93,60.65-49.24V0Z" class="wave-fill animate-wave-2" style="opacity: 0.3;"></path>
    </svg>
  </div>

  <!-- 滚动指示器 -->
  <div class="scroll-down-bar">
    <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="color: rgba(255,255,255,0.8);">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
    </svg>
  </div>
</section>

<script>
  // 打字效果
  const texts = [
    '吾生也有涯，而知也无涯',
    '探索技术 · 设计 · 生活的交汇点',
    'Stay curious, keep learning.',
    'Welcome to my digital garden.'
  ];

  let textIndex = 0;
  let charIndex = 0;
  let isDeleting = false;
  const subtitleEl = document.getElementById('subtitle');

  function type() {
    if (!subtitleEl) return;

    const current = texts[textIndex];

    if (isDeleting) {
      subtitleEl.textContent = current.substring(0, charIndex - 1);
      charIndex--;
    } else {
      subtitleEl.textContent = current.substring(0, charIndex + 1);
      charIndex++;
    }

    let typeSpeed = isDeleting ? 50 : 100;

    if (!isDeleting && charIndex === current.length) {
      typeSpeed = 2000;
      isDeleting = true;
    } else if (isDeleting && charIndex === 0) {
      isDeleting = false;
      textIndex = (textIndex + 1) % texts.length;
      typeSpeed = 500;
    }

    setTimeout(type, typeSpeed);
  }

  setTimeout(type, 1000);
</script>
