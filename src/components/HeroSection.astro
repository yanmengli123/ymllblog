---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="relative min-h-[90vh] flex items-center justify-center overflow-hidden">
  <!-- Matery 风格渐变背景 -->
  <div class="absolute inset-0 bg-gradient-to-br from-purple-600 via-purple-500 to-green-500"></div>

  <!-- 动态覆盖层 -->
  <div class="absolute inset-0 bg-black/20"></div>

  <!-- 网格背景 -->
  <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 1px 1px, rgba(255,255,255,0.3) 1px, transparent 0); background-size: 40px 40px;"></div>

  <!-- 浮动装饰 -->
  <div class="absolute top-20 left-10 w-72 h-72 bg-white/10 rounded-full blur-3xl animate-float"></div>
  <div class="absolute bottom-20 right-10 w-96 h-96 bg-green-500/20 rounded-full blur-3xl animate-float" style="animation-delay: 2s;"></div>

  <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center text-white">
    <!-- 徽章 -->
    <div class="inline-flex items-center gap-2 px-4 py-2 bg-white/20 backdrop-blur-sm rounded-full border border-white/30 mb-8" data-aos="fade-down">
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-green-300"></span>
      </span>
      <span class="text-sm">欢迎来到我的数字空间</span>
    </div>

    <!-- 主标题 -->
    <h1 class="text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-bold mb-6" data-aos="fade-up">
      <span class="block">你好，我是</span>
      <span class="block mt-2 text-yellow-300">YMLL</span>
    </h1>

    <!-- 副标题 -->
    <p class="text-lg sm:text-xl md:text-2xl text-white/80 max-w-3xl mx-auto mb-12 leading-relaxed" data-aos="fade-up" data-aos-delay="100">
      热爱技术与设计的开发者，在这里记录<span class="text-yellow-300 font-medium">前端工程</span>、
      <span class="text-yellow-300 font-medium">UI/UX 设计</span>和
      <span class="text-yellow-300 font-medium">个人成长</span>的思考
    </p>

    <!-- CTA 按钮 - Matery 风格 -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4" data-aos="fade-up" data-aos-delay="200">
      <a
        href={`${base}/blog`}
        class="group relative px-8 py-4 bg-white text-purple-600 font-bold rounded-btn shadow-lg hover:shadow-xl transition-all hover:-translate-y-1 overflow-hidden"
      >
        <span class="relative z-10">探索文章</span>
        <div class="absolute inset-0 bg-gradient-to-r from-purple-500 to-green-500 opacity-0 group-hover:opacity-100 transition-opacity"></div>
        <span class="relative z-10 group-hover:text-white transition-colors">探索文章</span>
      </a>
      <a
        href={`${base}/about`}
        class="px-8 py-4 bg-transparent text-white font-bold rounded-btn border-2 border-white/50 hover:bg-white/10 hover:border-white transition-all hover:-translate-y-1"
      >
        了解更多
      </a>
    </div>

    <!-- 统计数据 -->
    <div class="grid grid-cols-3 gap-8 max-w-lg mx-auto mt-16" data-aos="fade-up" data-aos-delay="300">
      <div class="text-center">
        <div class="text-3xl font-bold text-yellow-300">9+</div>
        <div class="text-sm text-white/70 mt-1">篇文章</div>
      </div>
      <div class="text-center border-x border-white/20">
        <div class="text-3xl font-bold text-yellow-300">22+</div>
        <div class="text-sm text-white/70 mt-1">个标签</div>
      </div>
      <div class="text-center">
        <div class="text-3xl font-bold text-yellow-300">2+</div>
        <div class="text-sm text-white/70 mt-1">年经验</div>
      </div>
    </div>
  </div>

  <!-- 滚动指示器 -->
  <div class="absolute bottom-10 left-1/2 -translate-x-1/2 animate-bounce">
    <div class="w-6 h-10 rounded-full border-2 border-white/50 flex items-start justify-center p-1.5">
      <div class="w-1.5 h-3 bg-white/70 rounded-full animate-scroll"></div>
    </div>
  </div>
</section>

<style>
  @keyframes scroll {
    0% { transform: translateY(0); opacity: 1; }
    100% { transform: translateY(12px); opacity: 0; }
  }

  .animate-scroll {
    animation: scroll 1.5s ease-in-out infinite;
  }

  .animate-float {
    animation: float 6s ease-in-out infinite;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-20px); }
  }
</style>
