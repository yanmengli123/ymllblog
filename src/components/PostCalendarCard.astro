---
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const countByDate = new Map<string, number>();

for (const post of posts) {
  const key = post.data.pubDate.toISOString().slice(0, 10);
  countByDate.set(key, (countByDate.get(key) || 0) + 1);
}

const days = 140;
const today = new Date();
today.setHours(0, 0, 0, 0);

const cells = Array.from({ length: days }, (_, index) => {
  const date = new Date(today);
  date.setDate(today.getDate() - (days - 1 - index));
  const key = date.toISOString().slice(0, 10);
  const count = countByDate.get(key) || 0;
  return {
    key,
    count,
    level: Math.min(count, 4),
    label: date.toLocaleDateString('zh-CN', { month: 'short', day: 'numeric' }),
  };
});
---

<section id="post-calendar-card" class="sidebar-glass sidebar-widget">
  <div class="sidebar-widget-title">发布日历</div>
  <div class="calendar-grid" aria-label="最近文章发布日历">
    {cells.map(cell => (
      <span
        class={`calendar-cell calendar-level-${cell.level}`}
        title={`${cell.label}: ${cell.count} 篇`}
        aria-label={`${cell.key} 发布 ${cell.count} 篇`}
      ></span>
    ))}
  </div>
  <div class="mt-3 flex items-center justify-between text-[11px] text-stone-500">
    <span>少</span>
    <div class="flex gap-1">
      {[0, 1, 2, 3, 4].map(level => <span class={`calendar-cell calendar-level-${level}`}></span>)}
    </div>
    <span>多</span>
  </div>
</section>

<style>
  .calendar-grid {
    display: grid;
    grid-auto-flow: column;
    grid-template-rows: repeat(7, 0.72rem);
    gap: 0.28rem;
    max-width: 100%;
    overflow: hidden;
  }

  .calendar-cell {
    border-radius: 3px;
    display: inline-block;
    height: 0.72rem;
    width: 0.72rem;
  }

  .calendar-level-0 { background: rgba(226, 232, 240, 0.95); }
  .calendar-level-1 { background: rgba(186, 230, 253, 0.95); }
  .calendar-level-2 { background: rgba(125, 211, 252, 0.95); }
  .calendar-level-3 { background: rgba(59, 130, 246, 0.9); }
  .calendar-level-4 { background: rgba(79, 70, 229, 0.95); }
</style>
