---
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const postMap = new Map<string, typeof posts>();
for (const post of posts) {
  const key = post.data.pubDate.toISOString().slice(0, 10);
  postMap.set(key, [...(postMap.get(key) || []), post]);
}

const today = new Date();
today.setHours(0, 0, 0, 0);

const firstPostDate = posts.length
  ? new Date(Math.min(...posts.map(post => post.data.pubDate.getTime())))
  : today;
const latestPostDate = posts.length
  ? new Date(Math.max(...posts.map(post => post.data.pubDate.getTime())))
  : today;
const firstMonth = new Date(firstPostDate.getFullYear(), firstPostDate.getMonth(), 1);
const currentMonth = new Date(today.getFullYear(), today.getMonth(), 1);
const latestPostMonthKey = `${latestPostDate.getFullYear()}-${String(latestPostDate.getMonth() + 1).padStart(2, '0')}`;

const monthKeys: string[] = [];
for (let cursor = new Date(firstMonth); cursor <= currentMonth; cursor.setMonth(cursor.getMonth() + 1)) {
  monthKeys.push(`${cursor.getFullYear()}-${String(cursor.getMonth() + 1).padStart(2, '0')}`);
}
if (monthKeys.length === 0) {
  monthKeys.push(`${currentMonth.getFullYear()}-${String(currentMonth.getMonth() + 1).padStart(2, '0')}`);
}

const weekdays = ['日', '一', '二', '三', '四', '五', '六'];
const monthPanels = monthKeys.map(key => {
  const [year, month] = key.split('-').map(Number);
  const firstDay = new Date(year, month - 1, 1);
  const daysInMonth = new Date(year, month, 0).getDate();
  const leadingBlankCount = firstDay.getDay();
  const days = [
    ...Array.from({ length: leadingBlankCount }, () => null),
    ...Array.from({ length: daysInMonth }, (_, index) => {
      const date = new Date(year, month - 1, index + 1);
      const dateKey = `${year}-${String(month).padStart(2, '0')}-${String(index + 1).padStart(2, '0')}`;
      const dayPosts = postMap.get(dateKey) || [];
      return {
        count: dayPosts.length,
        dateKey,
        day: index + 1,
        isToday: date.getTime() === today.getTime(),
        posts: dayPosts
          .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
          .slice(0, 3)
          .map(post => ({
            title: post.data.title,
            url: `${base}/blog/${post.slug}`,
          })),
      };
    }),
  ];

  return {
    key,
    label: `${year} 年 ${month} 月`,
    days,
    postCount: days.reduce((sum, day) => sum + (day?.count || 0), 0),
  };
});

const activeMonthKey = monthPanels.some(panel => panel.key === latestPostMonthKey)
  ? latestPostMonthKey
  : monthPanels[monthPanels.length - 1].key;
---

<section id="post-calendar-card" class="sidebar-glass sidebar-widget" data-active-month={activeMonthKey}>
  <div class="calendar-header">
    <button id="calendar-prev-month" class="calendar-nav" type="button" aria-label="上个月">
      <span aria-hidden="true">‹</span>
    </button>
    <div>
      <div class="sidebar-widget-title calendar-title">发布日历</div>
      <div id="calendar-month-label" class="calendar-month-label">{monthPanels.find(panel => panel.key === activeMonthKey)?.label}</div>
    </div>
    <button id="calendar-next-month" class="calendar-nav" type="button" aria-label="下个月">
      <span aria-hidden="true">›</span>
    </button>
  </div>

  <div class="calendar-weekdays" aria-hidden="true">
    {weekdays.map(day => <span>{day}</span>)}
  </div>

  <div class="calendar-months">
    {monthPanels.map(panel => (
      <div
        class:list={['calendar-month', panel.key === activeMonthKey && 'is-active']}
        data-calendar-month={panel.key}
        data-calendar-label={panel.label}
        data-calendar-posts={panel.postCount}
      >
        <div class="calendar-days" role="grid" aria-label={`${panel.label} 文章发布日历`}>
          {panel.days.map(day => (
            day ? (
              <button
                type="button"
                class:list={[
                  'calendar-day',
                  day.count > 0 && 'has-posts',
                  day.isToday && 'is-today',
                ]}
                data-date={day.dateKey}
                data-post-count={day.count}
                title={`${day.dateKey}：${day.count} 篇文章`}
                aria-label={`${day.dateKey} 发布 ${day.count} 篇文章`}
              >
                <span class="calendar-day-number">{day.day}</span>
                {day.count > 0 && <span class="calendar-day-dot">{day.count}</span>}
              </button>
            ) : (
              <span class="calendar-day is-empty" aria-hidden="true"></span>
            )
          ))}
        </div>

        <div class="calendar-month-summary">
          本月发布 <strong>{panel.postCount}</strong> 篇文章
        </div>

        <div class="calendar-post-list">
          {panel.days.flatMap(day => day?.posts || []).slice(0, 4).map(post => (
            <a href={post.url} class="calendar-post-link">{post.title}</a>
          ))}
          {panel.postCount === 0 && <span class="calendar-empty-text">本月暂无文章发布</span>}
        </div>
      </div>
    ))}
  </div>
</section>

<script>
  (function() {
    const card = document.getElementById('post-calendar-card');
    if (!card) return;

    const months = Array.from(card.querySelectorAll('[data-calendar-month]')) as HTMLElement[];
    const label = document.getElementById('calendar-month-label');
    const prev = document.getElementById('calendar-prev-month') as HTMLButtonElement | null;
    const next = document.getElementById('calendar-next-month') as HTMLButtonElement | null;
    let activeIndex = Math.max(0, months.findIndex(month => month.dataset.calendarMonth === card.dataset.activeMonth));

    function render() {
      months.forEach((month, index) => {
        month.classList.toggle('is-active', index === activeIndex);
      });

      const active = months[activeIndex];
      if (label && active) label.textContent = active.dataset.calendarLabel || '';
      if (prev) prev.disabled = activeIndex <= 0;
      if (next) next.disabled = activeIndex >= months.length - 1;
    }

    prev?.addEventListener('click', () => {
      if (activeIndex > 0) {
        activeIndex -= 1;
        render();
      }
    });

    next?.addEventListener('click', () => {
      if (activeIndex < months.length - 1) {
        activeIndex += 1;
        render();
      }
    });

    render();
  })();
</script>

<style>
  .calendar-header {
    align-items: center;
    display: grid;
    gap: 0.5rem;
    grid-template-columns: 2rem minmax(0, 1fr) 2rem;
    margin-bottom: 0.75rem;
  }

  .calendar-title {
    justify-content: center;
    margin-bottom: 0.15rem;
  }

  .calendar-month-label {
    color: #64748b;
    font-size: 0.78rem;
    font-weight: 600;
    text-align: center;
  }

  .calendar-nav {
    align-items: center;
    background: rgba(99, 102, 241, 0.08);
    border: 1px solid rgba(99, 102, 241, 0.14);
    border-radius: 999px;
    color: #4f46e5;
    display: inline-flex;
    font-size: 1.25rem;
    height: 2rem;
    justify-content: center;
    line-height: 1;
    transition: all 0.2s ease;
    width: 2rem;
  }

  .calendar-nav:disabled {
    cursor: not-allowed;
    opacity: 0.35;
  }

  .calendar-nav:not(:disabled):hover {
    background: rgba(99, 102, 241, 0.14);
    transform: translateY(-1px);
  }

  .calendar-weekdays,
  .calendar-days {
    display: grid;
    gap: 0.35rem;
    grid-template-columns: repeat(7, minmax(0, 1fr));
  }

  .calendar-weekdays {
    color: #94a3b8;
    font-size: 0.72rem;
    font-weight: 700;
    margin-bottom: 0.45rem;
    text-align: center;
  }

  .calendar-month {
    display: none;
  }

  .calendar-month.is-active {
    display: block;
  }

  .calendar-day {
    aspect-ratio: 1;
    background: rgba(248, 250, 252, 0.92);
    border: 1px solid rgba(226, 232, 240, 0.95);
    border-radius: 0.55rem;
    color: #475569;
    font-size: 0.78rem;
    font-weight: 700;
    min-width: 0;
    position: relative;
    transition: all 0.18s ease;
  }

  .calendar-day.has-posts {
    background: linear-gradient(135deg, rgba(99, 102, 241, 0.12), rgba(6, 182, 212, 0.16));
    border-color: rgba(79, 70, 229, 0.26);
    color: #3730a3;
  }

  .calendar-day.is-today {
    box-shadow: 0 0 0 2px rgba(79, 70, 229, 0.28);
  }

  .calendar-day:not(.is-empty):hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 16px rgba(79, 70, 229, 0.12);
  }

  .calendar-day.is-empty {
    background: transparent;
    border-color: transparent;
  }

  .calendar-day-dot {
    align-items: center;
    background: #4f46e5;
    border-radius: 999px;
    bottom: 0.16rem;
    color: #fff;
    display: inline-flex;
    font-size: 0.55rem;
    height: 0.9rem;
    justify-content: center;
    position: absolute;
    right: 0.16rem;
    width: 0.9rem;
  }

  .calendar-month-summary {
    background: rgba(255, 255, 255, 0.68);
    border-radius: 0.75rem;
    color: #64748b;
    font-size: 0.76rem;
    margin-top: 0.8rem;
    padding: 0.55rem 0.7rem;
    text-align: center;
  }

  .calendar-month-summary strong {
    color: #4f46e5;
  }

  .calendar-post-list {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-top: 0.65rem;
  }

  .calendar-post-link,
  .calendar-empty-text {
    border-radius: 0.65rem;
    color: #64748b;
    font-size: 0.74rem;
    line-height: 1.35;
    padding: 0.35rem 0.5rem;
  }

  .calendar-post-link {
    background: rgba(99, 102, 241, 0.06);
    transition: all 0.18s ease;
  }

  .calendar-post-link:hover {
    background: rgba(99, 102, 241, 0.12);
    color: #4f46e5;
  }

  .calendar-empty-text {
    background: rgba(241, 245, 249, 0.7);
    text-align: center;
  }
</style>
