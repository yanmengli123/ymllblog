---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const officialLinks = [
  {
    label: 'GitHub 仓库',
    href: 'https://github.com/yanmengli123/ymllblog',
    description: '查看源码与提交记录',
    badge: 'Repo',
  },
  {
    label: 'RSS 订阅',
    href: `${base}/rss.xml`,
    description: '用阅读器追踪更新',
    badge: 'RSS',
  },
  {
    label: '站点地图',
    href: `${base}/sitemap-index.xml`,
    description: '搜索引擎友好的索引',
    badge: 'SEO',
  },
];

const techBadges = ['Astro', 'Tailwind CSS', 'Mermaid', 'GitHub Pages'];
---

<section id="official-widgets-card" class="sidebar-glass sidebar-widget">
  <div class="sidebar-widget-title">官方组件</div>

  <div class="space-y-3">
    {officialLinks.map((item) => (
      <a
        href={item.href}
        target={item.href.startsWith('http') ? '_blank' : undefined}
        rel={item.href.startsWith('http') ? 'noopener noreferrer' : undefined}
        class="group flex items-center gap-3 rounded-xl border border-stone-200/70 bg-white/70 p-3 text-left transition-all hover:border-indigo-200 hover:bg-indigo-50/70 dark:border-white/10 dark:bg-white/5 dark:hover:bg-white/10"
      >
        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-stone-900 text-[10px] font-bold uppercase tracking-wide text-white group-hover:bg-indigo-600">
          {item.badge}
        </span>
        <span class="min-w-0 flex-1">
          <span class="block truncate text-sm font-semibold text-stone-800 dark:text-stone-100">{item.label}</span>
          <span class="block truncate text-xs text-stone-500 dark:text-stone-400">{item.description}</span>
        </span>
        <svg class="h-4 w-4 shrink-0 text-stone-400 transition-transform group-hover:translate-x-0.5 group-hover:text-indigo-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    ))}
  </div>

  <div class="mt-4 border-t border-stone-200/70 pt-4 dark:border-white/10">
    <div class="mb-2 text-xs font-semibold uppercase tracking-wide text-stone-500">技术栈</div>
    <div class="flex flex-wrap gap-2">
      {techBadges.map((badge) => (
        <span class="rounded-full bg-white/70 px-2.5 py-1 text-xs font-medium text-stone-600 ring-1 ring-stone-200/70 dark:bg-white/10 dark:text-stone-200 dark:ring-white/10">
          {badge}
        </span>
      ))}
    </div>
  </div>
</section>
