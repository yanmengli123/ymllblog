---
interface Props {
  variant?: 'floating' | 'sidebar';
  playlistId?: string;
  playlistTitle?: string;
}

const {
  variant = 'floating',
  playlistId = '3778678',
  playlistTitle = '网易云音乐热歌榜',
} = Astro.props;

const isSidebar = variant === 'sidebar';
const frameHeight = 450;
const playerHeight = 430;
const playerSrc = `https://music.163.com/outchain/player?type=0&id=${encodeURIComponent(playlistId)}&auto=0&height=${playerHeight}`;
const playlistUrl = `https://music.163.com/#/playlist?id=${encodeURIComponent(playlistId)}`;
---

<div
  id="music-player"
  data-widget-variant={variant}
  data-player-provider="netease-cloud-music"
  data-playlist-id={playlistId}
  class:list={[
    'overflow-hidden',
    isSidebar
      ? 'sidebar-glass sidebar-widget w-full'
      : 'fixed bottom-20 right-4 z-[998] w-[360px] max-w-[calc(100vw-2rem)] rounded-2xl shadow-2xl'
  ]}
  style={`${isSidebar ? '' : 'display: none;'} background: rgba(255, 255, 255, 0.96); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); border: 1px solid rgba(0, 0, 0, 0.1);`}
>
  <div class="flex items-center justify-between gap-2 px-3 pt-3">
    <div class="min-w-0">
      <div class={isSidebar ? 'sidebar-widget-title !p-0' : 'text-sm font-semibold text-stone-800'}>
        网易云音乐
      </div>
      <p class="mt-0.5 truncate text-xs text-stone-500">{playlistTitle}</p>
    </div>

    <div class="flex shrink-0 items-center gap-1">
      <a
        href={playlistUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex h-7 w-7 items-center justify-center rounded-lg text-stone-400 transition-colors hover:bg-stone-100 hover:text-stone-700"
        aria-label="打开网易云音乐歌单"
        title="打开网易云音乐歌单"
      >
        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.5 6H18m0 0v4.5M18 6l-7.5 7.5M6 8.25v9.75h9.75" />
        </svg>
      </a>

      <button
        type="button"
        id="music-reload-player"
        class="inline-flex h-7 w-7 items-center justify-center rounded-lg text-stone-400 transition-colors hover:bg-stone-100 hover:text-stone-700"
        aria-label="重新加载音乐播放器"
        title="重新加载"
      >
        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 11a8.1 8.1 0 0 0-15.5-2M4 5v4h4m-4 4a8.1 8.1 0 0 0 15.5 2M20 19v-4h-4" />
        </svg>
      </button>

      {!isSidebar && (
        <button
          type="button"
          id="music-toggle-player"
          class="inline-flex h-7 w-7 items-center justify-center rounded-lg text-stone-400 transition-colors hover:bg-stone-100 hover:text-stone-700"
          aria-label="隐藏音乐播放器"
          title="隐藏"
        >
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18 18 6M6 6l12 12" />
          </svg>
        </button>
      )}
    </div>
  </div>

  <div class="px-3 pb-3 pt-2">
    <iframe
      id="netease-player-frame"
      title={`网易云音乐官方播放器 - ${playlistTitle}`}
      src={playerSrc}
      width="100%"
      height={frameHeight}
      frameborder="no"
      marginwidth="0"
      marginheight="0"
      scrolling="no"
      allow="autoplay; encrypted-media"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      class="block w-full rounded-lg bg-white"
      style="border: 0;"
    ></iframe>

    <p class="mt-2 text-[11px] leading-5 text-stone-500">
      播放、歌词、切歌和列表由网易云音乐官方播放器提供；如遇版权限制，请在网易云中打开歌单播放。
    </p>
  </div>
</div>

<script define:vars={{ playerSrc, playlistUrl }}>
  (function() {
    const player = document.getElementById('music-player');
    const frame = document.getElementById('netease-player-frame');
    const closeBtn = document.getElementById('music-toggle-player');
    const reloadBtn = document.getElementById('music-reload-player');
    const isSidebar = player?.dataset.widgetVariant === 'sidebar';

    function showPlayer() {
      if (!player) return;
      player.style.display = '';
      localStorage.setItem('music-player-visible', 'true');
    }

    function hidePlayer() {
      if (!player) return;
      player.style.display = 'none';
      localStorage.setItem('music-player-visible', 'false');
    }

    function reloadPlayer() {
      if (!frame) return;
      frame.setAttribute('src', playerSrc);
    }

    closeBtn?.addEventListener('click', hidePlayer);
    reloadBtn?.addEventListener('click', reloadPlayer);

    window.musicPlayer = {
      show: showPlayer,
      hide: hidePlayer,
      toggle() {
        if (!player) return;
        if (player.style.display === 'none') showPlayer();
        else hidePlayer();
      },
      reload: reloadPlayer,
      open() {
        window.open(playlistUrl, '_blank', 'noopener,noreferrer');
      },
    };

    if (!isSidebar && localStorage.getItem('music-player-visible') === 'true') {
      showPlayer();
    }
  })();
</script>
