---
interface Props {
  playlistId?: string;
  playlistTitle?: string;
}

const {
  playlistId = import.meta.env.PUBLIC_NETEASE_PLAYLIST_ID || '3778678',
  playlistTitle = import.meta.env.PUBLIC_NETEASE_PLAYLIST_TITLE || '网易云音乐热歌榜',
} = Astro.props;
const playerHeight = 430;
const playerSrc = `https://music.163.com/outchain/player?type=0&id=${encodeURIComponent(playlistId)}&auto=0&height=${playerHeight}`;
const playlistUrl = `https://music.163.com/#/playlist?id=${encodeURIComponent(playlistId)}`;
---

<section class="site-shell py-20 section-rule" aria-labelledby="music-heading" data-player-provider="netease-cloud-music" data-reveal>
  <div class="music-section overflow-hidden rounded-[2rem] border" style="border-color: var(--line); background: var(--surface);">
    <div class="grid lg:grid-cols-[0.72fr_1.28fr]">
      <div class="flex flex-col justify-between p-8 sm:p-12" style="background: var(--ink); color: var(--surface);">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.2em] opacity-60">Now playing</p>
          <h2 id="music-heading" class="mt-5 font-display text-4xl font-bold sm:text-5xl">我的声音书签。</h2>
          <p class="mt-5 max-w-sm text-sm leading-7 opacity-70">写作间隙正在听的歌，也是一份随时间更新的个人切片。播放器、歌单和播放控制均由网易云音乐官方组件提供。</p>
        </div>
        <a href={playlistUrl} target="_blank" rel="noopener noreferrer" class="mt-10 inline-flex w-fit items-center gap-2 text-sm font-semibold">
          在网易云音乐打开 <span aria-hidden="true">↗</span>
        </a>
      </div>

      <div class="p-4 sm:p-7">
        <div class="mb-4 flex items-center justify-between gap-4 px-1">
          <div class="min-w-0">
            <p class="text-[10px] font-semibold uppercase tracking-[0.16em]" style="color: var(--muted);">网易云音乐官方播放器</p>
            <p class="mt-1 truncate text-sm font-semibold">{playlistTitle}</p>
          </div>
          <span class="inline-flex shrink-0 items-center gap-2 text-[11px]" style="color: var(--muted);"><i class="h-2 w-2 rounded-full" style="background: #e64343;"></i>自动播放已关闭</span>
        </div>
        <iframe
          title={`网易云音乐官方播放器 - ${playlistTitle}`}
          src={playerSrc}
          width="100%"
          height="450"
          allow="autoplay; encrypted-media"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          class="block w-full rounded-xl bg-white"
          style="border: 0;"
        ></iframe>
        <p class="mt-3 px-1 text-[11px] leading-5" style="color: var(--muted);">部分歌曲可能因版权或地区限制无法在网页播放，可通过上方链接在网易云音乐客户端继续。</p>
      </div>
    </div>
  </div>
</section>
