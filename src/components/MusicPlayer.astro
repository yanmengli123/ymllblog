---
interface Props {
  variant?: 'floating' | 'sidebar';
}

const { variant = 'floating' } = Astro.props;
const isSidebar = variant === 'sidebar';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const playlist = [
  {
    id: '1456594770',
    title: 'Take Me Away',
    artist: 'Lyyan Lyyan',
    cover: `${base}/image/006.jpg`,
  },
  {
    id: '441116287',
    title: '星空',
    artist: '网易云音乐',
    cover: `${base}/image/006.jpg`,
  },
  {
    id: '169159',
    title: '夜曲',
    artist: '网易云音乐',
    cover: `${base}/image/006.jpg`,
  },
];

const playerSrc = (id: string) => `https://music.163.com/outchain/player?type=2&id=${id}&auto=0&height=66`;
---

<div
  id="music-player"
  data-widget-variant={variant}
  class:list={[
    'overflow-hidden',
    isSidebar
      ? 'sidebar-glass sidebar-widget w-full'
      : 'fixed bottom-20 right-4 z-[998] w-80 max-w-[calc(100vw-2rem)] rounded-2xl shadow-2xl'
  ]}
  style={`${isSidebar ? '' : 'display: none;'} background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); border: 1px solid rgba(0, 0, 0, 0.1);`}
>
  {isSidebar && <div class="sidebar-widget-title px-3 pt-3">音乐</div>}
  <div class="p-3">
    <div class="flex items-center gap-2 mb-3">
      <div class="relative shrink-0">
        <img id="music-cover" src={playlist[0].cover} alt="音乐封面" class="w-11 h-11 rounded-lg object-cover shadow-md" />
        <div class="absolute inset-0 rounded-lg ring-1 ring-white/50"></div>
      </div>
      <div class="flex-1 min-w-0">
        <div id="music-title" class="font-semibold text-sm truncate text-stone-800">{playlist[0].title}</div>
        <div id="music-artist" class="text-xs truncate text-stone-500">{playlist[0].artist}</div>
      </div>
      <button id="music-toggle-player" class="p-1.5 rounded-lg hover:bg-stone-100 transition-colors text-stone-400 hover:text-stone-600" aria-label="隐藏音乐播放器">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <iframe
      id="netease-player-frame"
      title={`网易云音乐播放器 - ${playlist[0].title}`}
      src={playerSrc(playlist[0].id)}
      width="100%"
      height="86"
      frameborder="no"
      marginwidth="0"
      marginheight="0"
      allow="autoplay; encrypted-media"
      loading="lazy"
      class="block w-full rounded-lg bg-white"
    ></iframe>

    <div class="mt-3 grid gap-2">
      {playlist.map((song, index) => (
        <button
          type="button"
          class:list={[
            'music-song-btn flex items-center gap-2 rounded-lg px-2.5 py-2 text-left text-xs transition-colors',
            index === 0 ? 'bg-indigo-50 text-indigo-700' : 'text-stone-600 hover:bg-stone-100'
          ]}
          data-song-index={index}
          data-song-id={song.id}
          data-song-title={song.title}
          data-song-artist={song.artist}
          data-song-cover={song.cover}
          aria-pressed={index === 0 ? 'true' : 'false'}
        >
          <span class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-white/80 text-[10px] font-semibold shadow-sm">{index + 1}</span>
          <span class="min-w-0">
            <span class="block truncate font-medium">{song.title}</span>
            <span class="block truncate text-[10px] opacity-70">{song.artist}</span>
          </span>
        </button>
      ))}
    </div>
  </div>
</div>

<script define:vars={{ playlist }}>
  (function() {
    const player = document.getElementById('music-player');
    const frame = document.getElementById('netease-player-frame');
    const closeBtn = document.getElementById('music-toggle-player');
    const titleEl = document.getElementById('music-title');
    const artistEl = document.getElementById('music-artist');
    const coverEl = document.getElementById('music-cover');
    const songButtons = Array.from(document.querySelectorAll('.music-song-btn'));
    const isSidebar = player?.dataset.widgetVariant === 'sidebar';
    let currentIndex = 0;

    function getFrameSrc(songId) {
      return `https://music.163.com/outchain/player?type=2&id=${songId}&auto=0&height=66`;
    }

    function setActiveButton(index) {
      songButtons.forEach((button, buttonIndex) => {
        const isActive = buttonIndex === index;
        button.setAttribute('aria-pressed', String(isActive));
        button.classList.toggle('bg-indigo-50', isActive);
        button.classList.toggle('text-indigo-700', isActive);
        button.classList.toggle('text-stone-600', !isActive);
        button.classList.toggle('hover:bg-stone-100', !isActive);
      });
    }

    function loadSong(index) {
      const song = playlist[index];
      if (!song || !frame) return;
      currentIndex = index;
      frame.src = getFrameSrc(song.id);
      frame.title = `网易云音乐播放器 - ${song.title}`;
      if (titleEl) titleEl.textContent = song.title;
      if (artistEl) artistEl.textContent = song.artist;
      if (coverEl) coverEl.src = song.cover;
      setActiveButton(index);
    }

    songButtons.forEach((button, index) => {
      button.addEventListener('click', () => loadSong(index));
    });

    closeBtn?.addEventListener('click', () => {
      if (!player) return;
      player.style.display = 'none';
      localStorage.setItem('music-player-visible', 'false');
    });

    window.musicPlayer = {
      show() {
        if (!player) return;
        player.style.display = '';
        localStorage.setItem('music-player-visible', 'true');
      },
      hide() {
        if (!player) return;
        player.style.display = 'none';
        localStorage.setItem('music-player-visible', 'false');
      },
      toggle() {
        if (!player) return;
        if (player.style.display === 'none') this.show();
        else this.hide();
      },
      play() {
        if (frame) frame.focus();
      },
      pause() {},
      next() {
        loadSong((currentIndex + 1) % playlist.length);
      },
      prev() {
        loadSong((currentIndex - 1 + playlist.length) % playlist.length);
      },
    };

    if (!isSidebar && localStorage.getItem('music-player-visible') === 'true' && player) {
      player.style.display = '';
    }
  })();
</script>
