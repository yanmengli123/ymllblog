---
const currentYear = new Date().getFullYear();

const socialLinks = [
  { name: 'GitHub', url: 'https://github.com/yanmengli123', icon: 'github' },
  { name: 'RSS', url: '/rss.xml', icon: 'rss' },
];
---

<footer class="bg-surface dark:bg-surface-dark border-t border-gray-200 dark:border-gray-800 mt-16">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div>
        <h3 class="text-lg font-semibold text-primary dark:text-primary-400 mb-4">YMLL Blog</h3>
        <p class="text-sm text-text-muted dark:text-gray-400">
          记录技术、设计与生活的个人博客
        </p>
      </div>

      <div>
        <h4 class="text-sm font-semibold text-text dark:text-text-dark mb-4">快速链接</h4>
        <ul class="space-y-2">
          <li><a href="/blog" class="text-sm text-text-muted hover:text-primary transition-colors">博客</a></li>
          <li><a href="/tags" class="text-sm text-text-muted hover:text-primary transition-colors">标签</a></li>
          <li><a href="/about" class="text-sm text-text-muted hover:text-primary transition-colors">关于</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-sm font-semibold text-text dark:text-text-dark mb-4">订阅</h4>
        <p class="text-sm text-text-muted dark:text-gray-400 mb-4">
          通过 RSS 获取最新文章
        </p>
        <a
          href="/rss.xml"
          class="inline-flex items-center gap-2 text-sm text-primary hover:text-primary-700 transition-colors"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
            <path d="M5 3a2 2 0 00-2 2v2a2 2 0 002 2h2a2 2 0 002-2V5a2 2 0 00-2-2H5zM5 11a2 2 0 00-2 2v2a2 2 0 002 2h2a2 2 0 002-2v-2a2 2 0 00-2-2H5zM11 5a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V5zM14 11a1 1 0 011 1v1h1a1 1 0 110 2h-1v1a1 1 0 11-2 0v-1h-1a1 1 0 110-2h1v-1a1 1 0 011-1z" />
          </svg>
          RSS Feed
        </a>
      </div>
    </div>

    <div class="mt-8 pt-8 border-t border-gray-200 dark:border-gray-800">
      <div class="flex flex-col sm:flex-row justify-between items-center gap-4">
        <p class="text-sm text-text-muted dark:text-gray-400">
          &copy; {currentYear} YMLL Blog. All rights reserved.
        </p>
        <div class="flex items-center gap-4">
          {socialLinks.map(link => (
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              class="text-text-muted hover:text-primary transition-colors"
              title={link.name}
            >
              {link.icon === 'github' && (
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
                </svg>
              )}
              {link.icon === 'rss' && (
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M5 3a2 2 0 00-2 2v2a2 2 0 002 2h2a2 2 0 002-2V5a2 2 0 00-2-2H5zM5 11a2 2 0 00-2 2v2a2 2 0 002 2h2a2 2 0 002-2v-2a2 2 0 00-2-2H5zM11 5a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V5zM14 11a1 1 0 011 1v1h1a1 1 0 110 2h-1v1a1 1 0 11-2 0v-1h-1a1 1 0 110-2h1v-1a1 1 0 011-1z" />
                </svg>
              )}
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</footer>
