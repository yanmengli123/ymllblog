---
const base = import.meta.env.BASE_URL;
const currentYear = new Date().getFullYear();

const links = {
  product: [
    { label: '博客', href: `${base}blog` },
    { label: '标签', href: `${base}tags` },
    { label: '归档', href: `${base}archive` },
    { label: '关于', href: `${base}about` },
  ],
  social: [
    { label: 'GitHub', href: 'https://github.com/yanmengli123', icon: 'github' },
    { label: 'Twitter', href: '#', icon: 'twitter' },
    { label: 'Email', href: 'mailto:contact@example.com', icon: 'email' },
    { label: 'RSS', href: `${base}rss.xml`, icon: 'rss' },
  ],
};
---

<footer class="relative mt-32 overflow-hidden">
  <!-- Background decoration -->
  <div class="absolute inset-0 -z-10">
    <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-gradient-to-t from-emerald-50 to-transparent rounded-full blur-3xl opacity-50"></div>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Newsletter section -->
    <div class="glass rounded-3xl p-8 md:p-12 mb-16 text-center">
      <h3 class="text-2xl md:text-3xl font-bold text-stone-900 mb-4">
        订阅我的<span class="gradient-text">周报</span>
      </h3>
      <p class="text-stone-600 mb-8 max-w-md mx-auto">
        每周分享技术洞察、设计灵感和个人思考，直接送到您的收件箱
      </p>
      <form class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto">
        <input
          type="email"
          placeholder="your@email.com"
          class="flex-1 px-4 py-3 rounded-xl bg-white border border-stone-200 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 outline-none transition-all"
        />
        <button
          type="submit"
          class="px-6 py-3 bg-gradient-to-r from-emerald-500 to-teal-600 text-white font-medium rounded-xl hover:shadow-lg hover:shadow-emerald-500/25 transition-all hover:-translate-y-0.5"
        >
          订阅
        </button>
      </form>
    </div>

    <!-- Footer links -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12 pb-12 border-t border-stone-200/60 pt-12">
      <!-- Brand -->
      <div class="md:col-span-2">
        <a href={base} class="flex items-center gap-3 mb-4">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-emerald-500 to-teal-600 flex items-center justify-center">
            <span class="text-white font-bold text-lg">Y</span>
          </div>
          <span class="text-xl font-semibold text-stone-800">
            YMLL<span class="text-emerald-500">.</span>blog
          </span>
        </a>
        <p class="text-stone-500 text-sm max-w-xs leading-relaxed">
          探索技术与设计的交汇点。分享前端开发、UI/UX 设计和个人成长的见解。
        </p>
      </div>

      <!-- Navigation -->
      <div>
        <h4 class="text-sm font-semibold text-stone-900 mb-4">导航</h4>
        <ul class="space-y-3">
          {links.product.map(link => (
            <li>
              <a href={link.href} class="text-sm text-stone-500 hover:text-emerald-600 transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Social -->
      <div>
        <h4 class="text-sm font-semibold text-stone-900 mb-4">社交</h4>
        <ul class="space-y-3">
          {links.social.map(link => (
            <li>
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm text-stone-500 hover:text-emerald-600 transition-colors inline-flex items-center gap-2"
              >
                {link.icon === 'github' && (
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                    <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
                  </svg>
                )}
                {link.icon === 'twitter' && (
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M8.29 20.251c7.547 0 11.675-6.253 11.675-11.675 0-.178 0-.355-.012-.53A8.348 8.348 0 0022 5.92a8.19 8.19 0 01-2.357.646 4.118 4.118 0 001.804-2.27 8.224 8.224 0 01-2.605.996 4.107 4.107 0 00-6.993 3.743 11.65 11.65 0 01-8.457-4.287 4.106 4.106 0 001.27 5.477A4.072 4.072 0 012.8 9.713v.052a4.105 4.105 0 003.292 4.022 4.095 4.095 0 01-1.853.07 4.108 4.108 0 003.834 2.85A8.233 8.233 0 012 18.407a11.616 11.616 0 006.29 1.84" />
                  </svg>
                )}
                {link.icon === 'email' && (
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                )}
                {link.icon === 'rss' && (
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M5 3a2 2 0 00-2 2v2a2 2 0 002 2h2a2 2 0 002-2V5a2 2 0 00-2-2H5zM5 11a2 2 0 00-2 2v2a2 2 0 002 2h2a2 2 0 002-2v-2a2 2 0 00-2-2H5zM11 5a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V5zM14 11a1 1 0 011 1v1h1a1 1 0 110 2h-1v1a1 1 0 11-2 0v-1h-1a1 1 0 110-2h1v-1a1 1 0 011-1z" />
                  </svg>
                )}
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Copyright -->
    <div class="border-t border-stone-200/60 py-6 flex flex-col sm:flex-row justify-between items-center gap-4">
      <p class="text-xs text-stone-400">
        &copy; {currentYear} YMLL Blog. All rights reserved.
      </p>
      <p class="text-xs text-stone-400">
        使用 <span class="text-emerald-500">Astro</span> + <span class="text-emerald-500">Tailwind CSS</span> 构建
      </p>
    </div>
  </div>
</footer>
