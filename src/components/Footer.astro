---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentYear = new Date().getFullYear();

const links = {
  product: [
    { label: '博客', href: `${base}/blog` },
    { label: '标签', href: `${base}/tags` },
    { label: '归档', href: `${base}/archive` },
    { label: '关于', href: `${base}/about` },
  ],
  social: [
    { label: 'GitHub', href: 'https://github.com/yanmengli123', icon: 'github' },
    { label: 'RSS', href: `${base}/rss.xml`, icon: 'rss' },
  ],
};

// 网站建立时间 (用于计算运行时间)
const siteStartDate = '2024-01-01';
---

<footer class="relative mt-20 overflow-hidden">
  <!-- Matery 风格渐变背景 -->
  <div class="bg-gradient-to-r from-purple-600 to-green-600">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <!-- 订阅区域 -->
      <div class="text-center mb-12">
        <h3 class="text-2xl md:text-3xl font-bold text-white mb-4">
          订阅我的<span class="text-yellow-300">周报</span>
        </h3>
        <p class="text-white/80 mb-8 max-w-md mx-auto">
          每周分享技术洞察、设计灵感和个人思考
        </p>
        <form class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto">
          <input
            type="email"
            placeholder="your@email.com"
            class="flex-1 px-4 py-3 rounded-btn bg-white/20 border border-white/30 text-white placeholder-white/60 focus:border-white focus:ring-2 focus:ring-white/20 outline-none transition-all"
          />
          <button
            type="submit"
            class="px-6 py-3 bg-white text-purple-600 font-bold rounded-btn hover:bg-yellow-300 hover:text-purple-700 transition-all"
          >
            订阅
          </button>
        </form>
      </div>

      <!-- 链接区域 -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 pb-8 border-t border-white/20 pt-8">
        <!-- 品牌 -->
        <div>
          <a href={`${base}/`} class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-full bg-white/20 flex items-center justify-center">
              <span class="text-white font-bold text-lg">Y</span>
            </div>
            <span class="text-xl font-bold text-white">
              YMLL<span class="text-yellow-300">.</span>blog
            </span>
          </a>
          <p class="text-white/70 text-sm max-w-xs leading-relaxed">
            探索技术与设计的交汇点。分享前端开发、UI/UX 设计和个人成长的见解。
          </p>
        </div>

        <!-- 导航 -->
        <div>
          <h4 class="text-sm font-semibold text-white mb-4">导航</h4>
          <ul class="space-y-3">
            {links.product.map(link => (
              <li>
                <a href={link.href} class="text-sm text-white/70 hover:text-white transition-colors">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- 社交 -->
        <div>
          <h4 class="text-sm font-semibold text-white mb-4">社交</h4>
          <ul class="space-y-3">
            {links.social.map(link => (
              <li>
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-sm text-white/70 hover:text-white transition-colors inline-flex items-center gap-2"
                >
                  {link.icon === 'github' && (
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                      <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
                    </svg>
                  )}
                  {link.icon === 'rss' && (
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                      <path d="M5 3a2 2 0 00-2 2v2a2 2 0 002 2h2a2 2 0 002-2V5a2 2 0 00-2-2H5zM5 11a2 2 0 00-2 2v2a2 2 0 002 2h2a2 2 0 002-2v-2a2 2 0 00-2-2H5zM11 5a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V5zM14 11a1 1 0 011 1v1h1a1 1 0 110 2h-1v1a1 1 0 11-2 0v-1h-1a1 1 0 110-2h1v-1a1 1 0 011-1z" />
                    </svg>
                  )}
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- 版权信息 -->
      <div class="border-t border-white/20 pt-6">
        <div class="flex flex-col sm:flex-row justify-between items-center gap-4">
          <p class="text-xs text-white/60">
            &copy; 2024-{currentYear} YMLL Blog. All rights reserved.
          </p>
          <div class="flex items-center gap-4 text-xs text-white/60">
            <span>
              使用 <span class="text-yellow-300">Astro</span> + <span class="text-yellow-300">Tailwind CSS</span> 构建
            </span>
          </div>
        </div>

        <!-- 网站运行时间 -->
        <div class="text-center mt-4">
          <p class="text-xs text-white/50">
            本站已运行 <span id="site-runtime" class="text-yellow-300">计算中...</span>
          </p>
        </div>

        <!-- 访客统计 -->
        <div class="text-center mt-2">
          <p class="text-xs text-white/50">
            <span id="busuanzi_container_site_pv" style="display: inline;">
              本站总访问量 <span id="busuanzi_value_site_pv" class="text-yellow-300">--</span> 次
            </span>
            <span class="mx-2">·</span>
            <span id="busuanzi_container_site_uv" style="display: inline;">
              访客数 <span id="busuanzi_value_site_uv" class="text-yellow-300">--</span> 人
            </span>
          </p>
        </div>
      </div>
    </div>
  </div>
</footer>

<script is:inline>
// 网站运行时间计算
(function() {
  var startDate = new Date('2024-01-01');
  var runtimeElement = document.getElementById('site-runtime');

  function updateRuntime() {
    var now = new Date();
    var diff = now - startDate;

    var years = Math.floor(diff / (365 * 24 * 60 * 60 * 1000));
    var days = Math.floor((diff % (365 * 24 * 60 * 60 * 1000)) / (24 * 60 * 60 * 1000));
    var hours = Math.floor((diff % (24 * 60 * 60 * 1000)) / (60 * 60 * 1000));
    var minutes = Math.floor((diff % (60 * 60 * 1000)) / (60 * 1000));
    var seconds = Math.floor((diff % (60 * 1000)) / 1000);

    var runtime = '';
    if (years > 0) runtime += years + ' 年 ';
    runtime += days + ' 天 ' + hours + ' 小时 ' + minutes + ' 分钟 ' + seconds + ' 秒';

    if (runtimeElement) {
      runtimeElement.textContent = runtime;
    }
  }

  updateRuntime();
  setInterval(updateRuntime, 1000);
})();
</script>

<!-- 不蒜子访客统计 -->
<script async src="//busuanzi.ibruce.info/busuanzi/2.3/busuanzi.pure.mini.js"></script>
