---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

export interface Props {
  title: string;
  description: string;
  date: string;
  tags?: string[];
  slug: string;
  image?: string;
  readingTime?: string;
  category?: string;
  featured?: boolean;
  index?: number;
  reveal?: boolean;
  revealOrder?: number;
  maturity?: 'seedling' | 'growing' | 'evergreen';
}

const { title, description, date, tags = [], slug, image, readingTime = '约 5 分钟', category, featured = false, index = 1, reveal = false, revealOrder = 0, maturity = 'growing' } = Astro.props;
const formattedDate = new Date(date).toLocaleDateString('zh-CN', { year: 'numeric', month: 'short', day: 'numeric' });
const maturityLabel = { seedling: '🌱 幼苗', growing: '🌿 生长', evergreen: '🌳 常青' }[maturity];
---

<article
  class:list={['motion-card group relative overflow-hidden rounded-3xl surface', featured && 'lg:grid lg:grid-cols-[1.1fr_0.9fr]']}
  data-reveal={reveal ? '' : undefined}
  style={`--reveal-order: ${revealOrder};`}
>
  {image ? (
    <a href={`${base}/blog/${slug}`} class:list={['block overflow-hidden', featured ? 'aspect-[16/10] lg:aspect-auto' : 'aspect-[16/9]']} tabindex="-1" aria-hidden="true">
      <img src={image} alt="" class="motion-card-media h-full w-full object-cover saturate-[0.82] group-hover:scale-[1.02] group-hover:saturate-100" loading={featured ? 'eager' : 'lazy'} />
    </a>
  ) : (
    <a href={`${base}/blog/${slug}`} class:list={['relative block overflow-hidden', featured ? 'min-h-64' : 'aspect-[16/9]']} tabindex="-1" aria-hidden="true" style="background: var(--brand-soft);">
      <span class="absolute left-6 top-5 text-[11px] font-semibold uppercase tracking-[0.2em]" style="color: var(--brand-deep);">FIELD NOTE / {String(index).padStart(2, '0')}</span>
      <span class="absolute -bottom-8 right-5 font-display text-[9rem] font-black leading-none opacity-[0.08]">{String(index).padStart(2, '0')}</span>
      <span class="absolute bottom-6 left-6 h-px w-20" style="background: var(--brand);"></span>
    </a>
  )}
  <div class:list={['flex flex-col p-6 sm:p-7', featured && 'justify-center lg:p-10']}>
    <div class="mb-4 flex items-start justify-between gap-4 text-xs" style="color: var(--muted);">
      <div class="flex flex-wrap items-center gap-3">
        <span class="maturity-badge" data-maturity={maturity}>{maturityLabel}</span>
        {category && <span class="font-semibold uppercase tracking-[0.12em]" style="color: var(--brand-deep);">{category}</span>}
        <time datetime={date}>{formattedDate}</time>
        <span aria-hidden="true">·</span>
        <span>{readingTime}</span>
      </div>
      <span class="motion-arrow shrink-0 text-base" aria-hidden="true" style="color: var(--brand-deep);">↗</span>
    </div>
    <h3 class:list={['font-display font-bold leading-tight', featured ? 'text-3xl sm:text-4xl' : 'text-2xl']}>
      <a href={`${base}/blog/${slug}`} class="motion-card-title after:absolute after:inset-0 group-hover:text-emerald-700 dark:group-hover:text-emerald-300">{title}</a>
    </h3>
    <p class:list={['mt-4 leading-relaxed', featured ? 'line-clamp-3 text-base' : 'line-clamp-2 text-sm']} style="color: var(--muted);">{description}</p>
    {tags.length > 0 && <div class="relative z-10 mt-6 flex flex-wrap gap-2">{tags.slice(0, 3).map((tag) => <a href={`${base}/tags/${tag}`} class="tag-pill">#{tag}</a>)}</div>}
  </div>
</article>
