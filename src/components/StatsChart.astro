---
// 企业级统计仪表盘
---

<!-- 粒子背景画布 -->
<canvas id="particleBg" class="fixed inset-0 w-full h-full pointer-events-none" style="z-index: -2;"></canvas>

<section class="py-20 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- 标题 -->
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-stone-900 mb-4">
        📊 博客数据<span class="gradient-text">仪表盘</span>
      </h2>
      <p class="text-stone-500 max-w-2xl mx-auto">
        实时追踪博客运营数据，见证每一次成长
      </p>
    </div>

    <!-- 核心指标卡片 -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-12">
      <div class="bg-white rounded-2xl p-6 border border-stone-200 shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-2">
        <div class="flex items-center justify-between mb-4">
          <div class="w-12 h-12 bg-emerald-50 rounded-xl flex items-center justify-center">
            <span class="text-2xl">📄</span>
          </div>
          <span class="text-xs text-emerald-500 font-medium bg-emerald-50 px-2 py-1 rounded-full">+12%</span>
        </div>
        <div class="text-3xl font-bold text-stone-900 mb-1" id="counter-posts">0</div>
        <div class="text-sm text-stone-500">文章总数</div>
        <div class="mt-3 h-1.5 bg-stone-100 rounded-full overflow-hidden">
          <div class="h-full bg-emerald-500 rounded-full transition-all duration-1500" id="bar-posts" style="width: 0%"></div>
        </div>
      </div>

      <div class="bg-white rounded-2xl p-6 border border-stone-200 shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-2">
        <div class="flex items-center justify-between mb-4">
          <div class="w-12 h-12 bg-blue-50 rounded-xl flex items-center justify-center">
            <span class="text-2xl">👀</span>
          </div>
          <span class="text-xs text-blue-500 font-medium bg-blue-50 px-2 py-1 rounded-full">+28%</span>
        </div>
        <div class="text-3xl font-bold text-stone-900 mb-1" id="counter-views">0</div>
        <div class="text-sm text-stone-500">总访问量</div>
        <div class="mt-3 h-1.5 bg-stone-100 rounded-full overflow-hidden">
          <div class="h-full bg-blue-500 rounded-full transition-all duration-1500" id="bar-views" style="width: 0%"></div>
        </div>
      </div>

      <div class="bg-white rounded-2xl p-6 border border-stone-200 shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-2">
        <div class="flex items-center justify-between mb-4">
          <div class="w-12 h-12 bg-pink-50 rounded-xl flex items-center justify-center">
            <span class="text-2xl">❤️</span>
          </div>
          <span class="text-xs text-pink-500 font-medium bg-pink-50 px-2 py-1 rounded-full">+35%</span>
        </div>
        <div class="text-3xl font-bold text-stone-900 mb-1" id="counter-likes">0</div>
        <div class="text-sm text-stone-500">获赞总数</div>
        <div class="mt-3 h-1.5 bg-stone-100 rounded-full overflow-hidden">
          <div class="h-full bg-pink-500 rounded-full transition-all duration-1500" id="bar-likes" style="width: 0%"></div>
        </div>
      </div>

      <div class="bg-white rounded-2xl p-6 border border-stone-200 shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-2">
        <div class="flex items-center justify-between mb-4">
          <div class="w-12 h-12 bg-purple-50 rounded-xl flex items-center justify-center">
            <span class="text-2xl">💬</span>
          </div>
          <span class="text-xs text-purple-500 font-medium bg-purple-50 px-2 py-1 rounded-full">+18%</span>
        </div>
        <div class="text-3xl font-bold text-stone-900 mb-1" id="counter-comments">0</div>
        <div class="text-sm text-stone-500">评论总数</div>
        <div class="mt-3 h-1.5 bg-stone-100 rounded-full overflow-hidden">
          <div class="h-full bg-purple-500 rounded-full transition-all duration-1500" id="bar-comments" style="width: 0%"></div>
        </div>
      </div>
    </div>

    <!-- 图表区域 -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-12">
      <!-- 趋势图 -->
      <div class="bg-white rounded-2xl p-6 border border-stone-200 shadow-sm">
        <h3 class="text-lg font-bold text-stone-900 mb-6 flex items-center gap-2">
          <span class="text-xl">📈</span> 访问趋势
        </h3>
        <div class="h-64">
          <canvas id="trendChart"></canvas>
        </div>
      </div>

      <!-- 雷达图 -->
      <div class="bg-white rounded-2xl p-6 border border-stone-200 shadow-sm">
        <h3 class="text-lg font-bold text-stone-900 mb-6 flex items-center gap-2">
          <span class="text-xl">🎯</span> 技能雷达
        </h3>
        <div class="h-64">
          <canvas id="radarChart"></canvas>
        </div>
      </div>
    </div>

    <!-- 标签、分类、热门文章 -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
      <!-- 标签云 -->
      <div class="bg-white rounded-2xl p-6 border border-stone-200 shadow-sm">
        <h3 class="text-lg font-bold text-stone-900 mb-6 flex items-center gap-2">
          <span class="text-xl">🏷️</span> 热门标签
        </h3>
        <div class="flex flex-wrap gap-2" id="tagCloud"></div>
      </div>

      <!-- 分类 -->
      <div class="bg-white rounded-2xl p-6 border border-stone-200 shadow-sm">
        <h3 class="text-lg font-bold text-stone-900 mb-6 flex items-center gap-2">
          <span class="text-xl">📊</span> 分类统计
        </h3>
        <div class="h-48">
          <canvas id="pieChart"></canvas>
        </div>
      </div>

      <!-- 热门文章 -->
      <div class="bg-white rounded-2xl p-6 border border-stone-200 shadow-sm">
        <h3 class="text-lg font-bold text-stone-900 mb-6 flex items-center gap-2">
          <span class="text-xl">🔥</span> 热门文章
        </h3>
        <div class="space-y-3" id="popularPosts"></div>
      </div>
    </div>

    <!-- 热力图 -->
    <div class="bg-white rounded-2xl p-6 border border-stone-200 shadow-sm">
      <h3 class="text-lg font-bold text-stone-900 mb-6 flex items-center gap-2">
        <span class="text-xl">📅</span> 发布热力图
      </h3>
      <div class="overflow-x-auto" id="heatmap"></div>
    </div>
  </div>
</section>

<script is:inline>
// 等待 DOM 加载完成
document.addEventListener('DOMContentLoaded', function() {
  console.log('Dashboard script loaded');

  // ========== 数据 ==========
  var data = {
    posts: 128,
    views: 45600,
    likes: 3256,
    comments: 892,
    tags: [
      { name: 'Astro', count: 24 },
      { name: 'React', count: 18 },
      { name: 'TypeScript', count: 15 },
      { name: 'Tailwind', count: 12 },
      { name: 'Node.js', count: 10 },
      { name: 'CSS', count: 8 }
    ],
    categories: [
      { name: '前端工程', count: 45, color: '#10b981' },
      { name: '后端开发', count: 25, color: '#3b82f6' },
      { name: '算法', count: 20, color: '#f59e0b' },
      { name: '设计', count: 10, color: '#ec4899' }
    ],
    popularPosts: [
      { title: 'Astro 岛屿架构详解', views: 3245, likes: 287 },
      { title: 'React Hooks 最佳实践', views: 2891, likes: 245 },
      { title: 'Tailwind CSS 进阶技巧', views: 2456, likes: 198 },
      { title: 'TypeScript 类型体操', views: 2134, likes: 176 },
      { title: '算法面试高频题', views: 1987, likes: 165 }
    ]
  };

  // ========== 数字动画 ==========
  function animateCounter(id, target, duration) {
    var el = document.getElementById(id);
    if (!el) {
      console.log('Element not found:', id);
      return;
    }

    var start = 0;
    var startTime = null;

    function update(timestamp) {
      if (!startTime) startTime = timestamp;
      var progress = Math.min((timestamp - startTime) / duration, 1);
      var easeOut = 1 - Math.pow(1 - progress, 4);
      var current = Math.floor(easeOut * target);

      if (target >= 10000) {
        el.textContent = (current / 1000).toFixed(1) + 'K';
      } else {
        el.textContent = current.toLocaleString();
      }

      if (progress < 1) {
        requestAnimationFrame(update);
      }
    }

    requestAnimationFrame(update);
  }

  // ========== 进度条动画 ==========
  function animateBar(id, width) {
    var el = document.getElementById(id);
    if (!el) return;

    setTimeout(function() {
      el.style.width = width + '%';
    }, 300);
  }

  // ========== 粒子背景 ==========
  function initParticles() {
    var canvas = document.getElementById('particleBg');
    if (!canvas) {
      console.log('Particle canvas not found');
      return;
    }

    var ctx = canvas.getContext('2d');
    if (!ctx) {
      console.log('Cannot get canvas context');
      return;
    }

    console.log('Initializing particles');

    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;

    var particles = [];
    var mouse = { x: null, y: null };
    var colors = ['#10b981', '#3b82f6', '#f59e0b', '#ec4899', '#8b5cf6'];

    // 创建粒子
    for (var i = 0; i < 40; i++) {
      particles.push({
        x: Math.random() * canvas.width,
        y: Math.random() * canvas.height,
        size: Math.random() * 3 + 1,
        speedX: (Math.random() - 0.5) * 1,
        speedY: (Math.random() - 0.5) * 1,
        color: colors[Math.floor(Math.random() * colors.length)],
        opacity: Math.random() * 0.3 + 0.1
      });
    }

    window.addEventListener('resize', function() {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
    });

    document.addEventListener('mousemove', function(e) {
      mouse.x = e.clientX;
      mouse.y = e.clientY;
    });

    document.addEventListener('click', function(e) {
      for (var i = 0; i < 10; i++) {
        particles.push({
          x: e.clientX,
          y: e.clientY,
          size: Math.random() * 4 + 1,
          speedX: (Math.random() - 0.5) * 6,
          speedY: (Math.random() - 0.5) * 6,
          color: colors[Math.floor(Math.random() * colors.length)],
          opacity: 0.8,
          life: 0,
          maxLife: 30
        });
      }
    });

    function animate() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      var alive = [];
      for (var i = 0; i < particles.length; i++) {
        var p = particles[i];

        // 鼠标交互
        if (mouse.x !== null && !p.life) {
          var dx = mouse.x - p.x;
          var dy = mouse.y - p.y;
          var dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < 150) {
            var force = (150 - dist) / 150;
            p.x -= (dx / dist) * force * 2;
            p.y -= (dy / dist) * force * 2;
          }
        }

        p.x += p.speedX;
        p.y += p.speedY;

        // 生命周期
        if (p.life !== undefined) {
          p.life++;
          if (p.life >= p.maxLife) continue;
          p.opacity = 1 - (p.life / p.maxLife);
        }

        // 边界反弹
        if (p.x < 0 || p.x > canvas.width) p.speedX *= -1;
        if (p.y < 0 || p.y > canvas.height) p.speedY *= -1;

        // 绘制粒子
        ctx.globalAlpha = p.opacity;
        ctx.fillStyle = p.color;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
        ctx.fill();

        alive.push(p);

        // 连线
        if (!p.life) {
          for (var j = i + 1; j < particles.length; j++) {
            var other = particles[j];
            if (other.life) continue;
            var dx = p.x - other.x;
            var dy = p.y - other.y;
            var dist = Math.sqrt(dx * dx + dy * dy);
            if (dist < 100) {
              ctx.globalAlpha = (1 - dist / 100) * 0.15;
              ctx.strokeStyle = '#10b981';
              ctx.lineWidth = 0.5;
              ctx.beginPath();
              ctx.moveTo(p.x, p.y);
              ctx.lineTo(other.x, other.y);
              ctx.stroke();
            }
          }
        }
      }
      particles = alive;

      // 限制粒子数量
      if (particles.length > 80) {
        particles = particles.slice(-80);
      }

      ctx.globalAlpha = 1;
      requestAnimationFrame(animate);
    }

    animate();
    console.log('Particles initialized');
  }

  // ========== 折线图 ==========
  function drawLineChart() {
    var canvas = document.getElementById('trendChart');
    if (!canvas) {
      console.log('Trend chart canvas not found');
      return;
    }

    var ctx = canvas.getContext('2d');
    var rect = canvas.parentElement.getBoundingClientRect();
    canvas.width = rect.width;
    canvas.height = rect.height;

    console.log('Drawing line chart:', canvas.width, canvas.height);

    var padding = { top: 20, right: 20, bottom: 30, left: 40 };
    var width = canvas.width - padding.left - padding.right;
    var height = canvas.height - padding.top - padding.bottom;

    var data2024 = [1200, 1900, 2500, 3200, 3800, 4200, 4800, 5200, 5800, 6200, 6800, 7200];
    var data2025 = [2800, 3500, 4200, 5800, 7200, 8500, 9200, 10500, 11800, 13200, 14800, 16200];
    var labels = ['1月', '2月', '3月', '4月', '5月', '6月', '7月', '8月', '9月', '10月', '11月', '12月'];
    var maxVal = 18000;

    // 网格
    ctx.strokeStyle = 'rgba(0,0,0,0.05)';
    ctx.lineWidth = 1;
    for (var i = 0; i <= 4; i++) {
      var y = padding.top + (height / 4) * i;
      ctx.beginPath();
      ctx.moveTo(padding.left, y);
      ctx.lineTo(canvas.width - padding.right, y);
      ctx.stroke();

      ctx.fillStyle = '#9ca3af';
      ctx.font = '10px sans-serif';
      ctx.textAlign = 'right';
      ctx.fillText(((maxVal / 4) * (4 - i) / 1000).toFixed(0) + 'K', padding.left - 5, y + 4);
    }

    // X轴标签
    ctx.textAlign = 'center';
    labels.forEach(function(label, i) {
      var x = padding.left + (width / 11) * i;
      ctx.fillText(label, x, canvas.height - 10);
    });

    // 2024线
    ctx.beginPath();
    ctx.strokeStyle = 'rgba(16, 185, 129, 0.3)';
    ctx.lineWidth = 2;
    data2024.forEach(function(val, i) {
      var x = padding.left + (width / 11) * i;
      var y = padding.top + height - (val / maxVal) * height;
      if (i === 0) ctx.moveTo(x, y);
      else ctx.lineTo(x, y);
    });
    ctx.stroke();

    // 2025线
    ctx.beginPath();
    ctx.strokeStyle = '#10b981';
    ctx.lineWidth = 3;
    data2025.forEach(function(val, i) {
      var x = padding.left + (width / 11) * i;
      var y = padding.top + height - (val / maxVal) * height;
      if (i === 0) ctx.moveTo(x, y);
      else ctx.lineTo(x, y);
    });
    ctx.stroke();

    // 数据点
    data2025.forEach(function(val, i) {
      var x = padding.left + (width / 11) * i;
      var y = padding.top + height - (val / maxVal) * height;
      ctx.beginPath();
      ctx.arc(x, y, 4, 0, Math.PI * 2);
      ctx.fillStyle = '#10b981';
      ctx.fill();
      ctx.strokeStyle = '#fff';
      ctx.lineWidth = 2;
      ctx.stroke();
    });
  }

  // ========== 雷达图 ==========
  function drawRadarChart() {
    var canvas = document.getElementById('radarChart');
    if (!canvas) return;

    var ctx = canvas.getContext('2d');
    var rect = canvas.parentElement.getBoundingClientRect();
    canvas.width = rect.width;
    canvas.height = rect.height;

    var centerX = canvas.width / 2;
    var centerY = canvas.height / 2;
    var radius = Math.min(centerX, centerY) - 40;
    var labels = ['前端开发', '后端开发', 'UI/UX', '技术写作', '算法', 'DevOps'];
    var values = [90, 75, 70, 85, 80, 65];

    // 网格
    for (var i = 1; i <= 5; i++) {
      var r = (radius / 5) * i;
      ctx.beginPath();
      for (var j = 0; j < 6; j++) {
        var angle = (Math.PI * 2 * j) / 6 - Math.PI / 2;
        var x = centerX + Math.cos(angle) * r;
        var y = centerY + Math.sin(angle) * r;
        if (j === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      }
      ctx.closePath();
      ctx.strokeStyle = 'rgba(16, 185, 129, 0.15)';
      ctx.stroke();
    }

    // 轴线
    for (var i = 0; i < 6; i++) {
      var angle = (Math.PI * 2 * i) / 6 - Math.PI / 2;
      ctx.beginPath();
      ctx.moveTo(centerX, centerY);
      ctx.lineTo(centerX + Math.cos(angle) * radius, centerY + Math.sin(angle) * radius);
      ctx.strokeStyle = 'rgba(16, 185, 129, 0.2)';
      ctx.stroke();

      // 标签
      var lx = centerX + Math.cos(angle) * (radius + 20);
      var ly = centerY + Math.sin(angle) * (radius + 20);
      ctx.fillStyle = '#374151';
      ctx.font = '11px sans-serif';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText(labels[i], lx, ly);
    }

    // 数据区域
    ctx.beginPath();
    values.forEach(function(val, i) {
      var angle = (Math.PI * 2 * i) / 6 - Math.PI / 2;
      var x = centerX + Math.cos(angle) * (radius * val / 100);
      var y = centerY + Math.sin(angle) * (radius * val / 100);
      if (i === 0) ctx.moveTo(x, y);
      else ctx.lineTo(x, y);
    });
    ctx.closePath();
    ctx.fillStyle = 'rgba(16, 185, 129, 0.2)';
    ctx.fill();
    ctx.strokeStyle = '#10b981';
    ctx.lineWidth = 2;
    ctx.stroke();

    // 数据点
    values.forEach(function(val, i) {
      var angle = (Math.PI * 2 * i) / 6 - Math.PI / 2;
      var x = centerX + Math.cos(angle) * (radius * val / 100);
      var y = centerY + Math.sin(angle) * (radius * val / 100);
      ctx.beginPath();
      ctx.arc(x, y, 4, 0, Math.PI * 2);
      ctx.fillStyle = '#10b981';
      ctx.fill();
    });
  }

  // ========== 饼图 ==========
  function drawPieChart() {
    var canvas = document.getElementById('pieChart');
    if (!canvas) return;

    var ctx = canvas.getContext('2d');
    canvas.width = canvas.parentElement.offsetWidth;
    canvas.height = 192;

    var centerX = canvas.width / 2;
    var centerY = canvas.height / 2;
    var radius = Math.min(centerX, centerY) - 10;
    var total = data.categories.reduce(function(sum, c) { return sum + c.count; }, 0);
    var startAngle = -Math.PI / 2;

    data.categories.forEach(function(cat) {
      var sliceAngle = (cat.count / total) * Math.PI * 2;
      ctx.beginPath();
      ctx.moveTo(centerX, centerY);
      ctx.arc(centerX, centerY, radius, startAngle, startAngle + sliceAngle);
      ctx.closePath();
      ctx.fillStyle = cat.color;
      ctx.fill();

      // 标签
      var midAngle = startAngle + sliceAngle / 2;
      var lx = centerX + Math.cos(midAngle) * (radius * 0.6);
      var ly = centerY + Math.sin(midAngle) * (radius * 0.6);
      if (cat.count / total > 0.08) {
        ctx.fillStyle = '#fff';
        ctx.font = 'bold 11px sans-serif';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText(cat.name, lx, ly);
      }

      startAngle += sliceAngle;
    });
  }

  // ========== 标签云 ==========
  function renderTagCloud() {
    var container = document.getElementById('tagCloud');
    if (!container) return;

    var maxCount = Math.max.apply(null, data.tags.map(function(t) { return t.count; }));
    var colors = ['#10b981', '#3b82f6', '#f59e0b', '#ec4899', '#8b5cf6', '#06b6d4'];

    container.innerHTML = data.tags.map(function(tag, i) {
      var size = 12 + (tag.count / maxCount) * 14;
      var color = colors[i % colors.length];
      return '<span class="inline-block px-3 py-1 rounded-full cursor-pointer transition-all hover:scale-110" ' +
        'style="font-size:' + size + 'px; background:' + color + '15; color:' + color + '; border:1px solid ' + color + '30">' +
        tag.name + '</span>';
    }).join('');
  }

  // ========== 热门文章 ==========
  function renderPopularPosts() {
    var container = document.getElementById('popularPosts');
    if (!container) return;

    container.innerHTML = data.popularPosts.map(function(post, i) {
      var medal = ['🥇', '🥈', '🥉', '4️⃣', '5️⃣'][i];
      return '<div class="flex items-center gap-3 p-2 rounded-lg hover:bg-stone-50 transition-colors">' +
        '<span class="text-lg">' + medal + '</span>' +
        '<div class="flex-1 min-w-0">' +
        '<div class="font-medium text-sm text-stone-900 truncate">' + post.title + '</div>' +
        '<div class="text-xs text-stone-500">👁 ' + (post.views / 1000).toFixed(1) + 'K · ❤️ ' + post.likes + '</div>' +
        '</div></div>';
    }).join('');
  }

  // ========== 热力图 ==========
  function renderHeatmap() {
    var container = document.getElementById('heatmap');
    if (!container) return;

    var today = new Date();
    var weeks = [];
    var currentWeek = [];

    for (var i = 364; i >= 0; i--) {
      var date = new Date(today);
      date.setDate(date.getDate() - i);
      var dayOfWeek = date.getDay();

      if (dayOfWeek === 0 && currentWeek.length > 0) {
        weeks.push(currentWeek);
        currentWeek = [];
      }

      currentWeek.push({
        date: date.toISOString().split('T')[0],
        count: Math.floor(Math.random() * 5)
      });
    }
    if (currentWeek.length > 0) weeks.push(currentWeek);

    var html = '<div class="flex gap-0.5">';
    weeks.forEach(function(week) {
      html += '<div class="flex flex-col gap-0.5">';
      week.forEach(function(day) {
        var color = day.count === 0 ? '#ebedf0' :
          day.count === 1 ? '#9be9a8' :
          day.count === 2 ? '#40c463' :
          day.count === 3 ? '#30a14e' : '#216e39';
        html += '<div class="w-2.5 h-2.5 rounded-sm cursor-pointer hover:ring-2 hover:ring-emerald-400" ' +
          'style="background:' + color + '" title="' + day.date + ': ' + day.count + '"></div>';
      });
      html += '</div>';
    });
    html += '</div>';

    container.innerHTML = html;
  }

  // ========== 启动 ==========
  console.log('Starting dashboard initialization');

  // 数字动画
  animateCounter('counter-posts', data.posts, 1500);
  animateCounter('counter-views', data.views, 2000);
  animateCounter('counter-likes', data.likes, 1800);
  animateCounter('counter-comments', data.comments, 1600);

  // 进度条
  animateBar('bar-posts', 85);
  animateBar('bar-views', 92);
  animateBar('bar-likes', 78);
  animateBar('bar-comments', 65);

  // 粒子
  initParticles();

  // 图表 - 延迟绘制确保 canvas 尺寸正确
  setTimeout(function() {
    drawLineChart();
    drawRadarChart();
    drawPieChart();
  }, 100);

  // 其他
  renderTagCloud();
  renderPopularPosts();
  renderHeatmap();

  // 窗口大小改变时重绘
  window.addEventListener('resize', function() {
    drawLineChart();
    drawRadarChart();
    drawPieChart();
  });

  console.log('Dashboard initialization complete');
});
</script>
