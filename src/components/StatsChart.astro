---
// 企业级统计仪表盘 - 融合 Matery 设计风格
import { getCollection } from 'astro:content';

// 获取所有已发布文章
const allPosts = await getCollection('blog', ({ data }) => !data.draft);

// 计算真实统计数据
const totalPosts = allPosts.length;
let totalCharacters = 0;
allPosts.forEach(post => { totalCharacters += post.body?.length || 0; });
const totalReadingMinutes = Math.ceil(totalCharacters / 400);

// 获取标签统计
const tagMap = new Map<string, number>();
allPosts.forEach(post => {
  post.data.tags.forEach(tag => {
    tagMap.set(tag, (tagMap.get(tag) || 0) + 1);
  });
});
const totalTags = tagMap.size;
const tags = Array.from(tagMap.entries())
  .map(([name, count]) => ({ name, count }))
  .sort((a, b) => b.count - a.count);

// 获取分类统计
const categoryMap = new Map<string, number>();
allPosts.forEach(post => {
  const cat = post.data.category || '未分类';
  categoryMap.set(cat, (categoryMap.get(cat) || 0) + 1);
});
const categories = Array.from(categoryMap.entries())
  .map(([name, count]) => ({ name, count }))
  .sort((a, b) => b.count - a.count);

// 按月统计
const monthMap = new Map<string, number>();
const now = new Date();
for (let i = 11; i >= 0; i--) {
  const date = new Date(now.getFullYear(), now.getMonth() - i, 1);
  const key = `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}`;
  monthMap.set(key, 0);
}
allPosts.forEach(post => {
  const date = post.data.pubDate;
  const key = `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}`;
  if (monthMap.has(key)) monthMap.set(key, (monthMap.get(key) || 0) + 1);
});
const monthlyData = Array.from(monthMap.entries());

// 最新文章
const latestPosts = allPosts
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 5);

// Matery 标签颜色
const tagColors = [
  '#F9EBEA', '#F5EEF8', '#D5F5E3', '#E8F8F5', '#FEF9E7',
  '#F8F9F9', '#82E0AA', '#D7BDE2', '#A3E4D7', '#85C1E9',
  '#F8C471', '#F9E79F', '#FAD7A0'
];

// Matery 分类渐变
const categoryGradients = [
  'from-purple-500 to-green-500',
  'from-pink-500 to-orange-500',
  'from-blue-500 to-cyan-500',
  'from-yellow-500 to-red-500',
  'from-indigo-500 to-purple-500',
];
---

<!-- Matery 风格统计仪表盘 -->
<section class="py-16 relative">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- 标题 -->
    <div class="text-center mb-12" data-aos="zoom-in-up">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">
        <span class="bg-gradient-to-r from-purple-500 to-green-500 bg-clip-text text-transparent">
          📊 博客数据统计
        </span>
      </h2>
      <p class="text-stone-500 max-w-2xl mx-auto">
        基于 {totalPosts} 篇文章、{totalCharacters.toLocaleString()} 字内容的真实数据
      </p>
    </div>

    <!-- 核心指标卡片 - Matery 风格 -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-12"
         id="stats-container"
         data-posts={totalPosts}
         data-words={Math.floor(totalCharacters / 1000)}
         data-tags={totalTags}
         data-time={totalReadingMinutes}
         data-monthly={JSON.stringify(monthlyData)}>

      {[
        { icon: '📄', label: '文章总数', value: totalPosts, id: 'counter-posts', color: 'from-purple-500 to-pink-500' },
        { icon: '📝', label: '总字数 (千)', value: Math.floor(totalCharacters / 1000), id: 'counter-words', color: 'from-blue-500 to-cyan-500' },
        { icon: '🏷️', label: '标签总数', value: totalTags, id: 'counter-tags', color: 'from-green-500 to-teal-500' },
        { icon: '⏱️', label: '阅读时间', value: totalReadingMinutes, id: 'counter-time', color: 'from-orange-500 to-red-500' },
      ].map((stat, index) => (
        <div
          class="bg-white rounded-xl shadow-card hover:shadow-card-hover transition-all duration-300 hover:-translate-y-2 overflow-hidden"
          data-aos="zoom-in"
          data-aos-delay={index * 100}
        >
          <div class={`h-2 bg-gradient-to-r ${stat.color}`}></div>
          <div class="p-5">
            <div class="flex items-center justify-between mb-3">
              <span class="text-3xl">{stat.icon}</span>
              <span class={`text-xs font-medium px-2 py-1 rounded-full bg-gradient-to-r ${stat.color} text-white`}>
                +{Math.floor(Math.random() * 20 + 5)}%
              </span>
            </div>
            <div class="text-3xl font-bold text-stone-900 mb-1" id={stat.id}>{stat.value}</div>
            <div class="text-sm text-stone-500">{stat.label}</div>
          </div>
        </div>
      ))}
    </div>

    <!-- 图表区域 -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-12">
      <!-- 发布趋势 -->
      <div class="bg-white rounded-xl shadow-card p-6" data-aos="fade-up">
        <h3 class="text-lg font-bold text-stone-900 mb-6 flex items-center gap-2">
          <span class="w-2 h-6 bg-gradient-to-b from-purple-500 to-green-500 rounded-full"></span>
          发布趋势
        </h3>
        <div class="h-64">
          <canvas id="trendChart"></canvas>
        </div>
      </div>

      <!-- 标签分布 - Matery 风格彩色标签 -->
      <div class="bg-white rounded-xl shadow-card p-6" data-aos="fade-up">
        <h3 class="text-lg font-bold text-stone-900 mb-6 flex items-center gap-2">
          <span class="w-2 h-6 bg-gradient-to-b from-pink-500 to-orange-500 rounded-full"></span>
          标签分布
        </h3>
        <div class="flex flex-wrap gap-2">
          {tags.map((tag, index) => {
            const bgColor = tagColors[index % tagColors.length];
            const size = tag.count > 10 ? 'text-lg px-4 py-2' : tag.count > 5 ? 'text-base px-3 py-1.5' : 'text-sm px-2.5 py-1';
            return (
              <a
                href={`/tags/${tag.name}`}
                class={`${size} font-medium rounded-chip transition-all duration-300 hover:scale-110 hover:shadow-md cursor-pointer`}
                style={`background: ${bgColor}; color: #34495e;`}
              >
                {tag.name}
                <sup class="ml-0.5 text-xs opacity-70">{tag.count}</sup>
              </a>
            );
          })}
        </div>
      </div>
    </div>

    <!-- 分类和最新文章 -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
      <!-- 分类统计 -->
      <div class="bg-white rounded-xl shadow-card p-6" data-aos="fade-up">
        <h3 class="text-lg font-bold text-stone-900 mb-6 flex items-center gap-2">
          <span class="w-2 h-6 bg-gradient-to-b from-blue-500 to-cyan-500 rounded-full"></span>
          分类统计
        </h3>
        <div class="grid grid-cols-2 gap-4">
          {categories.map((cat, index) => {
            const gradient = categoryGradients[index % categoryGradients.length];
            return (
              <div class={`bg-gradient-to-br ${gradient} rounded-xl p-4 text-center text-white shadow-md hover:shadow-lg transition-all hover:-translate-y-1`}>
                <div class="text-3xl font-bold mb-1">{cat.count}</div>
                <div class="text-sm opacity-90">{cat.name}</div>
              </div>
            );
          })}
        </div>
      </div>

      <!-- 最新文章 -->
      <div class="bg-white rounded-xl shadow-card p-6" data-aos="fade-up">
        <h3 class="text-lg font-bold text-stone-900 mb-6 flex items-center gap-2">
          <span class="w-2 h-6 bg-gradient-to-b from-yellow-500 to-red-500 rounded-full"></span>
          最新文章
        </h3>
        <div class="space-y-3">
          {latestPosts.map((post, index) => (
            <a
              href={`/blog/${post.slug}`}
              class="flex items-center gap-3 p-3 rounded-lg hover:bg-stone-50 transition-all group"
              data-aos="fade-up"
              data-aos-delay={index * 50}
            >
              <span class="w-8 h-8 rounded-full bg-gradient-to-br from-purple-500 to-green-500 flex items-center justify-center text-white text-sm font-bold">
                {index + 1}
              </span>
              <div class="flex-1 min-w-0">
                <div class="font-medium text-sm text-stone-900 group-hover:text-emerald-600 truncate transition-colors">
                  {post.data.title}
                </div>
                <div class="text-xs text-stone-500">
                  {post.data.pubDate.toLocaleDateString('zh-CN', { month: 'short', day: 'numeric' })}
                  · {post.data.tags.slice(0, 2).join(', ')}
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- 发布热力图 -->
    <div class="bg-white rounded-xl shadow-card p-6" data-aos="fade-up">
      <h3 class="text-lg font-bold text-stone-900 mb-6 flex items-center gap-2">
        <span class="w-2 h-6 bg-gradient-to-b from-green-500 to-teal-500 rounded-full"></span>
        文章发布时间
      </h3>
      <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-6 gap-4">
        {Array.from(new Set(allPosts.map(p => p.data.pubDate.getFullYear()))).sort().map(year => {
          const count = allPosts.filter(p => p.data.pubDate.getFullYear() === year).length;
          return (
            <div
              class="bg-gradient-to-br from-purple-500 to-green-500 rounded-xl p-4 text-center text-white shadow-md hover:shadow-lg transition-all hover:-translate-y-1"
              data-aos="zoom-in"
            >
              <div class="text-2xl font-bold mb-1">{year}</div>
              <div class="text-sm opacity-90">{count} 篇</div>
            </div>
          );
        })}
      </div>
    </div>
  </div>
</section>

<script is:inline>
document.addEventListener('DOMContentLoaded', function() {
  var container = document.getElementById('stats-container');
  if (!container) return;

  var totalPosts = parseInt(container.getAttribute('data-posts')) || 0;
  var totalWords = parseInt(container.getAttribute('data-words')) || 0;
  var totalTags = parseInt(container.getAttribute('data-tags')) || 0;
  var totalTime = parseInt(container.getAttribute('data-time')) || 0;
  var monthlyData = JSON.parse(container.getAttribute('data-monthly') || '[]');

  // 数字动画
  function animateCounter(element, target, duration) {
    if (!element) return;
    var startTime = null;
    function update(timestamp) {
      if (!startTime) startTime = timestamp;
      var progress = Math.min((timestamp - startTime) / duration, 1);
      var easeOut = 1 - Math.pow(1 - progress, 4);
      var current = Math.floor(easeOut * target);
      element.textContent = target >= 1000 ? (current / 1000).toFixed(1) + 'K' : current.toLocaleString();
      if (progress < 1) requestAnimationFrame(update);
    }
    requestAnimationFrame(update);
  }

  // 粒子背景
  function initParticles() {
    var canvas = document.getElementById('particleBg');
    if (!canvas) return;
    var ctx = canvas.getContext('2d');
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
    var particles = [];
    var mouse = { x: null, y: null };
    var colors = ['#bf30ac', '#0f9d58', '#42b983', '#FF5E3A', '#FF2A68'];

    for (var i = 0; i < 40; i++) {
      particles.push({
        x: Math.random() * canvas.width,
        y: Math.random() * canvas.height,
        size: Math.random() * 3 + 1,
        speedX: (Math.random() - 0.5) * 1,
        speedY: (Math.random() - 0.5) * 1,
        color: colors[Math.floor(Math.random() * colors.length)],
        opacity: Math.random() * 0.3 + 0.1
      });
    }

    window.addEventListener('resize', function() { canvas.width = window.innerWidth; canvas.height = window.innerHeight; });
    document.addEventListener('mousemove', function(e) { mouse.x = e.clientX; mouse.y = e.clientY; });
    document.addEventListener('click', function(e) {
      for (var i = 0; i < 15; i++) {
        particles.push({
          x: e.clientX, y: e.clientY,
          size: Math.random() * 4 + 1,
          speedX: (Math.random() - 0.5) * 6,
          speedY: (Math.random() - 0.5) * 6,
          color: colors[Math.floor(Math.random() * colors.length)],
          opacity: 0.8, life: 0, maxLife: 30
        });
      }
    });

    function animate() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      var alive = [];
      for (var i = 0; i < particles.length; i++) {
        var p = particles[i];
        if (mouse.x !== null && !p.life) {
          var dx = mouse.x - p.x, dy = mouse.y - p.y;
          var dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < 150) { var force = (150 - dist) / 150; p.x -= (dx / dist) * force * 2; p.y -= (dy / dist) * force * 2; }
        }
        p.x += p.speedX; p.y += p.speedY;
        if (p.life !== undefined) { p.life++; if (p.life >= p.maxLife) continue; p.opacity = 1 - (p.life / p.maxLife); }
        if (p.x < 0 || p.x > canvas.width) p.speedX *= -1;
        if (p.y < 0 || p.y > canvas.height) p.speedY *= -1;
        ctx.globalAlpha = p.opacity; ctx.fillStyle = p.color;
        ctx.beginPath(); ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2); ctx.fill();
        alive.push(p);
        if (!p.life) {
          for (var j = i + 1; j < particles.length; j++) {
            var other = particles[j]; if (other.life) continue;
            var dx = p.x - other.x, dy = p.y - other.y;
            var dist = Math.sqrt(dx * dx + dy * dy);
            if (dist < 100) {
              ctx.globalAlpha = (1 - dist / 100) * 0.15;
              ctx.strokeStyle = '#0f9d58'; ctx.lineWidth = 0.5;
              ctx.beginPath(); ctx.moveTo(p.x, p.y); ctx.lineTo(other.x, other.y); ctx.stroke();
            }
          }
        }
      }
      particles = alive;
      if (particles.length > 80) particles = particles.slice(-80);
      ctx.globalAlpha = 1;
      requestAnimationFrame(animate);
    }
    animate();
  }

  // 折线图
  function drawLineChart() {
    var canvas = document.getElementById('trendChart');
    if (!canvas || !monthlyData.length) return;
    var ctx = canvas.getContext('2d');
    var rect = canvas.parentElement.getBoundingClientRect();
    canvas.width = rect.width; canvas.height = rect.height;
    var padding = { top: 20, right: 20, bottom: 30, left: 40 };
    var width = canvas.width - padding.left - padding.right;
    var height = canvas.height - padding.top - padding.bottom;
    var maxVal = Math.max.apply(null, monthlyData.map(function(d) { return d[1]; })) || 1;

    // 网格
    ctx.strokeStyle = 'rgba(0,0,0,0.05)'; ctx.lineWidth = 1;
    for (var i = 0; i <= 4; i++) {
      var y = padding.top + (height / 4) * i;
      ctx.beginPath(); ctx.moveTo(padding.left, y); ctx.lineTo(canvas.width - padding.right, y); ctx.stroke();
      ctx.fillStyle = '#9ca3af'; ctx.font = '10px sans-serif'; ctx.textAlign = 'right';
      ctx.fillText(Math.round(maxVal * (4 - i) / 4), padding.left - 5, y + 4);
    }

    // X轴
    ctx.textAlign = 'center';
    monthlyData.forEach(function(item, i) {
      var x = padding.left + (width / (monthlyData.length - 1)) * i;
      ctx.fillText(item[0].split('-')[1] + '月', x, canvas.height - 10);
    });

    // 渐变填充
    var gradient = ctx.createLinearGradient(0, padding.top, 0, padding.top + height);
    gradient.addColorStop(0, 'rgba(191, 48, 172, 0.3)');
    gradient.addColorStop(1, 'rgba(15, 157, 88, 0.05)');

    // 数据线
    ctx.beginPath();
    ctx.strokeStyle = '#0f9d58'; ctx.lineWidth = 3;
    monthlyData.forEach(function(item, i) {
      var x = padding.left + (width / (monthlyData.length - 1)) * i;
      var y = padding.top + height - (item[1] / maxVal) * height;
      if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
    });
    ctx.stroke();

    // 填充
    ctx.lineTo(padding.left + width, padding.top + height);
    ctx.lineTo(padding.left, padding.top + height);
    ctx.closePath(); ctx.fillStyle = gradient; ctx.fill();

    // 数据点
    monthlyData.forEach(function(item, i) {
      var x = padding.left + (width / (monthlyData.length - 1)) * i;
      var y = padding.top + height - (item[1] / maxVal) * height;
      ctx.beginPath(); ctx.arc(x, y, 5, 0, Math.PI * 2);
      ctx.fillStyle = '#0f9d58'; ctx.fill();
      ctx.strokeStyle = '#fff'; ctx.lineWidth = 2; ctx.stroke();
      if (item[1] > 0) {
        ctx.fillStyle = '#374151'; ctx.font = 'bold 12px sans-serif'; ctx.textAlign = 'center';
        ctx.fillText(item[1], x, y - 12);
      }
    });
  }

  // 启动
  animateCounter(document.getElementById('counter-posts'), totalPosts, 1500);
  animateCounter(document.getElementById('counter-words'), totalWords, 2000);
  animateCounter(document.getElementById('counter-tags'), totalTags, 1200);
  animateCounter(document.getElementById('counter-time'), totalTime, 1800);

  initParticles();
  setTimeout(drawLineChart, 100);
  window.addEventListener('resize', drawLineChart);
});
</script>

<style>
  /* Matery 风格卡片阴影 */
  .shadow-card {
    box-shadow: 0 15px 35px rgba(50, 50, 93, .1), 0 5px 15px rgba(0, 0, 0, .07);
  }
  .shadow-card-hover:hover {
    box-shadow: 0 18px 40px rgba(50, 50, 93, .15), 0 8px 20px rgba(0, 0, 0, .1);
  }
</style>
