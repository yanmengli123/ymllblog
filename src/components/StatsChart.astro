---
// 统计数据组件
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="py-20 relative overflow-hidden">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- 标题 -->
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-stone-900 mb-4">
        博客<span class="gradient-text">数据统计</span>
      </h2>
      <p class="text-stone-500 max-w-2xl mx-auto">
        实时追踪博客运营数据，见证每一次成长
      </p>
    </div>

    <!-- 数据卡片 -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-12">
      <!-- 文章总数 -->
      <div class="group bg-white rounded-2xl p-6 border border-stone-200 hover:border-emerald-300 shadow-sm hover:shadow-lg transition-all duration-300 hover:-translate-y-1">
        <div class="flex items-center justify-between mb-4">
          <div class="w-12 h-12 bg-emerald-50 rounded-xl flex items-center justify-center">
            <svg class="w-6 h-6 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </div>
          <span class="text-xs text-emerald-500 font-medium bg-emerald-50 px-2 py-1 rounded-full">+2 本月</span>
        </div>
        <div class="text-3xl font-bold text-stone-900 mb-1" id="stat-articles">9</div>
        <div class="text-sm text-stone-500">文章总数</div>
      </div>

      <!-- 标签总数 -->
      <div class="group bg-white rounded-2xl p-6 border border-stone-200 hover:border-blue-300 shadow-sm hover:shadow-lg transition-all duration-300 hover:-translate-y-1">
        <div class="flex items-center justify-between mb-4">
          <div class="w-12 h-12 bg-blue-50 rounded-xl flex items-center justify-center">
            <svg class="w-6 h-6 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
            </svg>
          </div>
          <span class="text-xs text-blue-500 font-medium bg-blue-50 px-2 py-1 rounded-full">热门</span>
        </div>
        <div class="text-3xl font-bold text-stone-900 mb-1" id="stat-tags">22</div>
        <div class="text-sm text-stone-500">标签总数</div>
      </div>

      <!-- 访问人数 -->
      <div class="group bg-white rounded-2xl p-6 border border-stone-200 hover:border-purple-300 shadow-sm hover:shadow-lg transition-all duration-300 hover:-translate-y-1">
        <div class="flex items-center justify-between mb-4">
          <div class="w-12 h-12 bg-purple-50 rounded-xl flex items-center justify-center">
            <svg class="w-6 h-6 text-purple-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
            </svg>
          </div>
          <span class="text-xs text-purple-500 font-medium bg-purple-50 px-2 py-1 rounded-full">↑12%</span>
        </div>
        <div class="text-3xl font-bold text-stone-900 mb-1" id="stat-views">1,284</div>
        <div class="text-sm text-stone-500">总访问量</div>
      </div>

      <!-- 点赞数 -->
      <div class="group bg-white rounded-2xl p-6 border border-stone-200 hover:border-pink-300 shadow-sm hover:shadow-lg transition-all duration-300 hover:-translate-y-1">
        <div class="flex items-center justify-between mb-4">
          <div class="w-12 h-12 bg-pink-50 rounded-xl flex items-center justify-center">
            <svg class="w-6 h-6 text-pink-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
            </svg>
          </div>
          <span class="text-xs text-pink-500 font-medium bg-pink-50 px-2 py-1 rounded-full">❤️</span>
        </div>
        <div class="text-3xl font-bold text-stone-900 mb-1" id="stat-likes">386</div>
        <div class="text-sm text-stone-500">获赞总数</div>
      </div>
    </div>

    <!-- 图表区域 -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      <!-- 标签分布饼图 -->
      <div class="bg-white rounded-2xl p-6 border border-stone-200 shadow-sm">
        <h3 class="text-lg font-bold text-stone-900 mb-6 flex items-center gap-2">
          <svg class="w-5 h-5 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.488 9H15V3.512A9.025 9.025 0 0120.488 9z" />
          </svg>
          标签分布
        </h3>
        <div class="h-64">
          <canvas id="tagsChart"></canvas>
        </div>
      </div>

      <!-- 文章趋势折线图 -->
      <div class="bg-white rounded-2xl p-6 border border-stone-200 shadow-sm">
        <h3 class="text-lg font-bold text-stone-900 mb-6 flex items-center gap-2">
          <svg class="w-5 h-5 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
          </svg>
          发布趋势
        </h3>
        <div class="h-64">
          <canvas id="trendChart"></canvas>
        </div>
      </div>

      <!-- 分类柱状图 -->
      <div class="bg-white rounded-2xl p-6 border border-stone-200 shadow-sm">
        <h3 class="text-lg font-bold text-stone-900 mb-6 flex items-center gap-2">
          <svg class="w-5 h-5 text-purple-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
          </svg>
          分类统计
        </h3>
        <div class="h-64">
          <canvas id="categoryChart"></canvas>
        </div>
      </div>

      <!-- 访问趋势面积图 -->
      <div class="bg-white rounded-2xl p-6 border border-stone-200 shadow-sm">
        <h3 class="text-lg font-bold text-stone-900 mb-6 flex items-center gap-2">
          <svg class="w-5 h-5 text-pink-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
          </svg>
          访问趋势
        </h3>
        <div class="h-64">
          <canvas id="visitorsChart"></canvas>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import Chart from 'chart.js/auto';

  // 标签分布饼图
  const tagsCtx = document.getElementById('tagsChart') as HTMLCanvasElement;
  if (tagsCtx) {
    new Chart(tagsCtx, {
      type: 'doughnut',
      data: {
        labels: ['前端', 'React', 'Astro', 'TypeScript', 'Tailwind', 'CSS', 'JavaScript', 'Git', '其他'],
        datasets: [{
          data: [12, 8, 5, 6, 4, 7, 9, 3, 5],
          backgroundColor: [
            '#10b981', '#3b82f6', '#f97316', '#3b82f6', '#06b6d4',
            '#ec4899', '#f59e0b', '#ef4444', '#8b5cf6'
          ],
          borderWidth: 0,
          hoverOffset: 10
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            position: 'right',
            labels: {
              padding: 15,
              usePointStyle: true,
              pointStyleWidth: 10,
              font: { size: 12 }
            }
          }
        },
        cutout: '60%'
      }
    });
  }

  // 发布趋势折线图
  const trendCtx = document.getElementById('trendChart') as HTMLCanvasElement;
  if (trendCtx) {
    new Chart(trendCtx, {
      type: 'line',
      data: {
        labels: ['2023-11', '2023-12', '2024-01', '2024-02', '2024-03', '2024-04', '2024-05'],
        datasets: [{
          label: '文章数量',
          data: [2, 3, 5, 6, 7, 8, 9],
          borderColor: '#10b981',
          backgroundColor: 'rgba(16, 185, 129, 0.1)',
          borderWidth: 2,
          fill: true,
          tension: 0.4,
          pointBackgroundColor: '#10b981',
          pointBorderColor: '#fff',
          pointBorderWidth: 2,
          pointRadius: 4,
          pointHoverRadius: 6
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { display: false }
        },
        scales: {
          y: {
            beginAtZero: true,
            ticks: { stepSize: 2 },
            grid: { color: 'rgba(0,0,0,0.05)' }
          },
          x: {
            grid: { display: false }
          }
        }
      }
    });
  }

  // 分类柱状图
  const categoryCtx = document.getElementById('categoryChart') as HTMLCanvasElement;
  if (categoryCtx) {
    new Chart(categoryCtx, {
      type: 'bar',
      data: {
        labels: ['前端工程', '计算生物学', '设计系统', '开发工具', '其他'],
        datasets: [{
          label: '文章数量',
          data: [6, 1, 1, 1, 0],
          backgroundColor: [
            'rgba(16, 185, 129, 0.8)',
            'rgba(59, 130, 246, 0.8)',
            'rgba(249, 115, 22, 0.8)',
            'rgba(139, 92, 246, 0.8)',
            'rgba(236, 72, 153, 0.8)'
          ],
          borderColor: [
            '#10b981',
            '#3b82f6',
            '#f97316',
            '#8b5cf6',
            '#ec4899'
          ],
          borderWidth: 1,
          borderRadius: 8,
          borderSkipped: false
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { display: false }
        },
        scales: {
          y: {
            beginAtZero: true,
            ticks: { stepSize: 2 },
            grid: { color: 'rgba(0,0,0,0.05)' }
          },
          x: {
            grid: { display: false }
          }
        }
      }
    });
  }

  // 访问趋势面积图
  const visitorsCtx = document.getElementById('visitorsChart') as HTMLCanvasElement;
  if (visitorsCtx) {
    new Chart(visitorsCtx, {
      type: 'line',
      data: {
        labels: ['1月', '2月', '3月', '4月', '5月', '6月'],
        datasets: [
          {
            label: '独立访客',
            data: [120, 180, 250, 320, 420, 580],
            borderColor: '#8b5cf6',
            backgroundColor: 'rgba(139, 92, 246, 0.1)',
            borderWidth: 2,
            fill: true,
            tension: 0.4
          },
          {
            label: '页面浏览',
            data: [350, 520, 680, 850, 1050, 1284],
            borderColor: '#ec4899',
            backgroundColor: 'rgba(236, 72, 153, 0.1)',
            borderWidth: 2,
            fill: true,
            tension: 0.4
          }
        ]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            position: 'top',
            labels: {
              usePointStyle: true,
              padding: 20,
              font: { size: 12 }
            }
          }
        },
        scales: {
          y: {
            beginAtZero: true,
            grid: { color: 'rgba(0,0,0,0.05)' }
          },
          x: {
            grid: { display: false }
          }
        }
      }
    });
  }

  // 数字滚动动画
  function animateValue(element: HTMLElement, start: number, end: number, duration: number) {
    const range = end - start;
    const increment = end > start ? 1 : -1;
    const stepTime = Math.abs(Math.floor(duration / range));
    let current = start;

    const timer = setInterval(() => {
      current += increment;
      element.textContent = current.toLocaleString();
      if (current === end) {
        clearInterval(timer);
      }
    }, stepTime);
  }

  // 观察器：当元素进入视口时触发动画
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const element = entry.target as HTMLElement;
        const finalValue = parseInt(element.textContent?.replace(/,/g, '') || '0');
        animateValue(element, 0, finalValue, 1500);
        observer.unobserve(element);
      }
    });
  }, { threshold: 0.5 });

  // 观察所有统计数字
  ['stat-articles', 'stat-tags', 'stat-views', 'stat-likes'].forEach(id => {
    const element = document.getElementById(id);
    if (element) observer.observe(element);
  });
</script>
