---
// 统计仪表盘 - 基于真实数据
import { getCollection } from 'astro:content';

// 获取所有已发布文章
const allPosts = await getCollection('blog', ({ data }) => !data.draft);

// 计算真实统计数据
const totalPosts = allPosts.length;

// 计算总字数
let totalCharacters = 0;
allPosts.forEach(post => {
  totalCharacters += post.body?.length || 0;
});

// 估算阅读时间（中文约 400 字/分钟）
const totalReadingMinutes = Math.ceil(totalCharacters / 400);

// 获取所有标签并统计
const tagMap = new Map<string, number>();
allPosts.forEach(post => {
  post.data.tags.forEach(tag => {
    tagMap.set(tag, (tagMap.get(tag) || 0) + 1);
  });
});
const totalTags = tagMap.size;
const tags = Array.from(tagMap.entries())
  .map(([name, count]) => ({ name, count }))
  .sort((a, b) => b.count - a.count);

// 获取所有分类并统计
const categoryMap = new Map<string, number>();
allPosts.forEach(post => {
  const cat = post.data.category || '未分类';
  categoryMap.set(cat, (categoryMap.get(cat) || 0) + 1);
});
const categories = Array.from(categoryMap.entries())
  .map(([name, count]) => ({ name, count }))
  .sort((a, b) => b.count - a.count);

// 按年份统计文章
const yearMap = new Map<number, number>();
allPosts.forEach(post => {
  const year = post.data.pubDate.getFullYear();
  yearMap.set(year, (yearMap.get(year) || 0) + 1);
});
const postsByYear = Array.from(yearMap.entries())
  .sort((a, b) => a[0] - b[0]);

// 按月统计文章（最近12个月）
const monthMap = new Map<string, number>();
const now = new Date();
for (let i = 11; i >= 0; i--) {
  const date = new Date(now.getFullYear(), now.getMonth() - i, 1);
  const key = `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}`;
  monthMap.set(key, 0);
}
allPosts.forEach(post => {
  const date = post.data.pubDate;
  const key = `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}`;
  if (monthMap.has(key)) {
    monthMap.set(key, (monthMap.get(key) || 0) + 1);
  }
});
const monthlyData = Array.from(monthMap.entries());

// 获取最新文章
const latestPosts = allPosts
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 5);

// 模拟访问数据（实际项目中应从分析服务获取）
const totalViews = totalPosts * 156; // 基于文章数估算
const totalLikes = totalPosts * 28;
const totalComments = totalPosts * 12;
---

<!-- 粒子背景画布 -->
<canvas id="particleBg" class="fixed inset-0 w-full h-full pointer-events-none" style="z-index: -2;"></canvas>

<section class="py-20 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- 标题 -->
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-stone-900 mb-4">
        📊 博客数据<span class="gradient-text">仪表盘</span>
      </h2>
      <p class="text-stone-500 max-w-2xl mx-auto">
        基于 {totalPosts} 篇文章、{totalCharacters.toLocaleString()} 字内容的真实数据统计
      </p>
    </div>

    <!-- 核心指标卡片 -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-12">
      <!-- 文章总数 -->
      <div class="bg-white rounded-2xl p-6 border border-stone-200 shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-2">
        <div class="flex items-center justify-between mb-4">
          <div class="w-12 h-12 bg-emerald-50 rounded-xl flex items-center justify-center">
            <span class="text-2xl">📄</span>
          </div>
          <span class="text-xs text-emerald-500 font-medium bg-emerald-50 px-2 py-1 rounded-full">已发布</span>
        </div>
        <div class="text-3xl font-bold text-stone-900 mb-1 counter" data-target={totalPosts} id="counter-posts">0</div>
        <div class="text-sm text-stone-500">文章总数</div>
        <div class="mt-3 h-1.5 bg-stone-100 rounded-full overflow-hidden">
          <div class="h-full bg-emerald-500 rounded-full transition-all duration-1500" id="bar-posts" style="width: 0%"></div>
        </div>
      </div>

      <!-- 总字数 -->
      <div class="bg-white rounded-2xl p-6 border border-stone-200 shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-2">
        <div class="flex items-center justify-between mb-4">
          <div class="w-12 h-12 bg-blue-50 rounded-xl flex items-center justify-center">
            <span class="text-2xl">📝</span>
          </div>
          <span class="text-xs text-blue-500 font-medium bg-blue-50 px-2 py-1 rounded-full">原创</span>
        </div>
        <div class="text-3xl font-bold text-stone-900 mb-1 counter" data-target={Math.floor(totalCharacters / 1000)} id="counter-words">0</div>
        <div class="text-sm text-stone-500">总字数 (千)</div>
        <div class="mt-3 h-1.5 bg-stone-100 rounded-full overflow-hidden">
          <div class="h-full bg-blue-500 rounded-full transition-all duration-1500" id="bar-words" style="width: 0%"></div>
        </div>
      </div>

      <!-- 标签总数 -->
      <div class="bg-white rounded-2xl p-6 border border-stone-200 shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-2">
        <div class="flex items-center justify-between mb-4">
          <div class="w-12 h-12 bg-purple-50 rounded-xl flex items-center justify-center">
            <span class="text-2xl">🏷️</span>
          </div>
          <span class="text-xs text-purple-500 font-medium bg-purple-50 px-2 py-1 rounded-full">热门</span>
        </div>
        <div class="text-3xl font-bold text-stone-900 mb-1 counter" data-target={totalTags} id="counter-tags">0</div>
        <div class="text-sm text-stone-500">标签总数</div>
        <div class="mt-3 h-1.5 bg-stone-100 rounded-full overflow-hidden">
          <div class="h-full bg-purple-500 rounded-full transition-all duration-1500" id="bar-tags" style="width: 0%"></div>
        </div>
      </div>

      <!-- 阅读时间 -->
      <div class="bg-white rounded-2xl p-6 border border-stone-200 shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-2">
        <div class="flex items-center justify-between mb-4">
          <div class="w-12 h-12 bg-orange-50 rounded-xl flex items-center justify-center">
            <span class="text-2xl">⏱️</span>
          </div>
          <span class="text-xs text-orange-500 font-medium bg-orange-50 px-2 py-1 rounded-full">预计</span>
        </div>
        <div class="text-3xl font-bold text-stone-900 mb-1 counter" data-target={totalReadingMinutes} id="counter-time">0</div>
        <div class="text-sm text-stone-500">阅读时间 (分钟)</div>
        <div class="mt-3 h-1.5 bg-stone-100 rounded-full overflow-hidden">
          <div class="h-full bg-orange-500 rounded-full transition-all duration-1500" id="bar-time" style="width: 0%"></div>
        </div>
      </div>
    </div>

    <!-- 图表区域 -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-12">
      <!-- 发布趋势 -->
      <div class="bg-white rounded-2xl p-6 border border-stone-200 shadow-sm">
        <h3 class="text-lg font-bold text-stone-900 mb-6 flex items-center gap-2">
          <span class="text-xl">📈</span> 发布趋势 (最近12个月)
        </h3>
        <div class="h-64">
          <canvas id="trendChart"></canvas>
        </div>
      </div>

      <!-- 标签分布 -->
      <div class="bg-white rounded-2xl p-6 border border-stone-200 shadow-sm">
        <h3 class="text-lg font-bold text-stone-900 mb-6 flex items-center gap-2">
          <span class="text-xl">🏷️</span> 标签分布
        </h3>
        <div class="space-y-3" id="tagsBarChart">
          {tags.slice(0, 8).map((tag, index) => {
            const maxCount = tags[0].count;
            const width = (tag.count / maxCount) * 100;
            const colors = ['bg-emerald-500', 'bg-blue-500', 'bg-purple-500', 'bg-orange-500', 'bg-pink-500', 'bg-cyan-500', 'bg-yellow-500', 'bg-red-500'];
            return (
              <div class="flex items-center gap-3">
                <span class="text-sm text-stone-600 w-24 text-right">{tag.name}</span>
                <div class="flex-1 h-8 bg-stone-100 rounded-full overflow-hidden">
                  <div class={`h-full ${colors[index % colors.length]} rounded-full flex items-center justify-end pr-3 transition-all duration-1000`} style={`width: ${width}%`}>
                    <span class="text-xs text-white font-bold">{tag.count}</span>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </div>

    <!-- 分类和最新文章 -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
      <!-- 分类统计 -->
      <div class="bg-white rounded-2xl p-6 border border-stone-200 shadow-sm">
        <h3 class="text-lg font-bold text-stone-900 mb-6 flex items-center gap-2">
          <span class="text-xl">📊</span> 分类统计
        </h3>
        <div class="grid grid-cols-2 gap-4">
          {categories.map((cat, index) => {
            const colors = [
              { bg: 'bg-emerald-50', text: 'text-emerald-600', border: 'border-emerald-200' },
              { bg: 'bg-blue-50', text: 'text-blue-600', border: 'border-blue-200' },
              { bg: 'bg-purple-50', text: 'text-purple-600', border: 'border-purple-200' },
              { bg: 'bg-orange-50', text: 'text-orange-600', border: 'border-orange-200' },
            ];
            const color = colors[index % colors.length];
            return (
              <div class={`${color.bg} rounded-xl p-4 text-center border ${color.border}`}>
                <div class={`text-3xl font-bold ${color.text} mb-1`}>{cat.count}</div>
                <div class={`text-sm ${color.text}`}>{cat.name}</div>
              </div>
            );
          })}
        </div>
      </div>

      <!-- 最新文章 -->
      <div class="bg-white rounded-2xl p-6 border border-stone-200 shadow-sm">
        <h3 class="text-lg font-bold text-stone-900 mb-6 flex items-center gap-2">
          <span class="text-xl">📰</span> 最新文章
        </h3>
        <div class="space-y-3">
          {latestPosts.map((post, index) => (
            <a href={`/blog/${post.slug}`} class="flex items-center gap-3 p-3 rounded-xl hover:bg-stone-50 transition-colors">
              <span class="text-lg font-bold text-emerald-500 w-8">{index + 1}</span>
              <div class="flex-1 min-w-0">
                <div class="font-medium text-sm text-stone-900 truncate">{post.data.title}</div>
                <div class="text-xs text-stone-500">
                  {post.data.pubDate.toLocaleDateString('zh-CN', { month: 'short', day: 'numeric' })}
                  · {post.data.tags.slice(0, 2).join(', ')}
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- 发布热力图 -->
    <div class="bg-white rounded-2xl p-6 border border-stone-200 shadow-sm">
      <h3 class="text-lg font-bold text-stone-900 mb-6 flex items-center gap-2">
        <span class="text-xl">📅</span> 文章发布时间分布
      </h3>
      <div class="grid grid-cols-4 md:grid-cols-6 gap-4">
        {postsByYear.map(([year, count]) => (
          <div class="bg-gradient-to-br from-emerald-50 to-teal-50 rounded-xl p-4 text-center border border-emerald-200">
            <div class="text-2xl font-bold text-emerald-600 mb-1">{year}</div>
            <div class="text-sm text-emerald-700">{count} 篇</div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script is:inline>
document.addEventListener('DOMContentLoaded', function() {
  console.log('Dashboard loaded with real data');

  // 数据
  var totalPosts = {totalPosts};
  var totalCharacters = {totalCharacters};
  var totalTags = {totalTags};
  var totalReadingMinutes = {totalReadingMinutes};
  var monthlyData = {JSON.stringify(monthlyData)};

  // 数字动画
  function animateCounter(id, target, duration) {
    var el = document.getElementById(id);
    if (!el) return;

    var start = 0;
    var startTime = null;

    function update(timestamp) {
      if (!startTime) startTime = timestamp;
      var progress = Math.min((timestamp - startTime) / duration, 1);
      var easeOut = 1 - Math.pow(1 - progress, 4);
      var current = Math.floor(easeOut * target);

      if (target >= 1000) {
        el.textContent = (current / 1000).toFixed(1) + 'K';
      } else {
        el.textContent = current.toLocaleString();
      }

      if (progress < 1) {
        requestAnimationFrame(update);
      }
    }

    requestAnimationFrame(update);
  }

  // 进度条动画
  function animateBar(id, width) {
    var el = document.getElementById(id);
    if (!el) return;

    setTimeout(function() {
      el.style.width = width + '%';
    }, 300);
  }

  // 粒子背景
  function initParticles() {
    var canvas = document.getElementById('particleBg');
    if (!canvas) return;

    var ctx = canvas.getContext('2d');
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;

    var particles = [];
    var mouse = { x: null, y: null };
    var colors = ['#10b981', '#3b82f6', '#f59e0b', '#ec4899', '#8b5cf6'];

    // 创建粒子
    for (var i = 0; i < 40; i++) {
      particles.push({
        x: Math.random() * canvas.width,
        y: Math.random() * canvas.height,
        size: Math.random() * 3 + 1,
        speedX: (Math.random() - 0.5) * 1,
        speedY: (Math.random() - 0.5) * 1,
        color: colors[Math.floor(Math.random() * colors.length)],
        opacity: Math.random() * 0.3 + 0.1
      });
    }

    window.addEventListener('resize', function() {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
    });

    document.addEventListener('mousemove', function(e) {
      mouse.x = e.clientX;
      mouse.y = e.clientY;
    });

    document.addEventListener('click', function(e) {
      for (var i = 0; i < 10; i++) {
        particles.push({
          x: e.clientX,
          y: e.clientY,
          size: Math.random() * 4 + 1,
          speedX: (Math.random() - 0.5) * 6,
          speedY: (Math.random() - 0.5) * 6,
          color: colors[Math.floor(Math.random() * colors.length)],
          opacity: 0.8,
          life: 0,
          maxLife: 30
        });
      }
    });

    function animate() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      var alive = [];
      for (var i = 0; i < particles.length; i++) {
        var p = particles[i];

        // 鼠标交互
        if (mouse.x !== null && !p.life) {
          var dx = mouse.x - p.x;
          var dy = mouse.y - p.y;
          var dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < 150) {
            var force = (150 - dist) / 150;
            p.x -= (dx / dist) * force * 2;
            p.y -= (dy / dist) * force * 2;
          }
        }

        p.x += p.speedX;
        p.y += p.speedY;

        // 生命周期
        if (p.life !== undefined) {
          p.life++;
          if (p.life >= p.maxLife) continue;
          p.opacity = 1 - (p.life / p.maxLife);
        }

        // 边界反弹
        if (p.x < 0 || p.x > canvas.width) p.speedX *= -1;
        if (p.y < 0 || p.y > canvas.height) p.speedY *= -1;

        // 绘制粒子
        ctx.globalAlpha = p.opacity;
        ctx.fillStyle = p.color;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
        ctx.fill();

        alive.push(p);

        // 连线
        if (!p.life) {
          for (var j = i + 1; j < particles.length; j++) {
            var other = particles[j];
            if (other.life) continue;
            var dx = p.x - other.x;
            var dy = p.y - other.y;
            var dist = Math.sqrt(dx * dx + dy * dy);
            if (dist < 100) {
              ctx.globalAlpha = (1 - dist / 100) * 0.15;
              ctx.strokeStyle = '#10b981';
              ctx.lineWidth = 0.5;
              ctx.beginPath();
              ctx.moveTo(p.x, p.y);
              ctx.lineTo(other.x, other.y);
              ctx.stroke();
            }
          }
        }
      }
      particles = alive;

      if (particles.length > 80) {
        particles = particles.slice(-80);
      }

      ctx.globalAlpha = 1;
      requestAnimationFrame(animate);
    }

    animate();
  }

  // 折线图
  function drawLineChart() {
    var canvas = document.getElementById('trendChart');
    if (!canvas) return;

    var ctx = canvas.getContext('2d');
    var rect = canvas.parentElement.getBoundingClientRect();
    canvas.width = rect.width;
    canvas.height = rect.height;

    var padding = { top: 20, right: 20, bottom: 30, left: 40 };
    var width = canvas.width - padding.left - padding.right;
    var height = canvas.height - padding.top - padding.bottom;

    var maxVal = Math.max.apply(null, monthlyData.map(function(d) { return d[1]; })) || 1;

    // 网格
    ctx.strokeStyle = 'rgba(0,0,0,0.05)';
    ctx.lineWidth = 1;
    for (var i = 0; i <= 4; i++) {
      var y = padding.top + (height / 4) * i;
      ctx.beginPath();
      ctx.moveTo(padding.left, y);
      ctx.lineTo(canvas.width - padding.right, y);
      ctx.stroke();

      ctx.fillStyle = '#9ca3af';
      ctx.font = '10px sans-serif';
      ctx.textAlign = 'right';
      ctx.fillText(Math.round(maxVal * (4 - i) / 4), padding.left - 5, y + 4);
    }

    // X轴标签
    ctx.textAlign = 'center';
    monthlyData.forEach(function(item, i) {
      var x = padding.left + (width / (monthlyData.length - 1)) * i;
      var label = item[0].split('-')[1] + '月';
      ctx.fillText(label, x, canvas.height - 10);
    });

    // 绘制数据
    ctx.beginPath();
    ctx.strokeStyle = '#10b981';
    ctx.lineWidth = 3;
    monthlyData.forEach(function(item, i) {
      var x = padding.left + (width / (monthlyData.length - 1)) * i;
      var y = padding.top + height - (item[1] / maxVal) * height;
      if (i === 0) ctx.moveTo(x, y);
      else ctx.lineTo(x, y);
    });
    ctx.stroke();

    // 填充区域
    ctx.lineTo(padding.left + width, padding.top + height);
    ctx.lineTo(padding.left, padding.top + height);
    ctx.closePath();
    ctx.fillStyle = 'rgba(16, 185, 129, 0.1)';
    ctx.fill();

    // 数据点
    monthlyData.forEach(function(item, i) {
      var x = padding.left + (width / (monthlyData.length - 1)) * i;
      var y = padding.top + height - (item[1] / maxVal) * height;
      ctx.beginPath();
      ctx.arc(x, y, 5, 0, Math.PI * 2);
      ctx.fillStyle = '#10b981';
      ctx.fill();
      ctx.strokeStyle = '#fff';
      ctx.lineWidth = 2;
      ctx.stroke();

      // 数值
      if (item[1] > 0) {
        ctx.fillStyle = '#374151';
        ctx.font = 'bold 12px sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText(item[1], x, y - 12);
      }
    });
  }

  // 启动
  animateCounter('counter-posts', totalPosts, 1500);
  animateCounter('counter-words', Math.floor(totalCharacters / 1000), 2000);
  animateCounter('counter-tags', totalTags, 1200);
  animateCounter('counter-time', totalReadingMinutes, 1800);

  animateBar('bar-posts', Math.min(totalPosts * 10, 100));
  animateBar('bar-words', Math.min(Math.floor(totalCharacters / 10000) * 10, 100));
  animateBar('bar-tags', Math.min(totalTags * 5, 100));
  animateBar('bar-time', Math.min(totalReadingMinutes / 10, 100));

  initParticles();

  setTimeout(drawLineChart, 100);

  window.addEventListener('resize', drawLineChart);

  console.log('Dashboard initialized with', totalPosts, 'posts,', totalCharacters, 'characters');
});
</script>
