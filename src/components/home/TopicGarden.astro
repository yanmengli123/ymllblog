---
import type { GardenPost } from '../../lib/garden';
interface Topic { name: string; count: number; posts: GardenPost[]; lastActive: number; }
interface Props { topics: Topic[]; }
const { topics } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="site-shell py-20 section-rule" aria-labelledby="topics-heading">
  <div class="section-heading-row" data-reveal>
    <div><p class="eyebrow">Topic garden</p><h2 id="topics-heading" class="font-display text-4xl font-bold sm:text-5xl">主题花园</h2></div>
    <p class="section-intro">按真实文章标签自动聚合。越常被书写与更新的主题，越接近花园中心。</p>
  </div>
  <div class="topic-garden-grid mt-10">
    {topics.slice(0, 10).map((topic, index) => <a href={`${base}/tags/${topic.name}`} class="topic-garden-tile motion-card group" data-reveal style={`--topic-weight: ${Math.min(3, Math.max(1, topic.count))}; --reveal-order: ${index % 4};`}>
      <span class="topic-garden-meta"><i>{String(index + 1).padStart(2, '0')}</i><b>{topic.count} 篇</b></span>
      <h3 class="motion-card-title">#{topic.name}</h3>
      <span class="topic-garden-posts">{topic.posts.map((post) => <small>{post.data.title}</small>)}</span>
      <span class="motion-arrow" aria-hidden="true">→</span>
    </a>)}
  </div>
</section>
