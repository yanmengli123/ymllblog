---
/**
 * PagefindSearch.astro
 * Augments the static search modal in Header.astro with Pagefind's full-text
 * index when Pagefind is available (i.e. when running against a built site).
 *
 * Pagefind indexes content at build time and ships a small JS+WASM bundle that
 * lazy-loads on first search. We fall back to the static index (post.title +
 * description + tags) when Pagefind hasn't initialized yet (e.g. first
 * keystroke before the WASM finishes loading).
 *
 * The Pagefind index is generated by `pagefind --site dist` after `astro build`.
 * See package.json `build:search` script.
 */

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<script is:inline define:vars={{ base }}>
  // Lazy-load Pagefind only on first search interaction. Avoids 100KB+ on
  // initial page load when the user never searches.
  let pagefindPromise = null;
  function loadPagefind() {
    if (pagefindPromise) return pagefindPromise;
    pagefindPromise = import(/* @vite-ignore */ `${base}/pagefind/pagefind.js`)
      .then((mod) => mod.init())
      .then(() => mod)
      .catch((err) => {
        console.warn('Pagefind not available, falling back to static index:', err);
        return null;
      });
    return pagefindPromise;
  }

  // Expose a hook that Header.astro's input listener can call.
  // It returns an array of { url, title, excerpt } matching the query.
  window.__ymll_pagefind = async function searchPosts(query) {
    if (!query.trim()) return null; // signal: caller should show recents
    const pf = await loadPagefind();
    if (!pf) return null; // signal: caller should fall back to static index
    const search = await pf.search(query);
    return Promise.all(
      search.results.slice(0, 8).map(async (r) => {
        const data = await r.data();
        return {
          url: `${base}${data.url}`,
          title: data.meta?.title ?? '未命名文章',
          excerpt: data.excerpt ?? '',
        };
      })
    );
  };
</script>
