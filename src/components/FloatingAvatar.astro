---
// 浮动头像组件
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div id="floating-avatar" class="fixed top-20 right-4 z-[996] transition-all duration-500" style="display: none;">
  <div class="glass-board rounded-2xl p-3 w-64 shadow-2xl">
    <div class="flex flex-col items-center text-center">
      <div class="relative mb-2">
        <img id="avatar-img" src="https://api.dicebear.com/7.x/adventurer/svg?seed=YMLL" alt="avatar" class="w-20 h-20 rounded-full object-cover shadow-lg border-2 border-white/50" />
        <div class="absolute -bottom-1 -right-1 w-5 h-5 rounded-full border-2 border-white" style="background: hsl(150, 60%, 50%);" title="在线"></div>
      </div>
      <h3 id="avatar-name" class="font-bold text-base" style="color: var(--text-primary);">YMLL</h3>
      <p id="avatar-bio" class="text-xs mt-1" style="color: var(--text-secondary);">都是风景，幸会</p>
      <div class="flex gap-1 mt-3 text-xs">
        <span class="px-2 py-1 rounded-full" style="background: hsl(var(--primary-hue), 40%, 95%); color: var(--primary);">前端</span>
        <span class="px-2 py-1 rounded-full" style="background: hsl(var(--primary-hue), 40%, 95%); color: var(--primary);">设计</span>
        <span class="px-2 py-1 rounded-full" style="background: hsl(var(--primary-hue), 40%, 95%); color: var(--primary);">分享</span>
      </div>
      <div class="text-xs mt-3 p-2 rounded-lg" style="background: var(--bg-board); color: var(--text-secondary);">
        <p>希望能带给你温暖和快乐！</p>
        <p class="mt-1">💖</p>
      </div>
    </div>
  </div>
</div>

<script>
  (function() {
    const avatar = document.getElementById('floating-avatar');
    if (!avatar) return;

    // 加载自定义设置
    try {
      const settings = JSON.parse(localStorage.getItem('ymll_user_settings') || '{}');
      if (settings.customAvatar) {
        const img = document.getElementById('avatar-img') as HTMLImageElement;
        if (img) img.src = settings.customAvatar;
      }
      if (settings.customGreeting) {
        const bio = document.getElementById('avatar-bio');
        if (bio) bio.textContent = settings.customGreeting;
      }
    } catch {}

    // 检查设置中是否启用
    try {
      const settings = JSON.parse(localStorage.getItem('ymll_user_settings') || '{}');
      if (settings.showAvatar !== false) {
        avatar.style.display = '';
      }
    } catch {
      avatar.style.display = '';
    }

    // 暴露 API
    (window as any).avatarWidget = {
      show() { avatar.style.display = ''; },
      hide() { avatar.style.display = 'none'; },
      setAvatar(url) {
        const img = document.getElementById('avatar-img') as HTMLImageElement;
        if (img) img.src = url;
      },
      setName(name) {
        const el = document.getElementById('avatar-name');
        if (el) el.textContent = name;
      },
      setBio(bio) {
        const el = document.getElementById('avatar-bio');
        if (el) el.textContent = bio;
      },
    };
  })();
</script>
