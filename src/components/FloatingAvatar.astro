---
// 浮动头像组件
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div id="floating-avatar" class="fixed bottom-4 right-4 z-[996] transition-all duration-500" style="display: none;">
  <div class="rounded-2xl p-3 w-56 shadow-2xl" style="background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); border: 1px solid rgba(0, 0, 0, 0.1);">
    <div class="flex items-center gap-3">
      <div class="relative shrink-0">
        <img id="avatar-img" src="https://api.dicebear.com/7.x/adventurer/svg?seed=YMLL" alt="avatar" class="w-12 h-12 rounded-full object-cover shadow-lg border-2 border-white" />
        <div class="absolute -bottom-0.5 -right-0.5 w-3.5 h-3.5 rounded-full border-2 border-white bg-green-500" title="在线"></div>
      </div>
      <div class="flex-1 min-w-0">
        <h3 id="avatar-name" class="font-bold text-sm truncate text-stone-800">YMLL</h3>
        <p id="avatar-bio" class="text-xs truncate text-stone-500">都是风景，幸会</p>
      </div>
      <button id="avatar-toggle" class="p-1 rounded hover:bg-stone-100 transition-colors text-stone-400 hover:text-stone-600" aria-label="收起">
        <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>
</div>

<script>
  (function() {
    const avatar = document.getElementById('floating-avatar');
    if (!avatar) return;

    // 加载自定义设置
    try {
      const settings = JSON.parse(localStorage.getItem('ymll_user_settings') || '{}');
      if (settings.customAvatar) {
        const img = document.getElementById('avatar-img') as HTMLImageElement;
        if (img) img.src = settings.customAvatar;
      }
      if (settings.customGreeting) {
        const bio = document.getElementById('avatar-bio');
        if (bio) bio.textContent = settings.customGreeting;
      }
    } catch {}

    // 检查设置中是否启用
    try {
      const settings = JSON.parse(localStorage.getItem('ymll_user_settings') || '{}');
      if (settings.showAvatar !== false && settings.showAvatar !== undefined) {
        avatar.style.display = '';
      }
      // 第一次访问不显示浮动头像，避免遮挡
    } catch {
      // 默认隐藏
    }

    // 暴露 API
    (window as any).avatarWidget = {
      show() { avatar.style.display = ''; },
      hide() { avatar.style.display = 'none'; },
      setAvatar(url) {
        const img = document.getElementById('avatar-img') as HTMLImageElement;
        if (img) img.src = url;
      },
      setName(name) {
        const el = document.getElementById('avatar-name');
        if (el) el.textContent = name;
      },
      setBio(bio) {
        const el = document.getElementById('avatar-bio');
        if (el) el.textContent = bio;
      },
    };
  })();
</script>
