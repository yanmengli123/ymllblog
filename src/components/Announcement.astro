---
// 公告组件
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div id="announcement" class="fixed bottom-4 left-4 z-[997] w-72 max-w-[calc(100vw-2rem)] rounded-2xl shadow-2xl overflow-hidden" style="display: none; background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); border: 1px solid rgba(0, 0, 0, 0.1);">
  <div class="p-4">
    <div class="flex items-start gap-2 mb-3">
      <span class="text-xl shrink-0">📢</span>
      <div class="flex-1 min-w-0">
        <h3 class="font-bold text-sm mb-1 text-stone-800">公告</h3>
        <p id="announcement-text" class="text-xs leading-relaxed text-stone-600">
          请狠狠地赞赏我，打赏一次，爆更一篇！！
        </p>
      </div>
      <button id="announcement-close" class="p-1 rounded hover:bg-stone-100 transition-colors shrink-0 text-stone-400 hover:text-stone-600" aria-label="关闭">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
    <a href={`${base}/about`} class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg text-xs font-medium transition-all text-white" style="background: linear-gradient(135deg, #4f46e5, #06b6d4);">
      了解更多
      <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </a>
  </div>
</div>

<script>
  (function() {
    const announcement = document.getElementById('announcement');
    const closeBtn = document.getElementById('announcement-close');
    const textEl = document.getElementById('announcement-text');

    if (!announcement) return;

    // 加载自定义公告
    try {
      const settings = JSON.parse(localStorage.getItem('ymll_user_settings') || '{}');
      if (settings.customAnnouncement && textEl) {
        textEl.textContent = settings.customAnnouncement;
      }
    } catch {}

    // 关闭
    closeBtn?.addEventListener('click', () => {
      announcement.style.display = 'none';
      localStorage.setItem('announcement-dismissed', Date.now().toString());
    });

    // 自动显示（5秒后）
    const dismissed = localStorage.getItem('announcement-dismissed');
    const shouldShow = !dismissed || (Date.now() - parseInt(dismissed)) > 24 * 60 * 60 * 1000;

    if (shouldShow) {
      setTimeout(() => {
        // 检查设置中是否启用
        try {
          const settings = JSON.parse(localStorage.getItem('ymll_user_settings') || '{}');
          if (settings.showAnnouncement === false) return;
        } catch {}
        announcement.style.display = '';
      }, 5000);
    }

    // 暴露 API
    window.announcementAPI = {
      show() {
        announcement.style.display = '';
      },
      hide() {
        announcement.style.display = 'none';
      },
      setText(text) {
        if (textEl) textEl.textContent = text;
      },
    };
  })();
</script>
