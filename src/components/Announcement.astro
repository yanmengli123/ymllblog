---
interface Props {
  variant?: 'floating' | 'sidebar';
}

const { variant = 'floating' } = Astro.props;
const isSidebar = variant === 'sidebar';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div
  id="announcement"
  data-widget-variant={variant}
  class:list={[
    'overflow-hidden',
    isSidebar
      ? 'sidebar-glass sidebar-widget w-full'
      : 'fixed bottom-4 left-4 z-[997] w-72 max-w-[calc(100vw-2rem)] rounded-2xl shadow-2xl'
  ]}
  style={`${isSidebar ? '' : 'display: none;'} background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); border: 1px solid rgba(0, 0, 0, 0.1);`}
>
  <div class="p-4">
    <div class="mb-3 flex items-start gap-2">
      <span class="shrink-0 text-xl">📢</span>
      <div class="min-w-0 flex-1">
        <h3 class="mb-1 text-sm font-bold text-stone-800">公告</h3>
        <p id="announcement-text" class="text-xs leading-relaxed text-stone-600">
          请狠狠地赞赏我，打赏一次，爆更一篇！！
        </p>
      </div>
      <button id="announcement-close" class="shrink-0 rounded p-1 text-stone-400 transition-colors hover:bg-stone-100 hover:text-stone-600" aria-label="关闭公告">
        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
    <a href={`${base}/about`} class="inline-flex items-center gap-1 rounded-lg px-3 py-1.5 text-xs font-medium text-white transition-all" style="background: linear-gradient(135deg, #4f46e5, #06b6d4);">
      了解更多
      <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </a>
  </div>
</div>

<script define:vars={{ isSidebar }}>
  (function() {
    const announcement = document.getElementById('announcement');
    const closeBtn = document.getElementById('announcement-close');
    const textEl = document.getElementById('announcement-text');

    if (!announcement) return;

    try {
      const settings = JSON.parse(localStorage.getItem('ymll_user_settings') || '{}');
      if (settings.customAnnouncement && textEl) {
        textEl.textContent = settings.customAnnouncement;
      }
      if (isSidebar && settings.showAnnouncement === false) {
        announcement.style.display = 'none';
      }
    } catch {}

    closeBtn?.addEventListener('click', () => {
      announcement.style.display = 'none';
      localStorage.setItem('announcement-dismissed', Date.now().toString());
    });

    if (!isSidebar) {
      const dismissed = localStorage.getItem('announcement-dismissed');
      const shouldShow = !dismissed || (Date.now() - parseInt(dismissed)) > 24 * 60 * 60 * 1000;

      if (shouldShow) {
        setTimeout(() => {
          try {
            const settings = JSON.parse(localStorage.getItem('ymll_user_settings') || '{}');
            if (settings.showAnnouncement === false) return;
          } catch {}
          announcement.style.display = '';
        }, 5000);
      }
    }

    window.announcementAPI = {
      show() {
        announcement.style.display = '';
      },
      hide() {
        announcement.style.display = 'none';
      },
      setText(text) {
        if (textEl) textEl.textContent = text;
      },
    };
  })();
</script>
