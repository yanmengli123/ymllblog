---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

interface Props {
  tags: { name: string; count: number }[];
}

const { tags } = Astro.props;

// Matery 风格标签颜色
const tagColors = [
  '#F9EBEA', '#F5EEF8', '#D5F5E3', '#E8F8F5', '#FEF9E7',
  '#F8F9F9', '#82E0AA', '#D7BDE2', '#A3E4D7', '#85C1E9',
  '#F8C471', '#F9E79F', '#FAD7A0'
];
---

<section class="py-16">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12" data-aos="zoom-in-up">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">
        <span class="bg-gradient-to-r from-purple-500 to-green-500 bg-clip-text text-transparent">
          🏷️ 探索标签
        </span>
      </h2>
      <p class="text-stone-500">通过标签发现感兴趣的内容</p>
    </div>

    <div class="flex flex-wrap justify-center gap-3" data-aos="fade-up">
      {tags.map((tag, index) => {
        const bgColor = tagColors[index % tagColors.length];
        const size = tag.count > 10 ? 'text-lg px-5 py-2.5' : tag.count > 5 ? 'text-base px-4 py-2' : 'text-sm px-3 py-1.5';
        return (
          <a
            href={`${base}/tags/${tag.name}`}
            class={`${size} font-medium rounded-chip transition-all duration-300 hover:scale-110 hover:shadow-lg cursor-pointer inline-flex items-center gap-1`}
            style={`background: ${bgColor}; color: #34495e;`}
            data-aos="zoom-in"
            data-aos-delay={index * 50}
          >
            {tag.name}
            <sup class="text-xs opacity-70">{tag.count}</sup>
          </a>
        );
      })}
    </div>
  </div>
</section>
