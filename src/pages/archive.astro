---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const postsByYear = {
  '2024': [
    { title: '欢迎来到 YMLL Blog', date: '2024-01-15', slug: 'welcome' },
    { title: 'Astro 岛屿架构详解', date: '2024-01-10', slug: 'astro-islands' },
    { title: 'Tailwind CSS 最佳实践', date: '2024-01-05', slug: 'tailwind-best-practices' },
  ],
  '2023': [
    { title: 'React Hooks 深入理解', date: '2023-12-28', slug: 'react-hooks' },
    { title: 'TypeScript 高级类型体操', date: '2023-12-20', slug: 'typescript-advanced-types' },
  ],
};

const years = Object.keys(postsByYear).sort((a, b) => Number(b) - Number(a));
---

<Layout title="YMLL Blog - 归档">
  <Header />

  <main class="pt-16">
    <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <h1 class="text-3xl font-bold text-text dark:text-text-dark mb-2">归档</h1>
      <p class="text-text-muted dark:text-gray-400 mb-10">共 {Object.values(postsByYear).flat().length} 篇文章</p>

      <div class="space-y-12">
        {years.map(year => (
          <div>
            <h2 class="text-2xl font-bold text-primary dark:text-primary-400 mb-6">{year}</h2>
            <div class="space-y-4 pl-4 border-l-2 border-gray-200 dark:border-gray-800">
              {postsByYear[year].map(post => (
                <div class="relative">
                  <div class="absolute -left-[21px] top-2 w-3 h-3 bg-primary dark:bg-primary-400 rounded-full" />
                  <a
                    href={`/blog/${post.slug}`}
                    class="block p-4 bg-surface dark:bg-surface-dark rounded-lg shadow-sm hover:shadow-md transition-all duration-300 hover:-translate-y-0.5"
                  >
                    <div class="flex flex-wrap items-center gap-4">
                      <time datetime={post.date} class="text-sm text-text-muted">
                        {new Date(post.date).toLocaleDateString('zh-CN', { month: 'long', day: 'numeric' })}
                      </time>
                      <span class="text-text dark:text-text-dark hover:text-primary transition-colors">
                        {post.title}
                      </span>
                    </div>
                  </a>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</Layout>
