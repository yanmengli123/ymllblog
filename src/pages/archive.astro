---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getPostsByYear } from '../lib/posts';
import { calculateReadingTime } from '../lib/reading-time';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const postsByYear = await getPostsByYear();
const total = [...postsByYear.values()].reduce((sum, posts) => sum + posts.length, 0);
---

<Layout title="时间归档｜YMLL Blog" description="按时间浏览 YMLL Blog 的全部文章。">
  <Header />
  <main id="main-content" class="page-shell max-w-5xl">
    <header class="pb-14" data-reveal><p class="eyebrow">Chronological index</p><h1 class="font-display text-5xl font-black sm:text-6xl">时间归档</h1><p class="mt-5 text-lg" style="color: var(--muted);">{total} 篇记录，按写下它们的时间排列。</p></header>
    <div class="border-t" style="border-color: var(--line);">
      {[...postsByYear.entries()].map(([year, posts]) => (
        <section class="grid gap-6 border-b py-10 sm:grid-cols-[9rem_1fr]" style="border-color: var(--line);">
          <h2 class="font-display text-4xl font-bold" style="color: var(--brand-deep);" data-reveal>{year}</h2>
          <ol class="archive-timeline space-y-1" data-reveal>
            {posts.map((post, index) => <li class="archive-timeline-item" data-timeline-item data-reveal style={`--reveal-order: ${index % 3};`}><a href={`${base}/blog/${post.id}`} class="motion-card group grid gap-2 rounded-2xl px-4 py-4 hover:bg-black/[0.035] dark:hover:bg-white/[0.035] sm:grid-cols-[6rem_1fr_auto] sm:items-center"><time class="text-xs" style="color: var(--muted);">{post.data.pubDate.toLocaleDateString('zh-CN', { month: '2-digit', day: '2-digit' })}</time><strong class="motion-card-title font-display text-lg group-hover:text-emerald-700 dark:group-hover:text-emerald-300">{post.data.title}</strong><span class="text-xs" style="color: var(--muted);">{calculateReadingTime(post.body ?? '')}</span></a></li>)}
          </ol>
        </section>
      ))}
    </div>
  </main>
  <Footer />
</Layout>
