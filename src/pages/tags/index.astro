---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getAllTagsWithCount } from '../../lib/posts';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const tags = await getAllTagsWithCount();
---

<Layout title="主题标签｜YMLL Blog" description="按主题探索 YMLL Blog 的文章。">
  <Header />
  <main id="main-content" class="page-shell">
    <header class="max-w-3xl pb-14" data-reveal><p class="eyebrow">Knowledge map</p><h1 class="font-display text-5xl font-black sm:text-6xl">主题标签</h1><p class="mt-5 text-lg leading-8" style="color: var(--muted);">每个标签都是一条阅读路径。选择一个兴趣点，继续向下探索。</p></header>
    <div class="grid border-l border-t sm:grid-cols-2 lg:grid-cols-3" style="border-color: var(--line);">
      {tags.map((tag, index) => <a href={`${base}/tags/${tag.name}`} class="tag-garden-card motion-card group min-h-52 border-b border-r p-7 hover:bg-black/[0.035] dark:hover:bg-white/[0.035]" style={`--reveal-order: ${index % 3}; border-color: var(--line);`} data-reveal><span class="text-xs font-semibold" style="color: var(--brand);">{String(index + 1).padStart(2, '0')}</span><h2 class="motion-card-title mt-8 font-display text-2xl font-bold group-hover:text-emerald-700 dark:group-hover:text-emerald-300">#{tag.name}</h2><p class="tag-count mt-2 text-sm" style="color: var(--muted);">{tag.count} 篇文章</p><span class="motion-arrow mt-7 inline-block">→</span></a>)}
    </div>
  </main>
  <Footer />
</Layout>
