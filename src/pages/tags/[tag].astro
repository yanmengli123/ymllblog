---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PostCard from '../../components/PostCard.astro';
import { calculateReadingTime } from '../../lib/reading-time';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

export async function getStaticPaths() {
  const all = await getCollection('blog', ({ data }) => !data.draft);
  const tags = new Set(all.flatMap((post) => post.data.tags));
  return [...tags].map((tag) => ({ params: { tag }, props: { tag, posts: all.filter((post) => post.data.tags.includes(tag)).sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()) } }));
}
const { tag, posts } = Astro.props;
---

<Layout title={`#${tag}｜YMLL Blog`} description={`浏览所有关于 ${tag} 的文章。`}>
  <Header />
  <main id="main-content" class="page-shell">
    <header class="pb-14" data-reveal>
      <a href={`${base}/tags`} class="text-sm font-semibold" style="color: var(--brand-deep);">← 全部标签</a>
      <p class="eyebrow mt-10">Topic collection</p>
      <h1 class="font-display text-5xl font-black sm:text-6xl">#{tag}</h1>
      <p class="mt-5 text-lg" style="color: var(--muted);">这条阅读路径收录 {posts.length} 篇文章。</p>
    </header>
    <div class="grid gap-6 border-t pt-10 md:grid-cols-2 lg:grid-cols-3" style="border-color: var(--line);">
      {posts.map((post, index) => <PostCard title={post.data.title} description={post.data.description} date={post.data.pubDate.toISOString()} tags={post.data.tags} slug={post.id} image={post.data.cover} category={post.data.category} readingTime={calculateReadingTime(post.body ?? '')} index={index + 1} reveal revealOrder={index % 3} />)}
    </div>
  </main>
  <Footer />
</Layout>
