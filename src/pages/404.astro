---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="404 - 页面未找到 - YMLL Blog" description="页面迷路了，但探索的乐趣还在 ✨">
  <Header />

  <main class="pt-20 pb-16 min-h-screen flex flex-col">
    <div class="flex-1 flex items-center justify-center">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        {/* 动画 emoji */}
        <div id="floating-emoji" class="text-8xl mb-8" style="animation: float 3s ease-in-out infinite;">
          🚀
        </div>

        {/* 404 大字 */}
        <h1 class="text-[8rem] md:text-[12rem] font-bold leading-none mb-4">
          <span class="bg-gradient-to-r from-purple-500 to-green-500 bg-clip-text text-transparent">
            404
          </span>
        </h1>

        {/* 标题 */}
        <h2 class="text-2xl md:text-3xl font-bold text-stone-900 mb-4">
          页面去旅行了
        </h2>

        {/* 描述 */}
        <p class="text-lg text-stone-600 mb-8 max-w-md mx-auto">
          抱歉，您访问的页面似乎已经离开了这个星球。也许它正在某个角落等待被发现。
        </p>

        {/* 按钮 */}
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-12">
          <a
            href={`${base}/`}
            class="px-8 py-4 bg-gradient-to-r from-purple-500 to-green-500 text-white font-bold rounded-btn shadow-lg hover:shadow-xl transition-all hover:-translate-y-1 inline-flex items-center gap-2"
          >
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
            </svg>
            返回首页
          </a>
          <a
            href={`${base}/blog`}
            class="px-8 py-4 bg-white text-stone-700 font-bold rounded-btn border-2 border-stone-200 hover:border-purple-300 shadow-sm hover:shadow-md transition-all hover:-translate-y-1"
          >
            浏览文章
          </a>
        </div>

        {/* 搜索建议 */}
        <div class="bg-white rounded-2xl shadow-card p-6 max-w-md mx-auto mb-8">
          <h3 class="text-lg font-bold text-stone-900 mb-4">🔍 找不到页面？</h3>
          <ul class="text-left space-y-3">
            <li>
              <a href={`${base}/blog`} class="flex items-center gap-3 p-3 rounded-lg hover:bg-stone-50 transition-colors">
                <span class="text-xl">📚</span>
                <div>
                  <div class="font-medium text-stone-900">浏览博客文章</div>
                  <div class="text-sm text-stone-500">查看所有技术文章</div>
                </div>
              </a>
            </li>
            <li>
              <a href={`${base}/tags`} class="flex items-center gap-3 p-3 rounded-lg hover:bg-stone-50 transition-colors">
                <span class="text-xl">🏷️</span>
                <div>
                  <div class="font-medium text-stone-900">探索标签</div>
                  <div class="text-sm text-stone-500">按标签查找内容</div>
                </div>
              </a>
            </li>
            <li>
              <a href={`${base}/about`} class="flex items-center gap-3 p-3 rounded-lg hover:bg-stone-50 transition-colors">
                <span class="text-xl">👤</span>
                <div>
                  <div class="font-medium text-stone-900">了解作者</div>
                  <div class="text-sm text-stone-500">关于我的更多信息</div>
                </div>
              </a>
            </li>
          </ul>
        </div>

        {/* 彩蛋提示 */}
        <p class="text-sm text-stone-400">
          💡 小提示：按 <kbd class="px-2 py-1 bg-stone-100 rounded text-stone-600 font-mono text-xs">H</kbd> 键回家
        </p>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .shadow-card {
    box-shadow: 0 15px 35px rgba(50, 50, 93, .1), 0 5px 15px rgba(0, 0, 0, .07);
  }

  @keyframes float {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-20px) rotate(10deg); }
  }
</style>

<script is:inline>
// 键盘快捷键：按 H 返回首页
document.addEventListener('keydown', function(e) {
  if (e.key.toLowerCase() === 'h' && !e.target.matches('input, textarea')) {
    window.location.href = '/ymllblog/';
  }
});

// 随机切换 emoji
var emojis = ['🚀', '🌙', '✨', '🎯', '🌟', '💫', '🔮', '🎪'];
var emojiEl = document.getElementById('floating-emoji');
if (emojiEl) {
  setInterval(function() {
    emojiEl.textContent = emojis[Math.floor(Math.random() * emojis.length)];
  }, 3000);
}
</script>
