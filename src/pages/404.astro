---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="YMLL Blog - 404">
  <Header />

  <main class="pt-16 min-h-screen flex flex-col">
    <section class="flex-1 flex items-center justify-center max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
      <div class="text-center">
        <h1 class="text-8xl font-bold text-primary dark:text-primary-400 mb-4">404</h1>
        <h2 class="text-2xl font-semibold text-text dark:text-text-dark mb-4">页面未找到</h2>
        <p class="text-text-muted dark:text-gray-400 mb-8">
          抱歉，您访问的页面不存在或已被移除。
        </p>
        <a
          href="/"
          class="inline-flex items-center px-6 py-3 bg-primary text-white rounded-lg hover:bg-primary-700 transition-colors"
        >
          返回首页
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
