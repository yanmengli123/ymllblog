---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Layout title="页面未找到｜YMLL Blog" description="你访问的页面不存在。">
  <Header />
  <main id="main-content" class="site-shell grid min-h-[75vh] place-items-center pb-20 pt-32 text-center">
    <div data-reveal><p class="font-display text-[8rem] font-black leading-none opacity-10 sm:text-[12rem]">404</p><p class="eyebrow mt-6">Lost field note</p><h1 class="font-display text-4xl font-bold sm:text-5xl">这页笔记可能被移动了。</h1><p class="mx-auto mt-5 max-w-lg leading-7" style="color: var(--muted);">没有关系，知识花园里还有许多路径可以继续探索。</p><div class="mt-8 flex flex-wrap justify-center gap-3"><a href={`${base}/`} class="button-primary">返回首页</a><a href={`${base}/blog`} class="button-secondary">浏览文章</a></div></div>
  </main>
  <Footer />
</Layout>
