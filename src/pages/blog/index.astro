---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PostCard from '../../components/PostCard.astro';
import { calculateReadingTime } from '../../lib/reading-time';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const tagMap = new Map<string, number>();
posts.forEach((post) => post.data.tags.forEach((tag) => tagMap.set(tag, (tagMap.get(tag) || 0) + 1)));
const popularTags = [...tagMap.entries()].sort((a, b) => b[1] - a[1]).slice(0, 10);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="全部文章｜YMLL Blog" description="浏览 YMLL 关于前端工程、计算生物学与持续学习的全部文章。">
  <Header />
  <main id="main-content" class="page-shell">
    <header class="grid gap-10 pb-14 lg:grid-cols-[1fr_0.65fr] lg:items-end" data-reveal>
      <div><p class="eyebrow">Writing archive</p><h1 class="font-display text-5xl font-black sm:text-6xl">全部文章</h1><p class="mt-5 max-w-2xl text-lg leading-8" style="color: var(--muted);">共 {posts.length} 篇公开笔记。关注技术系统如何构建、复杂问题如何解释，以及学习如何转化为长期能力。</p></div>
      <div class="flex flex-wrap gap-2 lg:justify-end">{popularTags.map(([tag, count]) => <a href={`${base}/tags/${tag}`} class="tag-pill">#{tag} · {count}</a>)}</div>
    </header>
    <div class="grid gap-6 border-t pt-10 md:grid-cols-2 lg:grid-cols-3" style="border-color: var(--line);">
      {posts.map((post, index) => <PostCard title={post.data.title} description={post.data.description} date={post.data.pubDate.toISOString()} tags={post.data.tags} slug={post.id} image={post.data.cover} category={post.data.category} readingTime={calculateReadingTime(post.body ?? '')} index={index + 1} reveal revealOrder={index % 3} />)}
    </div>
    {posts.length === 0 && <div class="surface rounded-3xl p-12 text-center"><h2 class="font-display text-2xl">内容正在整理中</h2><p class="mt-2" style="color: var(--muted);">稍后再来看看。</p></div>}
  </main>
  <Footer />
</Layout>
