---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PostCard from '../components/PostCard.astro';
import MusicPlayer from '../components/MusicPlayer.astro';
import ActivityCalendar from '../components/home/ActivityCalendar.astro';
import CultivatedFeed from '../components/home/CultivatedFeed.astro';
import TopicGarden from '../components/home/TopicGarden.astro';
import Projects from '../components/home/Projects.astro';
import ResearchShelf from '../components/home/ResearchShelf.astro';
import GardenGrowth from '../components/home/GardenGrowth.astro';
import GardenInteractions from '../components/home/GardenInteractions.astro';
import { getGardenDashboard } from '../lib/garden';
import { calculateReadingTime } from '../lib/reading-time';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const dashboard = await getGardenDashboard();
const { posts, garden, featured, recentlyPublished, recentlyCultivated, topics, activity, projects, research, reading, years, stats } = dashboard;
const lead = featured[0];
const otherFeatured = featured.slice(1);
const statusLabel = { available: '可交流', building: '构建中', writing: '写作中', researching: '研究中' };
const status = garden?.status ?? 'building';
const wordLabel = stats.words >= 10_000 ? `${(stats.words / 10_000).toFixed(1)} 万` : stats.words.toLocaleString('zh-CN');
const randomNotes = posts.map((post) => ({ title: post.data.title, url: `${base}/blog/${post.id}` }));
---

<Layout motion="expressive" title="YMLL Digital Garden｜工程、研究与长期思考" description="一个持续生长的个人数字花园：记录前端工程、计算生物学、研究问题、项目与阅读。">
  <Header />
  <main id="main-content">
    <section class="garden-hero site-shell pb-20 pt-32 lg:pt-28">
      <div class="today-strip" data-hero style="--hero-order: 0;">
        <span class="today-status"><i class="now-pulse"></i>{statusLabel[status]}</span>
        <span data-garden-clock data-timezone={garden?.timezone ?? 'Asia/Shanghai'}>正在读取本地时间</span>
        <span class="today-location">YMLL · Digital Garden</span>
      </div>
      <div class="grid items-start gap-14 pt-14 lg:grid-cols-[1.12fr_0.88fr] lg:gap-20">
        <div class="hero-stage">
          <p class="eyebrow" data-hero style="--hero-order: 1;">Independent research & engineering</p>
          <h1 class="max-w-5xl font-display text-5xl font-black leading-[1.06] sm:text-6xl lg:text-[4.7rem]" data-hero data-hero-primary style="--hero-order: 2;">
            写代码，也记录<br /><span class="garden-hero-accent">知识如何生长。</span>
          </h1>
          <p class="mt-8 max-w-2xl text-lg leading-8 sm:text-xl" data-hero style="--hero-order: 3; color: var(--muted);">你好，我是 YMLL。这里不是静态作品集，而是一座持续更新的数字花园：把工程实践、研究问题、项目和阅读连接成可追溯的知识网络。</p>
          <div class="mt-9 flex flex-wrap gap-3" data-hero style="--hero-order: 4;">
            <a href={`${base}/blog`} class="button-primary">进入花园 <span class="ml-2" aria-hidden="true">→</span></a>
            <button class="button-secondary" type="button" data-open-command>搜索知识库 <kbd>⌘ K</kbd></button>
            <button class="button-secondary" type="button" data-random-note data-random-note={JSON.stringify(randomNotes)}>随机一篇</button>
          </div>
          <dl class="garden-stats mt-12" data-hero style="--hero-order: 5;">
            <div><dt>公开笔记</dt><dd data-count={stats.notes}>{String(stats.notes).padStart(2, '0')}</dd></div>
            <div><dt>知识主题</dt><dd data-count={stats.topics}>{String(stats.topics).padStart(2, '0')}</dd></div>
            <div><dt>活跃项目</dt><dd data-count={stats.projects}>{String(stats.projects).padStart(2, '0')}</dd></div>
            <div><dt>累计字数</dt><dd>{wordLabel}</dd></div>
          </dl>
        </div>

        {garden && <aside class="now-card hero-stage" aria-labelledby="now-heading">
          <div class="hero-parallax now-card-back" aria-hidden="true"></div>
          <div class="surface relative rounded-[2rem] p-7 sm:p-9" data-hero style="--hero-order: 3;">
            <div class="now-card-header"><span>NOW / {new Date(garden.updatedAt).getFullYear()}</span><span><i class="now-pulse"></i>{statusLabel[garden.status]}</span></div>
            <div class="py-8">
              <p class="now-label">当前核心问题</p>
              <h2 id="now-heading" class="mt-4 font-display text-3xl font-bold leading-snug">{garden.headline}</h2>
              <p class="mt-5 text-sm leading-7" style="color: var(--muted);">{garden.summary}</p>
            </div>
            <div class="now-progress-list">
              <div><div><span>正在构建</span><strong>{garden.building.title}</strong><small>{garden.building.detail}</small></div><b>{garden.building.progress}%</b><i><em style={`--progress: ${garden.building.progress / 100};`}></em></i></div>
              <div><div><span>正在阅读</span><strong>{garden.reading.title}</strong><small>{garden.reading.detail}</small></div><b>{garden.reading.progress}%</b><i><em style={`--progress: ${garden.reading.progress / 100};`}></em></i></div>
            </div>
            <div class="now-topics">{garden.exploring.map((topic) => <span>{topic}</span>)}</div>
          </div>
        </aside>}
      </div>
    </section>

    {lead && <section class="site-shell py-20 section-rule" aria-labelledby="featured-heading">
      <div class="section-heading-row" data-reveal><div><p class="eyebrow">Featured writing</p><h2 id="featured-heading" class="font-display text-4xl font-bold sm:text-5xl">编辑精选</h2></div><a href={`${base}/blog`} class="section-link">查看全部文章 →</a></div>
      <div class="featured-layout mt-10">
        <PostCard title={lead.data.title} description={lead.data.description} date={lead.data.pubDate.toISOString()} tags={lead.data.tags} slug={lead.id} image={lead.data.cover} category={lead.data.category} readingTime={calculateReadingTime(lead.body ?? '')} maturity={lead.data.maturity} featured index={1} />
        {otherFeatured.length > 0 && <div class="featured-side">
          {otherFeatured.map((post, index) => <PostCard title={post.data.title} description={post.data.description} date={post.data.pubDate.toISOString()} tags={post.data.tags} slug={post.id} image={post.data.cover} category={post.data.category} readingTime={calculateReadingTime(post.body ?? '')} maturity={post.data.maturity} index={index + 2} reveal revealOrder={index} />)}
        </div>}
      </div>
    </section>}

    <ActivityCalendar activity={activity} />
    <CultivatedFeed published={recentlyPublished} cultivated={recentlyCultivated} />
    <TopicGarden topics={topics} />
    <Projects projects={projects} />

    <section class="site-shell py-20 section-rule" aria-label="随机探索与内容统计">
      <div class="discovery-grid">
        <div class="random-note-card" data-reveal>
          <span class="random-orbit" aria-hidden="true">✦</span><p class="eyebrow">Serendipity</p><h2>让一篇旧笔记<br />重新遇见你。</h2><p>有些连接不会出现在时间顺序里。让花园随机选择下一条阅读路径。</p>
          <button type="button" data-random-note data-random-note={JSON.stringify(randomNotes)}>随机漫游 <span aria-hidden="true">↗</span></button>
        </div>
        <div class="content-metrics surface" data-reveal style="--reveal-order: 1;">
          <p class="eyebrow">Content metrics</p><h2>不是流量仪表盘，<br />而是积累的证据。</h2>
          <dl><div><dt>公开内容</dt><dd>{stats.notes}<small> 篇</small></dd></div><div><dt>累计字数</dt><dd>{wordLabel}</dd></div><div><dt>主题节点</dt><dd>{stats.topics}<small> 个</small></dd></div><div><dt>成长年份</dt><dd>{years.length}<small> 年</small></dd></div></dl>
        </div>
      </div>
    </section>

    <ResearchShelf research={research} reading={reading} />
    <GardenGrowth years={years} />
    <MusicPlayer />
  </main>
  <Footer />
  <GardenInteractions />
</Layout>
