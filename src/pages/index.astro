---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HeroSection from '../components/HeroSection.astro';
import FeaturedPosts from '../components/FeaturedPosts.astro';
import TagsSection from '../components/TagsSection.astro';
import SettingsPanel from '../components/SettingsPanel.astro';
import MusicPlayer from '../components/MusicPlayer.astro';
import Announcement from '../components/Announcement.astro';
import ProfileCard from '../components/ProfileCard.astro';
import SiteStatsCard from '../components/SiteStatsCard.astro';
import PostCalendarCard from '../components/PostCalendarCard.astro';
import ParticlesBg from '../components/ParticlesBg.astro';

// 获取精选文章
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const featuredPosts = allPosts
  .filter(post => post.data.featured)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 5);

// 格式化文章数据
const formattedPosts = featuredPosts.map(post => ({
  title: post.data.title,
  description: post.data.description,
  date: post.data.pubDate.toISOString(),
  tags: post.data.tags,
  slug: post.slug,
  image: post.data.cover,
  readingTime: '5 分钟',
}));

// 获取标签统计
const tagMap = new Map<string, number>();
allPosts.forEach(post => {
  post.data.tags.forEach(tag => {
    tagMap.set(tag, (tagMap.get(tag) || 0) + 1);
  });
});
const tags = Array.from(tagMap.entries())
  .map(([name, count]) => ({ name, count }))
  .sort((a, b) => b.count - a.count)
  .slice(0, 8);

const HomeSidebarLayout = 'home-sidebar-layout';
---

<Layout title="YMLL Blog - 首页" description="探索技术与设计的交汇点，记录成长与思考">
  {/* 粒子背景层 */}
  <ParticlesBg />

  <Header />

  <main>
    {/* 全屏 Hero */}
    <HeroSection />

    {/* 毛玻璃内容面板 - dlog.com.cn 风格 */}
    <div class="relative z-10" style="margin-top: -2rem;">
      <div class="mx-auto max-w-[1440px] px-4 sm:px-6 lg:px-8">
        <div id="board" class={`glass-board ${HomeSidebarLayout}`}>
          <aside id="home-left-sidebar" class="home-sidebar home-sidebar-left" aria-label="左侧信息栏">
            <ProfileCard />
            <Announcement variant="sidebar" />
            <MusicPlayer variant="sidebar" />
          </aside>

          <main id="home-feed" class="min-w-0">
            <FeaturedPosts posts={formattedPosts} title="精选文章" />
            <TagsSection tags={tags} />
          </main>

          <aside id="home-right-sidebar" class="home-sidebar home-sidebar-right" aria-label="右侧工具栏">
            <SettingsPanel variant="sidebar" />
            <SiteStatsCard />
            <PostCalendarCard />
          </aside>
        </div>
      </div>
    </div>
  </main>

  <Footer />

  {/* 滚动动画脚本 */}
  <script>
    // 卡片滚动动画 - dlog.com.cn 风格
    document.addEventListener('DOMContentLoaded', function() {
      const cards = document.querySelectorAll('.post-card-animate');
      if (cards.length === 0) return;

      const coefficient = window.innerWidth > 768 ? 0.5 : 0.3;
      const origin = window.innerHeight - (cards[0] as HTMLElement).getBoundingClientRect().height * coefficient;

      function throttle(fn: Function, wait: number) {
        let timer: ReturnType<typeof setTimeout> | null = null;
        return function(this: any, ...args: any[]) {
          if (!timer) {
            timer = setTimeout(function() {
              fn.apply(this, args);
              timer = null;
            }, wait);
          }
        };
      }

      function handle() {
        cards.forEach(card => {
          const rect = (card as HTMLElement).getBoundingClientRect();
          const state = (rect.top - origin) < 0 ? 1 : 0;
          (card as HTMLElement).style.setProperty('--state', String(state));
        });
      }

      window.addEventListener('scroll', throttle(handle, 100));
      handle(); // 初始触发
    });

    // 视差效果
    document.addEventListener('DOMContentLoaded', function() {
      const banner = document.getElementById('hero-banner');
      const board = document.getElementById('board');

      if (!banner || !board) return;

      function parallax() {
        const scrollTop = window.scrollY;
        const pxv = scrollTop / 5;
        const offset = parseInt(getComputedStyle(board).marginTop) || 0;
        const max = 96 + offset;
        const translate = Math.min(pxv, max);

        banner.style.transform = `translate3d(0, ${translate}px, 0)`;
      }

      window.addEventListener('scroll', parallax);
    });

    // 主题初始应用
    (function() {
      try {
        const settings = JSON.parse(localStorage.getItem('ymll_user_settings') || 'null');
        const body = document.body;
        // 始终先清除所有背景类
        body.classList.remove('theme-bg-aurora', 'theme-bg-gradient', 'theme-bg-waves', 'theme-bg-mesh', 'theme-bg-stars', 'theme-bg-image', 'theme-bg-solid', 'theme-bg-particles');
        if (settings && settings.backgroundMode) {
          body.classList.add('theme-bg-' + settings.backgroundMode);
          if (settings.backgroundMode === 'image' && settings.customBackground) {
            body.style.setProperty('--custom-bg-image', `url('${settings.customBackground}')`);
          }
        } else {
          // 默认使用蓝紫渐变
          body.classList.add('theme-bg-gradient');
        }
      } catch (e) {
        // 默认使用蓝紫渐变
        document.body.classList.add('theme-bg-gradient');
      }
    })();
  </script>
</Layout>
