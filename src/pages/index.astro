---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HeroSection from '../components/HeroSection.astro';
import FeaturedPosts from '../components/FeaturedPosts.astro';
import TagsSection from '../components/TagsSection.astro';
import StatsChart from '../components/StatsChart.astro';
import ParticleEffect from '../components/ParticleEffect.astro';

// 获取精选文章
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const featuredPosts = allPosts
  .filter(post => post.data.featured)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 5);

// 格式化文章数据
const formattedPosts = featuredPosts.map(post => ({
  title: post.data.title,
  description: post.data.description,
  date: post.data.pubDate.toISOString(),
  tags: post.data.tags,
  slug: post.slug,
  image: post.data.cover,
  readingTime: '5 分钟',
}));

// 获取标签统计
const tagMap = new Map<string, number>();
allPosts.forEach(post => {
  post.data.tags.forEach(tag => {
    tagMap.set(tag, (tagMap.get(tag) || 0) + 1);
  });
});
const tags = Array.from(tagMap.entries())
  .map(([name, count]) => ({ name, count }))
  .sort((a, b) => b.count - a.count)
  .slice(0, 8);

// 统计数据
const totalPosts = allPosts.length;
const totalTags = tagMap.size;
---

<Layout title="YMLL Blog - 首页" description="探索技术与设计的交汇点，记录成长与思考">
  <!-- 鼠标粒子效果 -->
  <ParticleEffect />

  <Header />

  <main>
    <HeroSection />
    <FeaturedPosts posts={formattedPosts} title="精选文章" />
    <TagsSection tags={tags} />

    <!-- 数据统计图表 -->
    <StatsChart />
  </main>

  <Footer />
</Layout>
