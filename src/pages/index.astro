---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AnimatedPostCard from '../components/AnimatedPostCard';

const posts = [
  {
    title: '欢迎来到 YMLL Blog',
    description: '这是一个使用 Astro + Tailwind CSS + Framer Motion 构建的企业级个人博客。',
    date: '2024-01-15',
    tags: ['博客', '技术'],
    slug: 'welcome',
    readingTime: '2 分钟',
  },
  {
    title: 'Astro 岛屿架构详解',
    description: '深入了解 Astro 的岛屿架构，以及如何用它构建高性能网站。',
    date: '2024-01-10',
    tags: ['Astro', '前端'],
    slug: 'astro-islands',
    readingTime: '5 分钟',
  },
  {
    title: 'Tailwind CSS 最佳实践',
    description: '掌握 Tailwind CSS 的设计系统和组件化开发技巧。',
    date: '2024-01-05',
    tags: ['CSS', 'Tailwind'],
    slug: 'tailwind-best-practices',
    readingTime: '4 分钟',
  },
];
---

<Layout title="YMLL Blog - 首页">
  <Header />

  <main class="pt-16">
    <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
      <div class="text-center">
        <h1 class="text-4xl sm:text-5xl font-bold text-text dark:text-text-dark mb-6 animate-fade-in-up">
          你好，我是 <span class="text-primary dark:text-primary-400">YMLL</span>
        </h1>
        <p class="text-lg text-text-muted dark:text-gray-400 mb-8 max-w-2xl mx-auto animate-fade-in-up" style="animation-delay: 0.1s;">
          一个热爱技术与设计的开发者，在这里记录我的思考、项目与成长
        </p>
        <div class="flex justify-center gap-4 animate-fade-in-up" style="animation-delay: 0.2s;">
          <a
            href="/blog"
            class="px-6 py-3 bg-primary text-white rounded-lg hover:bg-primary-700 transition-colors"
          >
            阅读博客
          </a>
          <a
            href="/about"
            class="px-6 py-3 border border-primary text-primary dark:text-primary-400 rounded-lg hover:bg-primary/10 transition-colors"
          >
            了解更多
          </a>
        </div>
      </div>
    </section>

    <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pb-20">
      <h2 class="text-2xl font-bold text-text dark:text-text-dark mb-8">最新文章</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {posts.map((post, index) => (
          <AnimatedPostCard
            client:load
            title={post.title}
            description={post.description}
            date={post.date}
            tags={post.tags}
            slug={post.slug}
            readingTime={post.readingTime}
            index={index}
          />
        ))}
      </div>
    </section>
  </main>

  <Footer />
</Layout>
