---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HeroSection from '../components/HeroSection.astro';
import FeaturedPosts from '../components/FeaturedPosts.astro';
import TagsSection from '../components/TagsSection.astro';

// 获取精选文章
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const featuredPosts = allPosts
  .filter(post => post.data.featured)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 5);

// 格式化文章数据
const formattedPosts = featuredPosts.map(post => ({
  title: post.data.title,
  description: post.data.description,
  date: post.data.pubDate.toISOString(),
  tags: post.data.tags,
  slug: post.slug,
  image: post.data.cover,
  readingTime: '5 分钟',
}));

// 获取标签统计
const tagMap = new Map<string, number>();
allPosts.forEach(post => {
  post.data.tags.forEach(tag => {
    tagMap.set(tag, (tagMap.get(tag) || 0) + 1);
  });
});
const tags = Array.from(tagMap.entries())
  .map(([name, count]) => ({ name, count }))
  .sort((a, b) => b.count - a.count)
  .slice(0, 8);

// 统计数据
const totalPosts = allPosts.length;
const totalTags = tagMap.size;
---

<Layout title="YMLL Blog - 首页" description="探索技术与设计的交汇点，记录成长与思考">
  <Header />

  <main>
    <HeroSection />
    <FeaturedPosts posts={formattedPosts} title="精选文章" />
    <TagsSection tags={tags} />

    <!-- 统计数据 -->
    <section class="py-20">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
          <div class="text-center p-6 bg-white rounded-2xl border border-stone-200">
            <div class="text-3xl font-bold text-emerald-600 mb-2">{totalPosts}</div>
            <div class="text-sm text-stone-500">篇文章</div>
          </div>
          <div class="text-center p-6 bg-white rounded-2xl border border-stone-200">
            <div class="text-3xl font-bold text-emerald-600 mb-2">{totalTags}</div>
            <div class="text-sm text-stone-500">个标签</div>
          </div>
          <div class="text-center p-6 bg-white rounded-2xl border border-stone-200">
            <div class="text-3xl font-bold text-emerald-600 mb-2">100+</div>
            <div class="text-sm text-stone-500">小时写作</div>
          </div>
          <div class="text-center p-6 bg-white rounded-2xl border border-stone-200">
            <div class="text-3xl font-bold text-emerald-600 mb-2">5000+</div>
            <div class="text-sm text-stone-500">字内容</div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
