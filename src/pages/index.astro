---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HeroSection from '../components/HeroSection.astro';
import FeaturedPosts from '../components/FeaturedPosts.astro';
import TagsSection from '../components/TagsSection.astro';

const posts = [
  {
    title: '使用 Astro 构建高性能博客',
    description: '深入了解如何利用 Astro 的岛屿架构打造极致性能的现代博客，实现毫秒级页面加载和完美的 SEO 表现。',
    date: '2024-01-15',
    tags: ['Astro', '性能优化', '前端'],
    slug: 'build-blog-with-astro',
    readingTime: '8 分钟',
    image: 'https://images.unsplash.com/photo-1461749280684-dccba630e2f6?w=800&q=80',
  },
  {
    title: 'Tailwind CSS 设计系统最佳实践',
    description: '掌握 Tailwind CSS 的设计系统配置，创建一致且可维护的用户界面，提升开发效率。',
    date: '2024-01-10',
    tags: ['Tailwind', 'CSS', '设计系统'],
    slug: 'tailwind-design-system',
    readingTime: '6 分钟',
    image: 'https://images.unsplash.com/photo-1507721999472-8ed4421c4af2?w=800&q=80',
  },
  {
    title: 'React 19 新特性抢先看',
    description: '探索 React 19 带来的革命性特性，包括 Server Components、Actions 和新的 Hooks。',
    date: '2024-01-05',
    tags: ['React', '前端', 'JavaScript'],
    slug: 'react-19-features',
    readingTime: '10 分钟',
    image: 'https://images.unsplash.com/photo-1633356122544-f134324a6cee?w=800&q=80',
  },
  {
    title: 'TypeScript 高级类型体操',
    description: '深入 TypeScript 类型系统，掌握泛型、条件类型、映射类型等高级特性。',
    date: '2023-12-28',
    tags: ['TypeScript', '类型系统'],
    slug: 'typescript-advanced-types',
    readingTime: '12 分钟',
  },
  {
    title: 'Framer Motion 动效实战',
    description: '使用 Framer Motion 创建流畅的用户界面动画，提升用户体验。',
    date: '2023-12-20',
    tags: ['Framer Motion', 'React', '动效'],
    slug: 'framer-motion-tutorial',
    readingTime: '7 分钟',
  },
];

const tags = [
  { name: '前端', count: 12 },
  { name: 'React', count: 8 },
  { name: 'Astro', count: 5 },
  { name: 'TypeScript', count: 6 },
  { name: 'Tailwind', count: 4 },
  { name: '设计系统', count: 3 },
  { name: '性能优化', count: 4 },
  { name: 'JavaScript', count: 9 },
];
---

<Layout title="YMLL Blog - 首页" description="探索技术与设计的交汇点，记录成长与思考">
  <Header />

  <main>
    <HeroSection />
    <FeaturedPosts posts={posts} />
    <TagsSection tags={tags} />
  </main>

  <Footer />
</Layout>
