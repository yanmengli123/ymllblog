---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HeroSection from '../components/HeroSection.astro';
import FeaturedPosts from '../components/FeaturedPosts.astro';
import TagsSection from '../components/TagsSection.astro';
import StatsChart from '../components/StatsChart.astro';
import SettingsPanel from '../components/SettingsPanel.astro';
import MusicPlayer from '../components/MusicPlayer.astro';
import Announcement from '../components/Announcement.astro';
import FloatingAvatar from '../components/FloatingAvatar.astro';
import ParticlesBg from '../components/ParticlesBg.astro';

// 获取精选文章
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const featuredPosts = allPosts
  .filter(post => post.data.featured)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 5);

// 格式化文章数据
const formattedPosts = featuredPosts.map(post => ({
  title: post.data.title,
  description: post.data.description,
  date: post.data.pubDate.toISOString(),
  tags: post.data.tags,
  slug: post.slug,
  image: post.data.cover,
  readingTime: '5 分钟',
}));

// 获取标签统计
const tagMap = new Map<string, number>();
allPosts.forEach(post => {
  post.data.tags.forEach(tag => {
    tagMap.set(tag, (tagMap.get(tag) || 0) + 1);
  });
});
const tags = Array.from(tagMap.entries())
  .map(([name, count]) => ({ name, count }))
  .sort((a, b) => b.count - a.count)
  .slice(0, 8);
---

<Layout title="YMLL Blog - 首页" description="探索技术与设计的交汇点，记录成长与思考">
  {/* 粒子背景层 */}
  <ParticlesBg />

  <Header />

  <main>
    {/* 全屏 Hero */}
    <HeroSection />

    {/* 毛玻璃内容面板 - dlog.com.cn 风格 */}
    <div class="relative z-10" style="margin-top: -2rem;">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div id="board" class="glass-board p-6 sm:p-8 lg:p-10">
          <FeaturedPosts posts={formattedPosts} title="精选文章" />
          <TagsSection tags={tags} />
          <StatsChart />
        </div>
      </div>
    </div>
  </main>

  <Footer />

  {/* 个性化设置面板 */}
  <SettingsPanel />

  {/* 浮动头像 */}
  <FloatingAvatar />

  {/* 音乐播放器 */}
  <MusicPlayer />

  {/* 公告 */}
  <Announcement />

  {/* 滚动动画脚本 */}
  <script>
    // 卡片滚动动画 - dlog.com.cn 风格
    document.addEventListener('DOMContentLoaded', function() {
      const cards = document.querySelectorAll('.post-card-animate');
      if (cards.length === 0) return;

      const coefficient = window.innerWidth > 768 ? 0.5 : 0.3;
      const origin = window.innerHeight - (cards[0] as HTMLElement).getBoundingClientRect().height * coefficient;

      function throttle(fn: Function, wait: number) {
        let timer: ReturnType<typeof setTimeout> | null = null;
        return function(this: any, ...args: any[]) {
          if (!timer) {
            timer = setTimeout(function() {
              fn.apply(this, args);
              timer = null;
            }, wait);
          }
        };
      }

      function handle() {
        cards.forEach(card => {
          const rect = (card as HTMLElement).getBoundingClientRect();
          const state = (rect.top - origin) < 0 ? 1 : 0;
          (card as HTMLElement).style.setProperty('--state', String(state));
        });
      }

      window.addEventListener('scroll', throttle(handle, 100));
      handle(); // 初始触发
    });

    // 视差效果
    document.addEventListener('DOMContentLoaded', function() {
      const banner = document.getElementById('hero-banner');
      const board = document.getElementById('board');

      if (!banner || !board) return;

      function parallax() {
        const scrollTop = window.scrollY;
        const pxv = scrollTop / 5;
        const offset = parseInt(getComputedStyle(board).marginTop) || 0;
        const max = 96 + offset;
        const translate = Math.min(pxv, max);

        banner.style.transform = `translate3d(0, ${translate}px, 0)`;
      }

      window.addEventListener('scroll', parallax);
    });

    // 主题初始应用
    (function() {
      try {
        const settings = JSON.parse(localStorage.getItem('ymll_user_settings') || 'null');
        const body = document.body;
        // 始终先清除所有背景类
        body.classList.remove('bg-aurora', 'bg-gradient', 'bg-waves', 'bg-mesh', 'bg-stars', 'bg-image', 'bg-solid', 'bg-particles');
        if (settings && settings.backgroundMode) {
          body.classList.add('bg-' + settings.backgroundMode);
          if (settings.backgroundMode === 'image' && settings.customBackground) {
            body.style.setProperty('--custom-bg-image', `url('${settings.customBackground}')`);
          }
        } else {
          // 默认使用蓝紫渐变
          body.classList.add('bg-gradient');
        }
      } catch (e) {
        // 默认使用蓝紫渐变
        document.body.classList.add('bg-gradient');
      }
    })();
  </script>
</Layout>
