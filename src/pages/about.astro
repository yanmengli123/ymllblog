---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const principles = [
  ['01', '先理解问题', '工具会变化，问题的结构更持久。写代码前，我会先澄清边界、约束与验证标准。'],
  ['02', '用证据迭代', '让数据、测试和真实反馈参与决策，而不是只凭感觉追逐新技术。'],
  ['03', '为长期维护', '好的系统不仅能运行，还应当可理解、可演进，并对下一位维护者友好。'],
];
---

<Layout title="关于 YMLL｜YMLL Blog" description="认识 YMLL：关注前端工程、计算生物学和长期学习的独立写作者。">
  <Header />
  <main id="main-content">
    <section class="site-shell grid min-h-[680px] items-center gap-14 pb-20 pt-32 lg:grid-cols-[1fr_0.8fr]">
      <div data-reveal><p class="eyebrow">About the author</p><h1 class="font-display text-5xl font-black leading-tight sm:text-6xl">你好，我是 YMLL。<br /><span style="color: var(--brand-deep);">一个持续提问的人。</span></h1><p class="mt-7 max-w-2xl text-lg leading-9" style="color: var(--muted);">我关注技术如何帮助人理解复杂系统，也关心一个产品如何从想法变成可靠、清晰、可持续维护的现实。这个博客是公开的学习记录，也是我与世界交换想法的方式。</p><div class="mt-9 flex flex-wrap gap-3"><a href={`${base}/blog`} class="button-primary">阅读我的文章</a><a href="https://github.com/yanmengli123" target="_blank" rel="noopener noreferrer" class="button-secondary">GitHub ↗</a></div></div>
      <div class="motion-card surface relative overflow-hidden rounded-[2rem] p-8 sm:p-10" data-reveal style="--reveal-order: 1;">
        <span class="absolute -right-8 -top-14 font-display text-[13rem] font-black opacity-[0.05]">Y</span>
        <p class="text-xs font-semibold uppercase tracking-[0.2em]" style="color: var(--brand);">Focus areas</p>
        <div class="mt-8 space-y-7">
          <div><small style="color: var(--muted);">01 / 研究</small><h2 class="mt-2 font-display text-2xl font-bold">计算生物学与动态系统</h2></div>
          <div class="border-t pt-7" style="border-color: var(--line);"><small style="color: var(--muted);">02 / 工程</small><h2 class="mt-2 font-display text-2xl font-bold">前端架构与产品体验</h2></div>
          <div class="border-t pt-7" style="border-color: var(--line);"><small style="color: var(--muted);">03 / 表达</small><h2 class="mt-2 font-display text-2xl font-bold">技术写作与知识管理</h2></div>
        </div>
      </div>
    </section>
    <section class="site-shell py-20 section-rule">
      <div data-reveal><p class="eyebrow">Working principles</p><h2 class="font-display text-4xl font-bold sm:text-5xl">我如何工作</h2></div>
      <div class="mt-10 grid border-l border-t md:grid-cols-3" style="border-color: var(--line);">{principles.map(([number, title, description], index) => <article class="motion-card min-h-64 border-b border-r p-7 sm:p-9" style={`--reveal-order: ${index}; border-color: var(--line);`} data-reveal><span class="text-xs font-semibold" style="color: var(--brand);">{number}</span><h3 class="motion-card-title mt-10 font-display text-2xl font-bold">{title}</h3><p class="mt-4 text-sm leading-7" style="color: var(--muted);">{description}</p></article>)}</div>
    </section>
  </main>
  <Footer />
</Layout>
