---
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MermaidSupport from '../components/MermaidSupport.astro';
import GiscusComments from '../components/GiscusComments.astro';
import { getRelatedPosts } from '../lib/posts';
import { getPageURL } from '../lib/seo';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
interface Props {
  frontmatter: { title: string; description: string; pubDate: Date; updatedDate?: Date; author: string; tags: string[]; category?: string; cover?: string; draft: boolean; featured: boolean; lang: string; };
  headings: { depth: number; slug: string; text: string; }[];
  slug: string;
}
const { frontmatter, headings, slug } = Astro.props;
const toc = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);
const related = await getRelatedPosts({ id: slug, data: { tags: frontmatter.tags } }, 3);
const articleURL = getPageURL(`/blog/${slug}`);
const date = frontmatter.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
const updated = frontmatter.updatedDate?.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Layout motion="reading" title={`${frontmatter.title}｜YMLL Blog`} description={frontmatter.description} image={frontmatter.cover} type="article" publishedTime={frontmatter.pubDate} updatedTime={frontmatter.updatedDate} author={frontmatter.author} tags={frontmatter.tags}>
  <Header />
  <div id="reading-progress" class="reading-progress fixed left-0 right-0 top-0 z-[70] h-[3px]" style="background: var(--brand);"></div>
  <main id="main-content" class="pb-24 pt-28">
    <article>
      <header class="site-shell max-w-5xl py-10 sm:py-16" data-reveal>
        <a href={`${base}/blog`} class="text-sm font-semibold" style="color: var(--brand-deep);">← 返回文章</a>
        <div class="mt-10 flex flex-wrap items-center gap-3 text-xs" style="color: var(--muted);">
          {frontmatter.category && <span class="font-semibold uppercase tracking-[0.15em]" style="color: var(--brand-deep);">{frontmatter.category}</span>}
          <time datetime={frontmatter.pubDate.toISOString()}>{date}</time>
          {updated && <span>更新于 {updated}</span>}
        </div>
        <h1 class="mt-6 max-w-4xl font-display text-4xl font-black leading-[1.2] sm:text-6xl">{frontmatter.title}</h1>
        <p class="mt-7 max-w-3xl text-lg leading-8 sm:text-xl" style="color: var(--muted);">{frontmatter.description}</p>
        <div class="mt-8 flex flex-wrap items-center justify-between gap-5 border-t pt-6" style="border-color: var(--line);">
          <div class="flex items-center gap-3"><span class="grid h-11 w-11 place-items-center rounded-full text-sm font-bold" style="background: var(--brand-soft); color: var(--brand-deep);">{frontmatter.author[0]}</span><span><strong class="block text-sm">{frontmatter.author}</strong><small style="color: var(--muted);">独立写作者</small></span></div>
          <div class="flex flex-wrap gap-2">{frontmatter.tags.map((tag) => <a href={`${base}/tags/${tag}`} class="tag-pill">#{tag}</a>)}</div>
        </div>
      </header>

      {frontmatter.cover && <figure class="site-shell max-w-6xl pb-10" data-reveal><img src={frontmatter.cover} alt="" class="aspect-[16/8] w-full rounded-[2rem] border object-cover" style="border-color: var(--line);" loading="eager" /><figcaption class="sr-only">{frontmatter.title}</figcaption></figure>}

      <div class="site-shell grid max-w-6xl gap-12 lg:grid-cols-[minmax(0,1fr)_15rem]">
        <div class="min-w-0">
          {toc.length > 0 && <details class="surface mb-8 rounded-2xl p-5 lg:hidden"><summary class="cursor-pointer font-semibold">本文目录</summary><nav class="mt-4 grid gap-2" aria-label="移动端文章目录">{toc.map((heading) => <a href={`#${heading.slug}`} class:list={['text-sm hover:underline', heading.depth === 3 && 'pl-4']} style="color: var(--muted);">{heading.text}</a>)}</nav></details>}
          <div class="article-prose"><slot /></div>

          <div class="mt-14 flex flex-wrap items-center justify-between gap-5 border-y py-6" style="border-color: var(--line);">
            <p class="text-sm" style="color: var(--muted);">觉得有帮助？把它分享给需要的人。</p>
            <button id="share-article" data-share-url={articleURL} data-share-title={frontmatter.title} class="button-secondary"><span id="share-label">分享文章</span></button>
          </div>

          {related.length > 0 && <section class="mt-16" data-reveal><p class="eyebrow">Keep reading</p><h2 class="font-display text-3xl font-bold">继续阅读</h2><div class="mt-7 grid gap-4 sm:grid-cols-3">{related.map((post, index) => <a href={`${base}/blog/${post.id}`} class="motion-card surface group rounded-2xl p-5" style={`--reveal-order: ${index};`} data-reveal><small style="color: var(--brand);">0{index + 1}</small><h3 class="motion-card-title mt-5 font-display text-lg font-bold leading-snug group-hover:text-emerald-700 dark:group-hover:text-emerald-300">{post.data.title}</h3><time class="mt-4 block text-xs" style="color: var(--muted);">{post.data.pubDate.toLocaleDateString('zh-CN')}</time></a>)}</div></section>}

          <GiscusComments />
        </div>

        <aside class="hidden lg:block">
          <div class="sticky top-28">
            <p class="mb-4 text-xs font-semibold uppercase tracking-[0.18em]" style="color: var(--muted);">On this page</p>
            <nav class="border-l" style="border-color: var(--line);" aria-label="文章目录">
              {toc.length ? toc.map((heading) => <a href={`#${heading.slug}`} data-heading={heading.slug} class:list={['toc-link block border-l py-2 pl-4 text-sm transition hover:text-emerald-700', heading.depth === 3 && 'pl-7 text-xs']} style="border-color: transparent; color: var(--muted);">{heading.text}</a>) : <span class="block pl-4 text-sm" style="color: var(--muted);">短文，无目录</span>}
            </nav>
          </div>
        </aside>
      </div>
    </article>
  </main>
  <Footer />
  <MermaidSupport />
</Layout>

<script is:inline>
  const progress = document.getElementById('reading-progress');
  const tocLinks = [...document.querySelectorAll('.toc-link')];
  let readingFrame = 0;
  const updateReadingState = () => {
    readingFrame = 0;
    const height = document.documentElement.scrollHeight - innerHeight;
    const ratio = height > 0 ? Math.min(1, Math.max(0, scrollY / height)) : 0;
    if (progress) progress.style.transform = `scaleX(${ratio})`;
    let current = '';
    tocLinks.forEach((link) => { const heading = document.getElementById(link.dataset.heading || ''); if (heading && heading.offsetTop <= scrollY + 150) current = link.dataset.heading || ''; });
    tocLinks.forEach((link) => { const active = link.dataset.heading === current; link.style.borderColor = active ? 'var(--brand)' : 'transparent'; link.style.color = active ? 'var(--brand-deep)' : 'var(--muted)'; });
  };
  addEventListener('scroll', () => {
    if (!readingFrame) readingFrame = requestAnimationFrame(updateReadingState);
  }, { passive: true });
  updateReadingState();
  document.getElementById('share-article')?.addEventListener('click', async (event) => {
    const button = event.currentTarget;
    const data = { title: button.dataset.shareTitle, url: button.dataset.shareUrl };
    try {
      if (navigator.share) await navigator.share(data);
      else { await navigator.clipboard.writeText(data.url || location.href); const label = document.getElementById('share-label'); if (label) { label.textContent = '链接已复制'; setTimeout(() => label.textContent = '分享文章', 1600); } }
    } catch (error) { if (error?.name !== 'AbortError') console.warn('分享失败', error); }
  });
</script>
