---
import { getPageURL, getImageURL, generateJSONLD } from '../lib/seo';
import '../styles/global.css';
import '../styles/motion.css';
import PagefindSearch from '../components/PagefindSearch.astro';
import MotionRoot from '../components/motion/MotionRoot.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  updatedTime?: Date;
  author?: string;
  tags?: string[];
  motion?: 'expressive' | 'standard' | 'reading' | 'none';
}

const {
  title = 'YMLL Blog｜工程、研究与长期思考',
  description = '记录前端工程、计算生物学与持续学习，分享经过实践验证的方法与思考。',
  image,
  type = 'website',
  publishedTime,
  updatedTime,
  author,
  tags,
  motion = 'standard',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? getImageURL(image) : getPageURL('/og.png');
const siteURL = getPageURL('');
const jsonLD = generateJSONLD({ title, description, image, canonicalURL, type, publishedTime, updatedTime, author, tags });
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f4f3ee" />
    <meta name="view-transition" content="same-origin" />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="YMLL Blog" />
    <meta property="og:locale" content="zh_CN" />
    {type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {type === 'article' && updatedTime && <meta property="article:modified_time" content={updatedTime.toISOString()} />}
    {type === 'article' && tags?.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title="YMLL Blog RSS" href={`${siteURL}rss.xml`} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Serif+SC:wght@600;700;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" integrity="sha384-n8MVd4RsNIU0tAv4ct0nTaAbDJwPJzDEaqSD1odI+WdtXRGWt2kTvGFasHpSy3SV" crossorigin="anonymous" />
    <script is:inline>
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'dark' || (!saved && matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        }
      } catch {}
    </script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLD)} />
    <title>{title}</title>
  </head>
  <body class="antialiased" data-motion={motion}>
    <a href="#main-content" class="fixed left-4 top-4 z-[100] -translate-y-24 rounded-full bg-black px-4 py-2 text-sm text-white transition focus:translate-y-0">跳到主要内容</a>
    {motion !== 'none' && <MotionRoot level={motion} />}
    <slot />
    <PagefindSearch />
    <script is:inline>
      window.createSubscribePrompt = function createSubscribePrompt() {
        return document.querySelector('link[type="application/rss+xml"]')?.href || '/rss.xml';
      };
    </script>
  </body>
</html>
