---
import { getPageURL, getImageURL, generateJSONLD } from '../lib/seo';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  updatedTime?: Date;
  author?: string;
  tags?: string[];
}

const {
  title = 'YMLL Blog',
  description = '探索技术与设计的交汇点，记录成长与思考',
  image,
  type = 'website',
  publishedTime,
  updatedTime,
  author,
  tags,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? getImageURL(image) : getPageURL('/favicon.svg');
const siteURL = getPageURL('');

// 生成 JSON-LD
const jsonLD = generateJSONLD({
  title,
  description,
  image,
  canonicalURL,
  type,
  publishedTime,
  updatedTime,
  author,
  tags,
});
---

<!doctype html>
<html lang="zh-CN" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    {/* Open Graph */}
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="YMLL Blog" />
    <meta property="og:locale" content="zh_CN" />

    {type === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}
    {type === 'article' && updatedTime && (
      <meta property="article:modified_time" content={updatedTime.toISOString()} />
    )}
    {type === 'article' && author && (
      <meta property="article:author" content={author} />
    )}
    {type === 'article' && tags && tags.map(tag => (
      <meta property="article:tag" content={tag} />
    ))}

    {/* Twitter */}
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />

    {/* Canonical URL */}
    <link rel="canonical" href={canonicalURL} />

    {/* RSS Feed */}
    <link rel="alternate" type="application/rss+xml" title="YMLL Blog RSS" href={`${siteURL}rss.xml`} />

    {/* Favicon */}
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />

    {/* Title */}
    <title>{title}</title>

    {/* Preload fonts */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet" />

    {/* KaTeX Math Rendering */}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" integrity="sha384-n8MVd4RsNIU0tAv4ct0nTaAbDJwPJzDEaqSD1odI+WdtXRGWt2kTvGFasHpSy3SV" crossorigin="anonymous" />

    {/* AOS - Animate On Scroll */}
    <link rel="stylesheet" href="https://unpkg.com/aos@2.3.1/dist/aos.css" />

    {/* JSON-LD */}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLD)} />
  </head>
  <body class="bg-stone-50 text-stone-900 font-sans antialiased selection:bg-emerald-500 selection:text-white">
    {/* Background gradient */}
    <div class="fixed inset-0 -z-10">
      <div class="absolute inset-0 bg-gradient-to-br from-emerald-50/50 via-white to-amber-50/30"></div>
      <div class="absolute top-0 right-0 w-[800px] h-[800px] bg-gradient-to-b from-emerald-100/20 to-transparent rounded-full blur-3xl"></div>
      <div class="absolute bottom-0 left-0 w-[600px] h-[600px] bg-gradient-to-t from-amber-100/20 to-transparent rounded-full blur-3xl"></div>
    </div>

    <slot />

    {/* AOS Script */}
    <script is:inline src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script is:inline>
      document.addEventListener('DOMContentLoaded', function() {
        AOS.init({
          easing: 'ease-in-out-sine',
          duration: 700,
          delay: 100,
          once: true
        });
      });
    </script>

    {/* 动态标签栏 - Matery 风格 */}
    <script is:inline>
      (function() {
        var OriginTitle = document.title;
        var titleTimer;

        document.addEventListener('visibilitychange', function() {
          if (document.hidden) {
            document.title = 'Σ(っ °Д °;)っ 喔哟，崩溃啦！';
            clearTimeout(titleTimer);
          } else {
            document.title = 'φ(゜▽゜*)♪ 咦，又好了！';
            titleTimer = setTimeout(function() {
              document.title = OriginTitle;
            }, 3000);
          }
        });
      })();
    </script>

    {/* 代码块复制按钮 - Matery 风格 */}
    <script is:inline>
      document.addEventListener('DOMContentLoaded', function() {
        // 为所有代码块添加复制按钮
        document.querySelectorAll('pre').forEach(function(pre) {
          // 创建复制按钮
          var copyBtn = document.createElement('button');
          copyBtn.className = 'code-copy-btn';
          copyBtn.innerHTML = '<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" /></svg>';
          copyBtn.title = '复制代码';
          copyBtn.style.cssText = 'position:absolute;top:8px;right:40px;padding:4px 8px;background:rgba(255,255,255,0.1);border:none;border-radius:6px;cursor:pointer;color:#6c7086;transition:all 0.2s;z-index:10;';

          copyBtn.addEventListener('mouseenter', function() {
            this.style.background = 'rgba(255,255,255,0.2)';
            this.style.color = '#cdd6f4';
          });

          copyBtn.addEventListener('mouseleave', function() {
            this.style.background = 'rgba(255,255,255,0.1)';
            this.style.color = '#6c7086';
          });

          copyBtn.addEventListener('click', function() {
            var code = pre.querySelector('code');
            if (code) {
              var text = code.textContent;
              navigator.clipboard.writeText(text).then(function() {
                copyBtn.innerHTML = '<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>';
                copyBtn.style.color = '#a6e3a1';
                setTimeout(function() {
                  copyBtn.innerHTML = '<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" /></svg>';
                  copyBtn.style.color = '#6c7086';
                }, 2000);
              });
            }
          });

          pre.style.position = 'relative';
          pre.appendChild(copyBtn);
        });

        // 为代码块添加行号
        document.querySelectorAll('pre code').forEach(function(codeBlock) {
          var lines = codeBlock.textContent.split('\n');
          var lineNumbers = document.createElement('div');
          lineNumbers.className = 'line-numbers';
          lineNumbers.style.cssText = 'position:absolute;left:0;top:0;padding:1.5rem 0;width:2.5rem;text-align:right;color:#4b5263;font-size:0.75rem;line-height:1.7;user-select:none;border-right:1px solid #313244;';

          for (var i = 1; i <= lines.length; i++) {
            var lineNum = document.createElement('div');
            lineNum.textContent = i;
            lineNumbers.appendChild(lineNum);
          }

          codeBlock.parentElement.style.position = 'relative';
          codeBlock.parentElement.insertBefore(lineNumbers, codeBlock);
          codeBlock.style.paddingLeft = '3.5rem';
        });

        // 图片点击放大功能 - Matery 风格
        var overlay = document.createElement('div');
        overlay.id = 'image-overlay';
        overlay.style.cssText = 'display:none;position:fixed;inset:0;background:rgba(0,0,0,0.9);z-index:9999;cursor:zoom-out;justify-content:center;align-items:center;';
        overlay.innerHTML = '<img id="overlay-img" style="max-width:90%;max-height:90%;object-fit:contain;border-radius:8px;" />';
        document.body.appendChild(overlay);

        var overlayImg = document.getElementById('overlay-img');

        document.querySelectorAll('.prose img, article img').forEach(function(img) {
          img.style.cursor = 'zoom-in';
          img.addEventListener('click', function() {
            overlayImg.src = this.src;
            overlay.style.display = 'flex';
            document.body.style.overflow = 'hidden';
          });
        });

        overlay.addEventListener('click', function() {
          overlay.style.display = 'none';
          document.body.style.overflow = '';
        });

        document.addEventListener('keydown', function(e) {
          if (e.key === 'Escape' && overlay.style.display === 'flex') {
            overlay.style.display = 'none';
            document.body.style.overflow = '';
          }
        });
      });
    </script>

    {/* Smooth scroll script */}
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('animate-fade-in-up');
            }
          });
        }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });

        document.querySelectorAll('.animate-on-scroll').forEach((el) => {
          observer.observe(el);
        });
      });
    </script>
  </body>
</html>

<style is:global>
  @tailwind base;
  @tailwind components;
  @tailwind utilities;

  @layer base {
    html {
      scroll-behavior: smooth;
    }

    body {
      min-height: 100vh;
      overflow-x: hidden;
    }

    ::selection {
      background-color: #10b981;
      color: white;
    }
  }

  @layer components {
    .glass {
      @apply bg-white/80 backdrop-blur-xl border border-white/20 shadow-lg shadow-black/5;
    }

    .glass-dark {
      @apply bg-stone-900/80 backdrop-blur-xl border border-white/10 shadow-lg shadow-black/20;
    }

    .gradient-text {
      @apply bg-gradient-to-r from-emerald-600 to-teal-600 bg-clip-text text-transparent;
    }

    .hover-lift {
      @apply transition-all duration-300 hover:-translate-y-1 hover:shadow-xl;
    }

    /* macOS 风格代码块 */
    pre {
      position: relative;
      background: #1e1e2e;
      border-radius: 12px;
      padding: 1.5rem;
      padding-top: 2.5rem;
      margin: 1.5rem 0;
      overflow-x: auto;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1);
    }

    pre::before {
      content: '';
      position: absolute;
      top: 12px;
      left: 16px;
      width: 12px;
      height: 12px;
      border-radius: 50%;
      background: #ff5f57;
      box-shadow:
        20px 0 0 #ffbd2e,
        40px 0 0 #28c840;
    }

    pre::after {
      content: attr(data-lang);
      position: absolute;
      top: 12px;
      right: 16px;
      font-size: 12px;
      color: #6c7086;
      text-transform: uppercase;
    }

    pre code {
      background: none;
      padding: 0;
      border-radius: 0;
      color: #cdd6f4;
      font-family: 'SF Mono', 'Fira Code', 'Cascadia Code', Consolas, monospace;
      font-size: 0.875rem;
      line-height: 1.7;
    }

    /* 行内代码 */
    code:not(pre code) {
      background: #f0fdf4;
      color: #166534;
      padding: 0.125rem 0.375rem;
      border-radius: 6px;
      font-size: 0.875em;
      font-family: 'SF Mono', 'Fira Code', Consolas, monospace;
      border: 1px solid #bbf7d0;
    }

    /* 代码高亮色 */
    pre code .keyword { color: #cba6f7; }
    pre code .string { color: #a6e3a1; }
    pre code .comment { color: #6c7086; font-style: italic; }
    pre code .function { color: #89b4fa; }
    pre code .number { color: #fab387; }
    pre code .operator { color: #89dceb; }
    pre code .class { color: #f9e2af; }

    .animate-on-scroll {
      opacity: 0;
      transform: translateY(20px);
    }

    .animate-fade-in-up {
      animation: fadeInUp 0.6s ease-out forwards;
    }
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Custom scrollbar */
  ::-webkit-scrollbar {
    width: 8px;
    height: 8px;
  }

  ::-webkit-scrollbar-track {
    background: transparent;
  }

  ::-webkit-scrollbar-thumb {
    background: #d6d3d1;
    border-radius: 9999px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: #a8a29e;
  }

  /* Smooth transitions for theme */
  * {
    transition-property: background-color, border-color, color, fill, stroke;
    transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
    transition-duration: 150ms;
  }
</style>
